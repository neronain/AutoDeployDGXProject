# ─────────────────────────── bench ───────────────────────────
# วัดจากฝั่ง client ผ่าน API จริง (stream) — ตัวเลขที่คนใช้จะเจอ ไม่ใช่ตัวเลขภายใน engine ·
# ttft = รอ token แรก (prefill + คิว) · decode = ความเร็วหลังจากนั้น · ใช้ usage จาก
# stream_options ถ้า engine ให้มา ไม่ให้ก็นับ chunk แทน · python3 stdlib ล้วน
bench() {
  assert_our_server
  need curl
  python3 - "$API_PORT" "$SERVED_MODEL_NAME" "${API_KEY:-}" "${1:-3}" "${2:-256}" <<'PYEOF'
import json, statistics, sys, time, urllib.error, urllib.request

port, model, key = int(sys.argv[1]), sys.argv[2], sys.argv[3]
runs, max_tokens = int(sys.argv[4]), int(sys.argv[5])
headers = {"Content-Type": "application/json"}
if key:
    headers["Authorization"] = "Bearer " + key
prompt = ("Write a detailed, multi-paragraph explanation of how a transformer language model "
          "generates text one token at a time.")


def one_run():
    payload = json.dumps({
        "model": model, "max_tokens": max_tokens, "temperature": 0,
        "messages": [{"role": "user", "content": prompt}],
        "stream": True, "stream_options": {"include_usage": True},
    }).encode()
    req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions", data=payload, headers=headers)
    started = time.monotonic()
    first = None
    chunks = 0
    completion = None
    with urllib.request.urlopen(req, timeout=600) as resp:
        for raw in resp:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            body = line[5:].strip()
            if body == "[DONE]":
                break
            try:
                event = json.loads(body)
            except ValueError:
                continue
            usage = event.get("usage") or {}
            if usage.get("completion_tokens") is not None:
                completion = usage["completion_tokens"]
            for choice in event.get("choices") or []:
                delta = choice.get("delta") or {}
                if delta.get("content") or delta.get("reasoning_content") or delta.get("reasoning"):
                    chunks += 1
                    if first is None:
                        first = time.monotonic() - started
    total = time.monotonic() - started
    return first, total, (completion if completion is not None else chunks)


rows = []
for i in range(1, runs + 1):
    try:
        ttft, total, tokens = one_run()
    except urllib.error.HTTPError as exc:
        print(f"bench: FAIL — HTTP {exc.code}: {exc.read()[:300].decode('utf-8', 'replace')}")
        sys.exit(1)
    except Exception as exc:  # noqa: BLE001
        print(f"bench: FAIL — {exc}")
        sys.exit(1)
    if not tokens:
        print(f"bench: FAIL — รอบ {i} ไม่ได้ token กลับมาเลย · ดู log: logs 200")
        sys.exit(1)
    ttft = total if ttft is None else ttft
    overall = tokens / total if total > 0 else 0.0
    decode = (tokens - 1) / (total - ttft) if tokens > 1 and total > ttft else overall
    rows.append((ttft, overall, decode))
    print(f"  run {i}: ttft {ttft:.2f}s · {tokens} tokens in {total:.2f}s → {overall:.1f} tok/s (decode {decode:.1f} tok/s)")

print()
print(f"bench: median ttft {statistics.median(r[0] for r in rows):.2f}s · "
      f"{statistics.median(r[1] for r in rows):.1f} tok/s overall · "
      f"decode {statistics.median(r[2] for r in rows):.1f} tok/s  ({runs} runs × {max_tokens} tokens)")
PYEOF
}

# ─────────────────────────── stress ───────────────────────────
# ยิงพร้อมกันหลายสาย — max-num-seqs ที่ตั้งไว้รับได้จริงไหม เห็นจาก p95 กับจำนวนที่ล้ม
# (เซิร์ฟเวอร์ที่รับทีละคน: สายที่เหลือรอจน timeout — ดูเหมือน "ช้า" ทั้งที่จริงคือคิว)
stress() {
  assert_our_server
  need curl
  python3 - "$API_PORT" "$SERVED_MODEL_NAME" "${API_KEY:-}" "${1:-16}" "${2:-4}" <<'PYEOF'
import json, statistics, sys, threading, time, urllib.error, urllib.request

port, model, key = int(sys.argv[1]), sys.argv[2], sys.argv[3]
total, workers = int(sys.argv[4]), max(1, int(sys.argv[5]))
headers = {"Content-Type": "application/json"}
if key:
    headers["Authorization"] = "Bearer " + key
payload = json.dumps({
    "model": model, "max_tokens": 128, "temperature": 0,
    "messages": [{"role": "user", "content": "List ten animals and one fact about each."}],
}).encode()

lock = threading.Lock()
results = []          # (latency, completion_tokens) ของสายที่สำเร็จ
errors = []
queue = list(range(total))


def worker():
    while True:
        with lock:
            if not queue:
                return
            queue.pop()
        req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions", data=payload, headers=headers)
        started = time.monotonic()
        try:
            with urllib.request.urlopen(req, timeout=600) as resp:
                body = json.load(resp)
            tokens = (body.get("usage") or {}).get("completion_tokens") or 0
            with lock:
                results.append((time.monotonic() - started, tokens))
        except urllib.error.HTTPError as exc:
            with lock:
                errors.append(f"HTTP {exc.code}: {exc.read()[:120].decode('utf-8', 'replace')}")
        except Exception as exc:  # noqa: BLE001
            with lock:
                errors.append(str(exc)[:160])


started = time.monotonic()
threads = [threading.Thread(target=worker, daemon=True) for _ in range(workers)]
for t in threads:
    t.start()
for t in threads:
    t.join()
wall = time.monotonic() - started or 1e-9

print(f"stress: {total} requests · {workers} concurrent · {wall:.1f}s wall")
if results:
    lat = sorted(r[0] for r in results)
    p95 = lat[min(len(lat) - 1, int(round(0.95 * (len(lat) - 1))))]
    tokens = sum(r[1] for r in results)
    print(f"  ok {len(results)}/{total} · latency p50 {statistics.median(lat):.2f}s · p95 {p95:.2f}s · max {lat[-1]:.2f}s")
    print(f"  {tokens} completion tokens → {tokens / wall:.1f} tok/s aggregate · {len(results) / wall:.2f} req/s")
if errors:
    print(f"  FAIL {len(errors)}/{total}:")
    for line in sorted(set(errors))[:5]:
        print("    " + line)
    sys.exit(1)
print("stress: PASS — ทุกสายได้คำตอบ")
PYEOF
}

# ─────────────────────────── remove (ฝั่ง worker) ───────────────────────────
# ลบ stacked แล้วของบน worker ทุกตัวยังอยู่: weight ที่ sync-worker คัดลอกไป (75–173 GB) · container
# lmds-<slug>-worker · /tmp/lmds-<slug> · FlashInfer cache ของ image ที่ล็อก — ผู้ใช้ 2026-09-05:
# "ลบโมเดล stacked แล้วลบที่ worker ด้วยไหม" · `lmds remove <slug>` บน head ทำส่วนนี้ให้เอง (fleet/manager)
# คำสั่งนี้มีไว้ให้ controller ตัวเดียวก็เก็บกวาดได้ · ไม่มี -y = พิมพ์แผน+ขนาด (du -sb ผ่าน ssh) ไม่ลบ
_worker_removal_paths() {
  local keep="${1:-}" slug key=""
  slug="$(_model_slug)"
  if [[ -z "$keep" ]]; then
    printf '%s\n' "${WORKER_HF_HOME}/hub/models--${slug}" "${WORKER_HF_HOME}/models--${slug}" \
      "${WORKER_HF_HOME}/hub/.locks/models--${slug}"
  fi
  printf '%s\n' "/tmp/lmds-${SLUG}"
  # cache JIT อยู่ใต้ <cache>/<16 ตัวแรกของ image id ที่ล็อก> — image เดียวกันใช้ร่วมกับ bundle อื่นได้
  # ลบเฉพาะเมื่อไม่มี bundle อื่นบน head ล็อก image เดียวกัน
  if [[ -f "$IMAGE_LOCK_FILE" ]]; then
    key="$(cat "$IMAGE_LOCK_FILE")"
    local other shared=0
    for other in "${HF_HOME}"/.lmds-image-id-*; do
      [[ -f "$other" && "$other" != "$IMAGE_LOCK_FILE" && "$(cat "$other")" == "$key" ]] && shared=1
    done
    key="${key#sha256:}"; key="${key:0:16}"
    (( shared )) || printf '%s\n' "${WORKER_FLASHINFER_CACHE}/${key}"
  fi
  return 0
}

remove_workers() {
  local yes="" keep="" arg wip path
  for arg in "$@"; do
    case "$arg" in -y|--yes) yes=1 ;; --keep-weights) keep=1 ;; esac
  done
  local -a paths=()
  while IFS= read -r path; do [[ -n "$path" ]] && paths+=("$path"); done < <(_worker_removal_paths "$keep")
  local quoted; quoted="$(printf '%q ' "${paths[@]}")"
  [[ -n "$yes" ]] || echo "== แผนลบบน worker (${WORKER_IPS}) — ยังไม่ลบ · ลบจริง: $0 remove -y${keep:+ --keep-weights} · ฝั่ง head: lmds remove ${SLUG} =="
  for wip in $WORKER_IPS; do
    echo "== worker ${wip} =="
    if ! ssh_at "$wip" true >/dev/null 2>&1; then
      echo "  ยังเหลือบน ${wip}: ${paths[*]} — ติดต่อไม่ได้ · ลบเอง: ssh ${SSH_USER}@${wip} 'docker rm -f ${WORKER_CONTAINER}; sudo rm -rf ${paths[*]}'"
      continue
    fi
    if [[ -z "$yes" ]]; then
      ssh_at "$wip" "docker inspect '${WORKER_CONTAINER}' >/dev/null 2>&1 && echo '  container ${WORKER_CONTAINER}'
for p in ${quoted}; do [ -e \"\$p\" ] && printf '  %s\t%s\n' \"\$(du -sb \"\$p\" 2>/dev/null | cut -f1)\" \"\$p\"; done; true" || echo "  (อ่านขนาดไม่ได้)"
    else
      # rm ธรรมดาก่อน · ไฟล์ของ root (container เขียนไว้) → root ในคอนเทนเนอร์ลบให้ · จบด้วย test -e เสมอ
      ssh_at "$wip" "docker rm -f '${WORKER_CONTAINER}' >/dev/null 2>&1 && echo '  ลบ container ${WORKER_CONTAINER}' || true
for p in ${quoted}; do
  [ -e \"\$p\" ] || continue
  rm -rf -- \"\$p\" 2>/dev/null
  if [ -e \"\$p\" ]; then img=\"\$(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -v '<none>' | head -1)\"; [ -n \"\$img\" ] && docker run --rm -v \"\$(dirname \"\$p\"):/x\" \"\$img\" rm -rf -- \"/x/\$(basename \"\$p\")\" >/dev/null 2>&1 && echo \"  ลบผ่าน docker (ไฟล์เป็นของ root): \$p\"; fi
  if [ -e \"\$p\" ]; then echo \"  ยังเหลือบน ${wip}: \$p — ลบเอง: ssh ${SSH_USER}@${wip} sudo rm -rf \$p\"; else echo \"  ลบ \$p\"; fi
done" || echo "  ยังเหลือบน ${wip}: ${paths[*]} — ssh ล้มกลางทาง · ลบเอง: ssh ${SSH_USER}@${wip} 'docker rm -f ${WORKER_CONTAINER}; sudo rm -rf ${paths[*]}'"
    fi
  done
}

usage() {
  cat <<EOF
${SLUG} — vLLM stacked (multi-node) controller  (model: ${MODEL_ID})

USAGE
  $0 <command> [options]

Run every command from the MASTER node as a normal user (never sudo).
Before the first command that touches the worker(s) the cluster must be known:
  from the hub:   lmds node cluster --write ${SLUG} --head <head machine>   (writes cluster.env)
  or by hand:     cluster.env next to this script, or MASTER_IP / WORKER_IP / SSH_USER env
NCCL_SOCKET_IFNAME / NCCL_IB_HCA are auto-detected from the transport IPs (override via env).
Passwordless SSH from the MASTER node to every worker is required (the head's own key,
not the hub's): ssh-keygen -t ed25519 -N '' && ssh-copy-id <user>@<worker>.

COMMANDS (Thai descriptions kept — same wording as the run output):
  prepare-runtime  pull + lock image ให้ตรงกันทั้งสอง node
  runtime-info     แสดง image / lock id
  download         ดาวน์โหลดโมเดลลง head (resume ได้, pin revision)
  verify-files     ตรวจ config + จำนวน shard + symlink บน head
  sync-worker      rsync model cache → worker
  verify-worker    ตรวจ shard บน worker
  doctor           ตรวจ image/GPU/vLLM ให้ตรงกัน
  start            worker-first → head → รอ /health
  stop | restart   หยุด / restart ทั้งสอง node
  status           สถานะ container ทั้งสอง node + API
  logs [head|worker] [N]   log (หรือ logs N = head N บรรทัด)
  client-config    ค่าตั้ง client (JSON) พร้อม token budget
  network-info     IP/fabric/endpoint
  serve-args       argv จริงของ vllm บน head/worker + engine env (ไม่แตะ docker/ssh)
  info             สรุปโมเดล/พอร์ต/สถานะ
  props            รายการโมเดลจาก /v1/models
  clear-fi-cache   หยุดแล้วล้าง FlashInfer JIT cache ทั้งสอง node
                   ใช้เมื่อ start พังหลังเปลี่ยน image (cache เก่าคนละ signature)
  remove [-y] [--keep-weights]  ของที่เหลือบน worker ทุกตัว (weight ที่ sync ไป · container · cache)
                   ไม่มี -y = แสดงแผนพร้อมขนาด · -y = ลบจริง · ฝั่ง head ใช้ lmds remove ${SLUG}
  test-text        ทดสอบ chat completion
{% endraw %}{% if plan.multimodal.modalities %}  test-vision      ส่งภาพ PNG สีแดงล้วนที่สร้างเอง แล้วเช็คว่าโมเดลเห็นจริง
{% endif %}{% raw %}  test-reasoning   ตรวจว่า --reasoning-parser แยก chain-of-thought ได้จริง (37×43=1591)
  test-tools [both|auto|required]  ตรวจว่า --tool-parser แปลงเป็น tool_calls ได้จริง
                   ค่าตั้งต้น both = ทดสอบ auto ก่อน ซึ่งเป็นโหมดที่ agent ใช้จริง
  parsers          สิ่งที่ engine รู้จัก: ชื่อ --tool-parser และ --reasoning-parser ที่ใส่ได้จริง
  bench [RUNS] [TOKENS]       วัด ttft / tok/s ผ่าน API จริง (ค่าตั้งต้น 3 รอบ × 256 tokens)
  stress [REQUESTS] [CONC]    ยิงพร้อมกันหลายสาย ดู p50/p95 และจำนวนที่ล้ม (ค่าตั้งต้น 16 × 4)
  (ชุด test-*/bench/stress คุยกับ head ที่ 127.0.0.1:${API_PORT} เท่านั้น — ไม่ต้องมี cluster.env)

OPTIONS  (can be placed after any command; equals form also works: --port=8001)
  --port N              Port the head node serves on             [default: ${API_PORT}]
  --context N           Max context length in tokens             [default: ${MAX_MODEL_LEN}]
  --extra-args "..."    Extra engine flags appended verbatim (space-separated; write JSON without spaces) [default: ${EXTRA_SERVE_ARGS}]
  --bind ADDR           Address the head node listens on         [default: ${API_HOST}]
                        0.0.0.0 = whole network · 127.0.0.1 = this machine only
  --advertise-ip ADDR   IP printed for clients (does NOT change the bind address)
  --interface NAME      Pick the advertised IP from this interface instead of auto-detect
  --client-input N|auto Input token budget written into client-config
  --client-output N     Output token budget written into client-config
  --dry-run             (start) print worker.sh + docker run of every rank, touch nothing

API TOKEN (authentication)
  There is NO token by default: anyone who can reach ${API_HOST}:${API_PORT} can use the model.
  Set one with the API_KEY environment variable — it is passed to vLLM as VLLM_API_KEY on the head node:

    API_KEY=my-secret-token $0 restart          # restart both nodes with authentication on
    API_KEY=\$(openssl rand -hex 24) $0 restart  # or generate a random one

  Clients then send it as a bearer token:

    curl http://<master-ip>:${API_PORT}/v1/chat/completions \
      -H "Authorization: Bearer my-secret-token" \
      -H 'Content-Type: application/json' \
      -d '{"model":"${SERVED_MODEL_NAME}","messages":[{"role":"user","content":"hi"}]}'

  The token is NOT stored in this script — pass API_KEY on every start/restart.
  Only the head node serves the API; the worker never exposes one.
  Without a token, prefer:  $0 restart --bind 127.0.0.1

ENVIRONMENT VARIABLES
  API_KEY               Bearer token required from clients        [default: none]
  API_PORT / API_HOST   Same as --port / --bind
  MAX_MODEL_LEN         Same as --context
  HF_TOKEN              Hugging Face token, needed for gated repos during 'download'
  HF_HOME               Where model weights live on the head      [default: \${HOME}/.cache/huggingface]
  WORKER_HF_HOME        Same on the worker(s)                     [default: same as HF_HOME]
  HTTPS_PROXY / HF_ENDPOINT  Forwarded into the download container when set (proxy / mirror)
  TRANSPORT_IP_WORKER   IP the first worker uses for NCCL (fabric) [default: WORKER_IP]
  TRANSPORT_IPS_WORKER  Same for every worker, rank order, space-separated (3+ nodes)
  cluster.env v2 (multi-link: 3-node ring / switch) — written by the hub, per rank:
    LINKS_<r> NCCL_SOCKET_IFNAMES_<r> NCCL_IB_HCAS_<r> HEAD_TO_WORKER_IP_<r> WORKER_HEAD_IP_<r>
    CLUSTER_TOPOLOGY=direct-2|ring-3|switch-N · NCCL_CROSS_NIC=1 (ring) · absent = single-link behaviour
  SHARD_COUNT           Expected shard count (0 = do not enforce) [default: ${SHARD_COUNT}]
  STARTUP_TIMEOUT       Seconds to wait for /health on start      [default: ${STARTUP_TIMEOUT}]

EXAMPLES
  $0 prepare-runtime && $0 download && $0 verify-files    # first run, on master
  $0 sync-worker && $0 verify-worker                      # copy weights to the worker and check
  $0 start                                                # worker first, then head
  API_KEY=secret123 $0 restart                            # require a bearer token
  $0 logs worker 200                                      # worker-side logs
  $0 doctor                                               # image / GPU / vLLM consistency across nodes
EOF
}

parse_options "$@"
set -- ${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}


banner() {
  cat <<'ART'

  _     __  __ ____  ____
 | |   |  \/  |  _ \/ ___|
 | |   | |\/| | | | \___ \
 | |___| |  | | |_| |___) |
 |_____|_|  |_|____/|____/
ART
  printf '       =[ LMDS controller · v%s ]\n' "${SCRIPT_VERSION}"
  printf '+ -- --=[ %s ]\n' "${MODEL_LABEL}"
  printf '+ -- --=[ %s · %s ]\n' "${RUNTIME_LABEL}" "${MODEL_FEATURES}"
  printf '+ -- --=[ Designed by neronain · fb.com/neronain.minidev ]\n\n'
}

# สรุปว่า controller นี้เสิร์ฟโมเดลอะไร ที่พอร์ตไหน และตอนนี้ขึ้นหรือยัง
info() {
  banner
  local ip url state
  ip="$(detect_advertise_ip 2>/dev/null || true)"; [[ -n "$ip" ]] || ip="${API_HOST}"
  url="http://${ip}:${API_PORT}/v1"
  state="stopped"
  if curl -fsS -m 2 "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
    state="RUNNING"
  fi
  printf '  Model     : %s\n'            "${MODEL_LABEL}"
  printf '  Model ID  : %s\n'            "${MODEL_ID}"
  printf '  Runtime   : %s\n'            "${RUNTIME_LABEL}"
  printf '  Features  : %s\n'            "${MODEL_FEATURES}"
  printf '  Context   : %s tokens\n'     "${MAX_MODEL_LEN:-${CTX_SIZE:-n/a}}"
  printf '  API (v1)  : %s\n'            "${url}"
  printf '  State     : %s  (port %s)\n\n' "${state}" "${API_PORT}"
}

# ทุกคำสั่งที่จะ ssh ไป worker: มี tty ถามยืนยัน IP (เหมือน start เดิม) · ไม่มี tty และยังเป็นค่า
# ตัวอย่าง = หยุดพร้อมบอกทาง — stop/status/logs ปล่อยผ่าน (hub เรียกบ่อย และล้มไม่เสียหาย)
case "${1:-}" in
  prepare-runtime|sync-worker|verify-worker|start|restart|clear-fi-cache|doctor|remove)
    # --dry-run ไม่แตะเครื่องไหน — ประกอบคำสั่งจากค่าตัวอย่างก็มีประโยชน์ (ตรวจ argv/env ก่อนมีคลัสเตอร์จริง)
    [[ -n "$DRY_RUN" && "$1" == start ]] || _require_cluster_config "$1" ;;
esac

case "${1:-help}" in
  prepare-runtime) prepare_runtime ;;
  serve-args)      serve_args ;;
  runtime-info)    runtime_info ;;
  download)        download ;;
  verify-files)    verify_files ;;
  sync-worker)     sync_worker ;;
  verify-worker)   verify_worker ;;
  doctor)          doctor ;;
  start)           start ;;
  stop)            stop ;;
  restart)         stop; start ;;
  status)          status ;;
  logs)            logs "${2:-head}" "${3:-200}" ;;
  client-config)   client_config ;;
  clear-fi-cache)  clear_fi_cache ;;
  remove)          remove_workers "${@:2}" ;;
  props)           props ;;
  info|banner) info ;;
  network-info)    network_info ;;
  test-text)       test_text ;;
{% endraw %}{% if plan.multimodal.modalities %}  test-vision)     test_vision ;;
{% endif %}{% raw %}  test-reasoning)  test_reasoning ;;
  test-tools)      test_tools "${2:-both}" ;;
  parsers)         list_parsers ;;
  bench)           bench "${2:-3}" "${3:-256}" ;;
  stress)          stress "${2:-16}" "${3:-4}" ;;
  *)               usage ;;
esac
{% endraw %}
