#!/usr/bin/env bash
# {{ slug }} — vLLM stacked (multi-node) controller
# Model:    {{ plan.model_id }} @ {{ plan.revision }}
# Target:   {{ fit.target_name }} | Generated by LMDS {{ lmds_version }} ({{ plan.generator }})
# Topology: stacked — {{ node_count }} nodes, tensor-parallel {{ tensor_parallel }}, mp backend (worker-first startup)
# Standard: dgx-spark-controllers v3.0.0 controller contract + validated stacked reference (v8.2)
#
# หลักการ (จาก skills_Strack.md):
#   - worker-first: เปิด rank 1 (headless) ก่อน แล้วค่อยเปิด rank 0 (API)
#   - lock runtime image ด้วย image-ID ให้ตรงกันทั้งสอง node ก่อน start
#   - แยก lifecycle: prepare-runtime → download → verify-files → sync-worker → verify-worker → start
#   - ต้องมี fabric ระหว่าง node (200G RoCE/Ethernet) + passwordless SSH master→worker
set -Eeuo pipefail
# ── ค่าที่บันทึกไว้กับ bundle นี้ (เขียนโดยหน้าเว็บ / `lmds set`) ──
# ต้องอยู่ **เหนือ** default ทุกตัว เพราะทุกบรรทัดในไฟล์เป็นรูป ${VAR:-value} ซึ่งไม่ทำอะไรเลย
# ถ้าตัวแปรถูกตั้งไปแล้ว · เคสจริง spark-worker 2026-09-03: `lmds set --image` ให้ bundle vLLM
# ถูกเมินเงียบ ๆ เพราะ VLLM_IMAGE/SERVED_MODEL_NAME ประกาศอยู่เหนือจุด source (บั๊กเดียวกับที่
# แก้ใน llama.cpp ไปก่อนหน้าวันเดียวกัน) · ลำดับความสำคัญ: flag > env ภายนอก > ไฟล์นี้ > bundle
BUNDLE_ENV="${BUNDLE_ENV:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bundle.env}"
if [[ -f "$BUNDLE_ENV" ]]; then
  set -a; . "$BUNDLE_ENV"; set +a
fi


# ============================ CONFIG (แก้ได้ผ่าน env) ============================
SLUG="{{ slug }}"
SCRIPT_VERSION="${SCRIPT_VERSION:-{{ controller_version }}}"
MODEL_LABEL="${MODEL_LABEL:-{{ model_label }}}"
RUNTIME_LABEL="${RUNTIME_LABEL:-{{ runtime_label }}}"
MODEL_FEATURES="${MODEL_FEATURES:-{{ model_features }}}"
MODEL_ID="{{ plan.model_id }}"
MODEL_REVISION="{{ plan.revision }}"
# ชื่อโมเดลที่ API เสิร์ฟออกไป — ตั้งเองได้ผ่าน env เหมือน knob อื่น ๆ
# ลูกค้าที่ย้ายมาจากระบบเดิมมักต้องใช้ชื่อเดิมเป๊ะ ไม่งั้น client ทุกตัวต้องแก้ตาม
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-{{ plan.served_model_name }}}"
# runtime ของ bundle นี้ — ตรึงที่ digest ไม่ใช่ tag
#
# tag เคลื่อนที่ได้: `:latest` วันนี้กับเดือนหน้าเป็นคนละ image · bundle ที่ทดสอบ
# ผ่านแล้วจึงกลายเป็นคนละ runtime ได้โดยไม่มีอะไรในไฟล์นี้เปลี่ยนเลย ซึ่งเป็นอาการ
# ที่ไล่หาสาเหตุยากที่สุด เพราะ "ไม่ได้แก้อะไรสักหน่อย"
#
# tag ที่ digest นี้มาจาก ณ วันที่ generate: {{ plan.runtime.image_ref }}
# อยากใช้ตัวอื่นก็ override ได้ตามเดิม: VLLM_IMAGE=<image> ./controller start
# repo ของ image มาจาก renderer (image_repo) เพราะ registry ที่มีพอร์ตตัดที่ ':' ตัวแรกไม่ได้ ·
# fallback เดิมเหลือไว้ให้ render บรรทัดนี้เดี่ยว ๆ ด้วย plan อย่างเดียวได้ (เทส image pin)
VLLM_IMAGE="${{ '{' }}VLLM_IMAGE:-{% if plan.runtime.image_pin %}{{ image_repo if image_repo is defined else plan.runtime.image_ref.split(':')[0] }}@{{ plan.runtime.image_pin }}{% else %}{{ plan.runtime.image_ref }}{% endif %}{{ '}' }}"
MASTER_CONTAINER="${MASTER_CONTAINER:-lmds-{{ slug }}-head}"
WORKER_CONTAINER="${WORKER_CONTAINER:-lmds-{{ slug }}-worker}"

# ── Cluster nodes (ต้องแก้ให้ตรงเครื่องจริง) ──
# hub เขียน cluster.env ให้ได้ด้วย `lmds node cluster --write {{ slug }}` — มีก็ใช้เลยไม่ต้องถาม
# env ที่ตั้งมาจากภายนอกยังชนะไฟล์นี้เสมอ (ไฟล์ถูกอ่านก่อน default ทั้งหมดด้านล่าง)
CLUSTER_ENV="${CLUSTER_ENV:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cluster.env}"
if [[ -f "$CLUSTER_ENV" ]]; then
  set -a; . "$CLUSTER_ENV"; set +a
fi

# จำไว้ว่าผู้ใช้ตั้ง IP มาเองไหม (env หรือ cluster.env) — ค่า 10.100.152.x ข้างล่างเป็นแค่ตัวอย่าง
# คำสั่งที่แตะ worker (prepare-runtime/sync-worker/verify-worker/start) ต้องรู้ว่ากำลังจะ ssh ไป
# เครื่องตัวอย่างหรือเครื่องจริง · เดิม prepare-runtime จาก hub (ไม่มี tty จึงไม่ถาม) ssh ไป
# 10.100.152.2 เงียบ ๆ แล้วตายด้วย "เช็ค SSH" หลังรอ 10 วิ ทั้งที่ปัญหาคือยังไม่มี cluster.env
MASTER_IP_EXPLICIT="${MASTER_IP:-}"
WORKER_IP_EXPLICIT="${WORKER_IP:-}"
MASTER_IP="${MASTER_IP:-10.100.152.1}"
WORKER_IP="${WORKER_IP:-10.100.152.2}"
SSH_USER="${SSH_USER:-${USER:-$(id -un)}}"
# transport IP ของ worker ทุกตัวเมื่อ fabric แยกจาก management (เรียงตาม node-rank · ช่องว่างคั่น)
# ว่าง = worker ตัวแรกใช้ TRANSPORT_IP_WORKER ตัวที่เหลือใช้ IP ใน WORKER_IPS ของมันเอง
TRANSPORT_IPS_WORKER="${TRANSPORT_IPS_WORKER:-}"
# ค่าที่ derive จาก MASTER_IP/WORKER_IP ต้องคำนวณใหม่ **หลัง** prompt ด้วย ไม่ใช่แค่ตอนโหลดไฟล์
#
# เดิม TRANSPORT_IP_* กับ WORKER_IPS ถูกตั้งตรงนี้จาก placeholder 10.100.152.x แล้ว
# prompt_cluster_config ค่อยทำ VAR:-MASTER_IP ซ้ำ ซึ่งไม่ทำอะไรเลยเพราะตัวแปรมีค่าอยู่แล้ว →
# IP ที่พิมพ์ตอบ prompt ถูกเมินเงียบ ๆ: head ผูก VLLM_HOST_IP กับ 10.100.152.1 และลูป worker
# ssh ไป 10.100.152.2 ทั้งที่ผู้ใช้เพิ่งบอกว่าเครื่องอยู่ที่อื่น
# จำค่าที่ผู้ใช้ตั้งมาเอง (env / cluster.env) แยกไว้ — ของที่ตั้งเองชนะเสมอ ของที่ derive ตามค่าล่าสุด
WORKER_IPS_EXPLICIT="${WORKER_IPS:-}"
TRANSPORT_IP_MASTER_EXPLICIT="${TRANSPORT_IP_MASTER:-}"
TRANSPORT_IP_WORKER_EXPLICIT="${TRANSPORT_IP_WORKER:-}"
_derive_cluster_defaults() {
  # คลัสเตอร์ที่มากกว่า 2 เครื่อง: ใส่ IP ของ worker ทุกตัวคั่นด้วยช่องว่าง เรียงตาม node-rank
  # (rank 1, 2, 3 …) · ค่าเริ่มต้นคือ worker เดียว = พฤติกรรมเดิมทุกประการ
  WORKER_IPS="$WORKER_IPS_EXPLICIT"
  # cluster.env v2 (หลายสาย): ไม่ได้ตั้ง WORKER_IPS เอง → เรียง HEAD_TO_WORKER_IP_1..N-1 = IP ของ worker
  # แต่ละ rank **ตามสายที่ head มองเห็น** (ring 3 เครื่อง: worker สองตัวอยู่คนละวง คนละ interface ของ head)
  if [[ -z "$WORKER_IPS" && -n "${HEAD_TO_WORKER_IP_1:-}" ]]; then
    local _r=1 _v
    while _v="HEAD_TO_WORKER_IP_${_r}"; [[ -n "${!_v:-}" ]]; do
      WORKER_IPS="${WORKER_IPS:+$WORKER_IPS }${!_v}"; _r=$(( _r + 1 ))
    done
  fi
  WORKER_IPS="${WORKER_IPS:-{% if node_count > 2 %}{% for i in range(2, node_count + 1) %}10.100.152.{{ i }}{{ " " if not loop.last }}{% endfor %}{% else %}$WORKER_IP{% endif %}}"
  # fabric/transport IP สำหรับ NCCL — ถ้าใช้ QSFP แยก interface ให้ override สองตัวนี้
  TRANSPORT_IP_MASTER="$TRANSPORT_IP_MASTER_EXPLICIT"
  TRANSPORT_IP_MASTER="${TRANSPORT_IP_MASTER:-${WORKER_HEAD_IP_1:-$MASTER_IP}}"
  TRANSPORT_IP_WORKER="$TRANSPORT_IP_WORKER_EXPLICIT"
  TRANSPORT_IP_WORKER="${TRANSPORT_IP_WORKER:-${HEAD_TO_WORKER_IP_1:-$WORKER_IP}}"
}
_derive_cluster_defaults
MASTER_PORT="${MASTER_PORT:-25000}"

# ── หลายสายต่อเครื่อง (cluster.env schema v2 — ring 3 เครื่อง / switch 2–4 เครื่อง) ──
# hub เขียน LINKS_<rank> · NCCL_SOCKET_IFNAMES_<rank> · NCCL_IB_HCAS_<rank> · HEAD_TO_WORKER_IP_<rank> ·
# WORKER_HEAD_IP_<rank> มาให้ (รูปแบบอยู่ในหัว fleet/cluster_env.py) · ไม่มีคีย์พวกนี้ = ทำงานแบบเดิมทุกประการ
# (สายเดียว IP เดียวต่อเครื่อง) — ห้ามให้ bundle 2 เครื่องที่รันอยู่เปลี่ยนพฤติกรรมเพราะโค้ดชุดนี้
CLUSTER_TOPOLOGY="${CLUSTER_TOPOLOGY:-}"
# ring: แต่ละคู่คุยกันคนละสาย — NCCL ต้องเลือก NIC ต่อคู่ได้ (hub ตั้ง 1 ให้ใน cluster.env ของ ring)
NCCL_CROSS_NIC="${NCCL_CROSS_NIC:-}"
# sysfs ของ RoCE HCA / สถานะ link — เปลี่ยนได้เพื่อทดสอบ (เครื่องจริงไม่ต้องแตะ)
IB_SYSFS_ROOT="${IB_SYSFS_ROOT:-/sys/class/infiniband}"
NET_SYSFS_ROOT="${NET_SYSFS_ROOT:-/sys/class/net}"
# --dry-run: ประกอบ worker.sh + docker run ของทุก rank แล้วพิมพ์ ไม่แตะ docker/ssh/GPU
DRY_RUN="${DRY_RUN:-}"

# ── NCCL / RoCE (ต้องตั้งชื่อ interface จริงบนเครื่อง; ว่าง = fallback TCP ช้าลง) ──
# หา interface: ip -br link | grep -Ei '200|roce|mlx' ; ibdev2netdev 2>/dev/null
NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-}"
NCCL_IB_HCA="${NCCL_IB_HCA:-}"
# ค่าที่ผู้ใช้ตั้งเองใช้ทั้งคลัสเตอร์ · ค่าที่ detect ให้เป็นของแต่ละเครื่อง (worker หาของตัวเองใน start)
NCCL_IB_HCA_EXPLICIT="$NCCL_IB_HCA"
NCCL_IB_GID_INDEX="${NCCL_IB_GID_INDEX:-3}"

# ── Paths ──
HF_HOME="${HF_HOME:-${HOME}/.cache/huggingface}"
VLLM_CACHE="${VLLM_CACHE:-${HOME}/.cache/vllm}"
FLASHINFER_CACHE="${FLASHINFER_CACHE:-${HOME}/.cache/flashinfer}"
WORKER_HF_HOME="${WORKER_HF_HOME:-$HF_HOME}"
WORKER_VLLM_CACHE="${WORKER_VLLM_CACHE:-$VLLM_CACHE}"
WORKER_FLASHINFER_CACHE="${WORKER_FLASHINFER_CACHE:-$FLASHINFER_CACHE}"
RUN_DIR="${RUN_DIR:-${HOME}/.lmds/run/{{ slug }}}"
# ล็อก image ต่อ bundle ไม่ใช่ต่อเครื่อง — เครื่องเดียวมี stacked ได้หลายตัวและใช้คนละ image
# (เช่น DeepSeek V4 ต้องใช้ build เฉพาะ ไม่ใช่ image เดียวกับ Llama)
IMAGE_LOCK_FILE="${IMAGE_LOCK_FILE:-${HF_HOME}/.lmds-image-id-{{ slug }}}"

# ── Serving ──
API_HOST="${API_HOST:-0.0.0.0}"
API_PORT="${API_PORT:-8000}"
API_KEY="${API_KEY:-}"
# env ของ engine เอง — ตั้งด้วย `lmds set <slug> --engine-env "KEY=VALUE ..."`
# stacked ส่งให้ทั้ง head และ worker เพราะทั้งคู่รัน engine จริง
ENGINE_ENV="${ENGINE_ENV:-}"
# แฟล็กเพิ่มของ engine — อ่านทั้งบรรทัดจาก bundle.args (เขียนโดย `lmds set --extra-args`)
# ไม่เก็บใน bundle.env เพราะรูป ${VAR:-value} ของ bash หยุดที่ `}` ตัวแรก JSON อย่าง
# --speculative-config {"method":"mtp"} จึงถูกตัดกลางคัน (ทดสอบแล้ว 2026-09-03)
# แตกเป็น argv ด้วยช่องว่าง — JSON ต้องเขียนติดกัน หรือใช้รูป --flag=value
# ค่าตั้งต้นของแฟล็กเพิ่ม — publish เขียนค่าที่พิสูจน์แล้วลงตรงนี้ · single quote โดยเจตนา:
# JSON เช่น --speculative-config {"method":"mtp"} มี } ซึ่งจะตัด ${VAR:-...} ขาดกลางคัน
EXTRA_SERVE_ARGS_DEFAULT=''
BUNDLE_ARGS="${BUNDLE_ARGS:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bundle.args}"
if [[ -z "${EXTRA_SERVE_ARGS:-}" && -f "$BUNDLE_ARGS" ]]; then
  EXTRA_SERVE_ARGS="$(tr '\n' ' ' < "$BUNDLE_ARGS")"
fi
EXTRA_SERVE_ARGS="${EXTRA_SERVE_ARGS:-$EXTRA_SERVE_ARGS_DEFAULT}"
ADVERTISE_IP="${ADVERTISE_IP:-}"
ADVERTISE_INTERFACE="${ADVERTISE_INTERFACE:-}"
ROUTE_PROBE_IP="${ROUTE_PROBE_IP:-1.1.1.1}"

MAX_MODEL_LEN="${MAX_MODEL_LEN:-{{ plan.serving.context }}}"
# เพดาน context ของโมเดล (0 = ไม่รู้) — validate_numbers ใช้กันค่าที่ vLLM จะปฏิเสธอยู่ดี
NATIVE_CONTEXT="{{ native_context }}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-{{ plan.serving.gpu_memory_utilization }}}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-{{ plan.serving.max_num_seqs }}}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
TENSOR_PARALLEL_SIZE="${TENSOR_PARALLEL_SIZE:-{{ tensor_parallel }}}"
NNODES="${NNODES:-{{ node_count }}}"

# feature flags — ว่าง = ปิด (planner เลือกให้แล้ว; override เองได้)
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-{{ plan.serving.kv_cache_dtype }}}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-{{ (plan.tool_calling.parser if plan.tool_calling.enabled else '') or '' }}}"
REASONING_PARSER="${REASONING_PARSER:-{{ (plan.reasoning.parser if plan.reasoning.enabled else '') or '' }}}"
# บาง template ที่มากับโมเดลไม่ได้ออกรูปแบบ tool ที่ vLLM แปลงเป็น tool_calls ได้
# (Llama 3.3 เป็นตัวอย่าง) — สูตรจะระบุตัวที่ใช้ได้มาให้ ตั้ง parser อย่างเดียวไม่พอ
CHAT_TEMPLATE="${CHAT_TEMPLATE:-{{ plan.tool_calling.chat_template_override or '' }}}"
# MoE backend (เช่น marlin) — ว่างโดยดีฟอลต์ ใส่เองเฉพาะโมเดล MoE ที่ต้องระบุ
MOE_BACKEND="${MOE_BACKEND:-}"
# flag เพิ่มจาก planner (ผ่าน allowlist แล้ว)
EXTRA_SERVE_FLAGS=({% for flag in extra_flag_pairs %}{{ flag }} {% endfor %})
# env ที่ runtime ต้องการแต่ไม่ใช่ flag ของ vLLM — บางโมเดลเลือก backend ผิดถ้าไม่ตั้ง
# (เช่น DeepSeek V4 ต้องปิด CUDA-graph memory profiler ไม่งั้นตายตอน determine_available_memory)
EXTRA_DOCKER_ENV=({% for pair in extra_env_pairs %}{{ pair }} {% endfor %})

# ── Client budget ──
CLIENT_OUTPUT="${CLIENT_OUTPUT:-{{ plan.serving.max_output_tokens }}}"
CLIENT_INPUT="${CLIENT_INPUT:-auto}"
TEMPLATE_OVERHEAD_TOKENS="2048"

# ── Model shard verification (0 = ไม่บังคับจำนวน) ──
SHARD_COUNT="${SHARD_COUNT:-{{ shard_count }}}"
{% if shard_files -%}
SHARD_FILES=(
{% for shard in shard_files %}  "{{ shard.filename }}"
{% endfor %})
SHARD_SIZES=(
{% for shard in shard_files %}  "{{ shard.size }}"
{% endfor %})
{% endif -%}
TOTAL_SIZE_APPROX_GB="${TOTAL_SIZE_APPROX_GB:-{{ total_size_gb }}}"

STARTUP_TIMEOUT="${STARTUP_TIMEOUT:-{{ health_timeout }}}"
WORKER_INIT_WAIT="${WORKER_INIT_WAIT:-12}"
# ระหว่างรอ head health ต้องแวะดู worker ด้วย (วินาที) — worker ที่ตายทำให้ head ค้างรอ NCCL เงียบ ๆ
WORKER_CHECK_INTERVAL="${WORKER_CHECK_INTERVAL:-60}"
# ================================================================================
{% raw %}
# ─────────────────────────── helpers ───────────────────────────
# ชื่อไฟล์เปล่าจากสูตร = ตัวอย่างที่ vLLM แจกมากับ image · เติม path ให้
# path เต็มที่ผู้ใช้ระบุเองต้องไม่ถูกแตะ
_resolve_chat_template() {
  local value="$1"
  [[ -z "$value" || "$value" == */* ]] && { echo "$value"; return; }
  echo "/opt/vllm/vllm-src/examples/${value}"
}

die() { echo "ERROR: $*" >&2; exit 1; }

# พอร์ตเดียวกันรับได้ทีละเซิร์ฟเวอร์ และทุก bundle ตั้งต้นที่พอร์ตเดียวกัน — ถ้าโมเดลอื่น
# ยึดพอร์ตนี้อยู่ ชุดทดสอบจะยิงไปโดนตัวนั้นแล้ว "ผ่าน" ทั้งที่ทดสอบคนละโมเดล
# (เจอจริง: test-text ของ gemma-4-31b ได้คำตอบจาก Qwen3-Coder-30B ที่รันอยู่ก่อน)
assert_our_server() {
  local seen
  seen="$(curl -fsS -m 10 "http://127.0.0.1:${API_PORT}/v1/models" \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} 2>/dev/null \
    | { command -v python3 >/dev/null 2>&1 && python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)["data"]
except Exception:
    sys.exit(0)
print((data[0].get("id") or "").strip() if data else "")
' || cat; })" || return 0
  [ -n "$seen" ] || return 0                       # อ่านไม่ได้ = ไม่ฟันธง ปล่อยผ่าน
  [ "$seen" = "$SERVED_MODEL_NAME" ] && return 0
  die "พอร์ต ${API_PORT} ตอบมาเป็นโมเดล '${seen}' ไม่ใช่ '${SERVED_MODEL_NAME}'
     มีเซิร์ฟเวอร์อื่นยึดพอร์ตนี้อยู่ — ผลทดสอบที่ได้จะเป็นของโมเดลนั้น ไม่ใช่ตัวนี้
     แก้: หยุดตัวที่ชน หรือรันตัวนี้คนละพอร์ต  $0 restart --port 8001"
}
log() { echo "[$(date '+%H:%M:%S')] $*"; }
ssh_at() { local host="$1"; shift; ssh -o BatchMode=yes -o ConnectTimeout=10 "${SSH_USER}@${host}" "$@"; }
# worker ตัวแรก — ใช้กับงานที่อ้างถึง "worker" ตัวเดียวโดยธรรมชาติ
ssh_worker() { ssh_at "$WORKER_IP" "$@"; }
worker_count() { set -- $WORKER_IPS; echo "$#"; }

# ยังไม่มีใครบอก IP จริงเลย (ไม่มี env · ไม่มี cluster.env) = ค่าที่ถืออยู่คือตัวอย่าง 10.100.152.x
_cluster_config_is_placeholder() {
  [[ -z "${MASTER_IP_EXPLICIT:-}" && -z "${WORKER_IP_EXPLICIT:-}" ]]
}

# ทุกคำสั่งที่จะ ssh ไป worker ต้องผ่านตรงนี้ก่อน — มี tty ก็ถาม ไม่มี tty ก็บอกทางแก้แล้วหยุด
# ไม่ใช่ปล่อยให้ ssh ไป 10.100.152.2 (เครื่องตัวอย่าง) แล้วตายด้วยข้อความ "เช็ค SSH" ที่พาไปผิดทาง
_require_cluster_config() {
  local cmd="${1:-start}"
  if [[ -t 0 ]]; then prompt_cluster_config; fi
  _cluster_config_is_placeholder || return 0
  die "ยังไม่ได้ตั้งค่าคลัสเตอร์ — MASTER_IP/WORKER_IP ยังเป็นค่าตัวอย่าง (${MASTER_IP}/${WORKER_IP}) และไม่มี ${CLUSTER_ENV}
  จาก hub (เขียน cluster.env ให้จากทะเบียนเครื่อง):
      lmds node cluster --write ${SLUG} --head <ชื่อเครื่อง head>
  หรือระบุเอง (ค่าจะถูกจำเฉพาะครั้งนี้ — เขียนลง ${CLUSTER_ENV} ถ้าอยากให้อยู่ถาวร):
      MASTER_IP=<ip head> WORKER_IP=<ip worker> SSH_USER=<user บน worker> $0 ${cmd}"
}

# SSH head→worker ต้องผ่านแบบไม่ถามรหัส — ตรวจก่อนทำงานที่กินเวลา (pull image / rsync 150 GB)
# key ที่ hub ใช้เข้าเครื่องนี้ **ไม่ใช่** key ของเครื่องนี้ · ผู้ใช้ที่ deploy ผ่าน hub สำเร็จมักคิดว่า
# SSH "ตั้งแล้ว" ทั้งที่ head ยังไม่มี key ของตัวเองไปหา worker · ข้อความ "Permission denied
# (publickey)" ดิบ ๆ ของ ssh ไม่บอกว่าต้องทำอะไรที่เครื่องไหน
_check_worker_ssh() {
  local wip err
  for wip in $WORKER_IPS; do
    if err="$(ssh_at "$wip" true 2>&1)"; then continue; fi
    err="$(printf '%s' "$err" | tail -1)"
    die "SSH จาก head ไป ${SSH_USER}@${wip} ไม่ผ่าน: ${err:-ไม่มีข้อความ}
  controller สั่งงาน worker ผ่าน SSH แบบไม่ถามรหัส ด้วย key ของเครื่อง head เอง (ไม่ใช่ key ของ hub)
  ตั้งครั้งเดียวบน head (เครื่องนี้):
      [ -f ~/.ssh/id_ed25519 ] || ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519
      ssh-copy-id ${SSH_USER}@${wip}
      ssh -o BatchMode=yes ${SSH_USER}@${wip} true     # ต้องเงียบและคืน 0
  user บน worker ไม่ใช่ '${SSH_USER}' → ตั้ง SSH_USER=<user> (หรือแก้ใน ${CLUSTER_ENV})
  ต่อไม่ถึงเลย (timeout) → เช็คว่า ${wip} คือ IP ของ worker บนสายที่ head มองเห็น (ip -br addr บน worker)"
  done
}

# IP ที่ worker rank N ใช้คุย NCCL — ไม่ใช่ IP ที่ head ใช้ ssh ไปหา (คนละสายได้เมื่อ fabric แยก)
#
# เดิม worker.sh ตั้ง VLLM_HOST_IP=<IP ใน WORKER_IPS> ซึ่งเป็น management IP ทั้งที่ head เอง
# ผูกกับ TRANSPORT_IP_MASTER · torch.distributed จึงจับคู่ head บนสาย 200G กับ worker บนสาย 1G →
# ช้าลงเป็นสิบเท่าแบบเงียบ ๆ หรือต่อกันไม่ได้เลยถ้า subnet ต่างกัน (ค่า TRANSPORT_IP_WORKER
# ที่ผู้ใช้ตั้งไว้ไม่เคยถูกใช้ที่ไหนนอกจาก network-info)
_worker_transport_ip() {
  local rank="$1" wip="$2" i=0 ip
  if [[ -n "$TRANSPORT_IPS_WORKER" ]]; then
    for ip in $TRANSPORT_IPS_WORKER; do
      i=$(( i + 1 ))
      if (( i == rank )); then printf '%s' "$ip"; return 0; fi
    done
  fi
  # v2: IP ที่ head ใช้ถึง worker rank นี้คือสายตรงระหว่างสองเครื่อง = สายที่ NCCL ต้องใช้ด้วย
  if [[ -z "$TRANSPORT_IPS_WORKER" && -n "$(_rank_var HEAD_TO_WORKER_IP "$rank")" ]]; then
    _rank_var HEAD_TO_WORKER_IP "$rank"; return 0
  fi
  if (( rank == 1 )); then printf '%s' "$TRANSPORT_IP_WORKER"; else printf '%s' "$wip"; fi
}

# ── ตัวช่วยของ cluster.env v2 (หลายสาย) — ทุกตัวคืนค่าว่างเมื่อไม่มีคีย์ v2 ──
_rank_var() { local _n="$1_$2"; printf '%s' "${!_n:-}"; }      # _rank_var HEAD_TO_WORKER_IP 2
_multilink() { [[ -n "${LINKS_0:-}" || -n "${HEAD_TO_WORKER_IP_1:-}" ]]; }
_node_ifnames() { _rank_var NCCL_SOCKET_IFNAMES "$1"; }
_node_hcas() { _rank_var NCCL_IB_HCAS "$1"; }
# IP ของ head ที่ worker rank นี้ต่อกลับ (--master-addr ของมัน) — ring: คนละ IP ต่อ worker
_worker_head_ip() { local v; v="$(_rank_var WORKER_HEAD_IP "$1")"; printf '%s' "${v:-$TRANSPORT_IP_MASTER}"; }

# IPv4 อยู่วงเดียวกันไหม — $1 = ip/prefix (ไม่มี prefix = /24)  $2 = ip · ใช้เลือกสายสำรองตอน rsync
_ip2int() {
  local a b c d
  IFS=. read -r a b c d <<< "$1"
  [[ "$a$b$c$d" =~ ^[0-9]+$ ]] || { echo 0; return 0; }
  echo $(( (a << 24) | (b << 16) | (c << 8) | d ))
}
_same_subnet() {
  local ip="${1%%/*}" prefix="${1#*/}" mask
  [[ "$prefix" == "$1" || -z "$prefix" ]] && prefix=24
  [[ "$prefix" =~ ^[0-9]+$ ]] || return 1
  mask=$(( prefix == 0 ? 0 : (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF ))
  (( ($(_ip2int "$ip") & mask) == ($(_ip2int "$2") & mask) ))
}

# IP ที่ head ควรใช้ rsync/ssh ไป worker rank นี้ — สายตรงที่ hub บันทึก (HEAD_TO_WORKER_IP) ก่อน ตามด้วย
# IP อื่นของ worker ที่อยู่วงเดียวกับสายใดสายหนึ่งของ head เรียงจากสายที่เร็วที่สุด · เอาเส้นแรกที่ ssh ถึง
# (ring: มีสายตรงเส้นเดียว · switch: เส้นเดียว · แต่เครื่องที่ต่อสองเส้นถึง switch เดียวกันจะมีสองทาง)
_sync_ip_for_rank() {
  local rank="$1" wip="$2"
  _multilink || { printf '%s' "$wip"; return 0; }
  local first cand link iface ipp prank pip hlink hiface hipp x speed
  first="$(_rank_var HEAD_TO_WORKER_IP "$rank")"; first="${first:-$wip}"
  local -a extra=()
  for link in $(_rank_var LINKS "$rank"); do
    IFS=: read -r iface ipp prank pip <<< "$link"
    [[ -n "$ipp" && "${ipp%%/*}" != "$first" ]] || continue
    for hlink in $(_rank_var LINKS 0); do
      IFS=: read -r hiface hipp x x <<< "$hlink"
      [[ -n "$hipp" ]] && _same_subnet "$hipp" "${ipp%%/*}" || continue
      speed="$(cat "${NET_SYSFS_ROOT}/${hiface}/speed" 2>/dev/null || echo 0)"
      [[ "$speed" =~ ^[0-9]+$ ]] || speed=0
      extra+=("${speed}:${ipp%%/*}")
    done
  done
  local -a order=("$first")
  if (( ${#extra[@]} > 0 )); then
    while IFS= read -r cand; do order+=("${cand#*:}"); done < <(printf '%s\n' "${extra[@]}" | sort -t: -k1,1nr)
  fi
  for cand in "${order[@]}"; do
    if ssh_at "$cand" true >/dev/null 2>&1; then printf '%s' "$cand"; return 0; fi
  done
  printf '%s' "$first"
}

# สคริปต์ตรวจสายทีละเส้น — รันได้ทั้งในเครื่อง (bash -c) และผ่าน ssh บน worker · พิมพ์บรรทัดละสาย:
# iface ip/prefix → rank peer  link=up/down speed=… ip=yes/no hca=… ping=ok/FAIL (ping ออกทางสายนั้นจริง ๆ -I)
_links_probe_script() {
  printf 'LINKS=%q; ' "$1"
  # sysfs root อ่านจาก env ของเครื่องที่รัน (head ส่งของตัวเองตอนเรียก bash -c · worker ใช้ค่าปกติของมัน)
  cat <<'PROBE'
IB="${IB_SYSFS_ROOT:-/sys/class/infiniband}"; NET="${NET_SYSFS_ROOT:-/sys/class/net}"
for link in $LINKS; do
  IFS=: read -r iface ipp prank pip <<< "$link"
  state="$(cat "$NET/$iface/operstate" 2>/dev/null || echo missing)"
  speed="$(cat "$NET/$iface/speed" 2>/dev/null || echo '?')"
  hca=""; for d in "$IB"/*; do [ -e "$d/device/net/$iface" ] && { hca="$(basename "$d")"; break; }; done
  have="no"; grep -q " ${ipp%%/*}/" <<< "$(ip -o -4 addr show dev "$iface" 2>/dev/null)" && have="yes"
  ping="-"
  if [ -n "$pip" ] && [ "$pip" != "-" ]; then
    if ! command -v ping >/dev/null 2>&1; then ping="n/a"
    elif ping -c 1 -W 1 -I "$iface" "$pip" >/dev/null 2>&1; then ping="ok"
    else ping="FAIL"; fi
  fi
  printf '    %-16s %-18s -> rank %-2s %-15s link=%s speed=%s ip=%s hca=%s ping=%s\n' \
    "$iface" "$ipp" "$prank" "${pip:--}" "$state" "$speed" "$have" "${hca:--}" "$ping"
done
PROBE
}

# ตารางสายของทุก rank + ping คู่ปลายสายทางสายนั้น — v2 เท่านั้น (ไฟล์เก่าไม่มีอะไรให้พิมพ์)
_print_links() {
  _multilink || return 0
  echo "Topology   : ${CLUSTER_TOPOLOGY:-multi-link}${NCCL_CROSS_NIC:+ (NCCL_CROSS_NIC=${NCCL_CROSS_NIC})}"
  echo "  rank 0 (head, local) ifnames=${NCCL_SOCKET_IFNAME:-$(_node_ifnames 0)} hca=${NCCL_IB_HCA:-$(_node_hcas 0)}"
  IB_SYSFS_ROOT="$IB_SYSFS_ROOT" NET_SYSFS_ROOT="$NET_SYSFS_ROOT" \
    bash -c "$(_links_probe_script "$(_rank_var LINKS 0)")" 2>/dev/null || true
  local wip r=0
  for wip in $WORKER_IPS; do
    r=$(( r + 1 ))
    echo "  rank ${r} (${wip}) ifnames=$(_node_ifnames "$r") hca=${NCCL_IB_HCA_EXPLICIT:-$(_node_hcas "$r")} head-ip=$(_worker_head_ip "$r")"
    ssh_at "$wip" "$(_links_probe_script "$(_rank_var LINKS "$r")")" 2>/dev/null || echo "    (SSH ไป ${wip} ล้มเหลว)"
  done
}

# KB → ข้อความอ่านง่าย (GB เมื่อถึง ไม่งั้น MB) — ตัวเลข "0 GB" บอกอะไรไม่ได้
_human_kb() {
  local kb="${1:-0}"
  if (( kb >= 1024 * 1024 )); then echo "$(( kb / 1024 / 1024 )) GB"; else echo "$(( kb / 1024 )) MB"; fi
}

# KB ว่างของ filesystem ที่ถือ path นี้ (ไต่ขึ้นไปหา parent ที่มีอยู่จริง) · อ่านไม่ได้ = 0
_free_kb() {
  local p="$1"
  while [[ ! -e "$p" && "$p" != "/" ]]; do p="$(dirname "$p")"; done
  df -Pk "$p" 2>/dev/null | awk 'NR == 2 { print $4 }' || echo 0
}

# ทำไม pull ไม่ได้ — registry แต่ละแห่งล้มคนละแบบ และข้อความของ docker ไม่บอกว่าต้องทำอะไร
# docker pull ที่บอกสาเหตุได้จริง — เคสจริง 2026-09-05 (ลูกค้า cynbangkok · DeepSeek-V4-Flash stacked):
# "ดึง image … ไม่สำเร็จ" ทั้งที่ digest ยังอยู่บน ghcr.io · docker พิมพ์เหตุผลจริงไว้ *เหนือ* คำแนะนำของเรา
# แล้วเลื่อนหายไป ผู้ใช้เห็นแต่ท้าย · ตอนนี้: (1) ตรวจดิสก์ของ docker และทางไป registry ก่อน (2) pull ซ้ำได้
# 3 รอบ — layer ที่ครบแล้ว docker ไม่โหลดซ้ำ สายหลุดกลางทาง (unexpected EOF / connection reset) จึงมักผ่านรอบสอง
# (3) เก็บบรรทัดท้ายของ docker ไว้พิมพ์คู่กับสาเหตุที่จับได้จากข้อความนั้น
DOCKER_PULL_ATTEMPTS="${DOCKER_PULL_ATTEMPTS:-3}"
DOCKER_PULL_RETRY_WAIT="${DOCKER_PULL_RETRY_WAIT:-10}"
_registry_of() { local first="${1%%/*}"; if [[ "$first" == *.* || "$first" == *:* || "$first" == localhost ]]; then printf '%s' "$first"; else printf 'registry-1.docker.io'; fi; }
_docker_pull() {
  local image="$1" where="${2:-}" attempt rc=0 errlog registry code free_kb root
  errlog="$(mktemp /tmp/lmds-pull.XXXXXX)"
  # ดิสก์: image 10-30 GB ต้องมีที่ให้ layer ที่บีบอัด + ที่แตกแล้ว
  root="$(docker info -f '{{.DockerRootDir}}' 2>/dev/null || true)"
  root="${root:-/var/lib/docker}"
  free_kb="$(df -Pk "$root" 2>/dev/null | awk 'NR == 2 { print $4 }' || true)"
  free_kb="${free_kb:-0}"
  if [[ "$free_kb" =~ ^[0-9]+$ ]] && (( free_kb > 0 && free_kb < 20 * 1024 * 1024 )); then
    echo "  WARN: ดิสก์ของ docker (${root}) เหลือ $(( free_kb / 1024 / 1024 )) GB — image นี้ต้องการราว 20 GB ระหว่างแตก layer (docker system prune -a ช่วยได้)" >&2
  fi
  # ทางไป registry: 200/401 = ถึง (401 คือถามสิทธิ์ตามปกติ) · 000 = DNS/ไฟร์วอลล์/proxy
  registry="$(_registry_of "$image")"
  code="$(curl -sS -m 10 -o /dev/null -w '%{http_code}' "https://${registry}/v2/" 2>>"$errlog" || true)"
  if [[ "$code" == "000" ]]; then
    echo "  เครื่อง${where:+ $where} ไปไม่ถึง https://${registry}/v2/ — $(tail -n 1 "$errlog" | sed 's/^curl: ([0-9]*) //')" >&2
    echo "  (ไม่ใช่ปัญหาของ image: ตรวจ DNS/ทางออกเน็ต/proxy ของ docker บนเครื่องนี้ก่อน · หรือใช้ทาง docker save | docker load ด้านล่าง)" >&2
  fi
  for (( attempt = 1; attempt <= DOCKER_PULL_ATTEMPTS; attempt++ )); do
    rc=0
    docker pull "$image" 2> >(tee "$errlog" >&2) || rc=$?
    wait 2>/dev/null || true
    (( rc == 0 )) && { rm -f "$errlog"; return 0; }
    # หมดสิทธิ์/ไม่มี image/ดิสก์เต็ม = ลองซ้ำก็เท่าเดิม
    if grep -qiE 'toomanyrequests|unauthorized|denied|manifest unknown|not found|no space left' "$errlog"; then break; fi
    if (( attempt < DOCKER_PULL_ATTEMPTS )); then
      echo "  pull รอบ ${attempt}/${DOCKER_PULL_ATTEMPTS} ล้ม ($(tail -n 1 "$errlog" | cut -c1-120)) — ลองใหม่ใน ${DOCKER_PULL_RETRY_WAIT} วิ (layer ที่ครบแล้วไม่โหลดซ้ำ)" >&2
      sleep "$DOCKER_PULL_RETRY_WAIT"
    fi
  done
  echo "  docker บอกว่า: $(grep -v '^$' "$errlog" | tail -n 3 | tr '\n' ' ' | cut -c1-400)" >&2
  _pull_diagnosis "$errlog" "$where"
  rm -f "$errlog"
  return "$rc"
}
# แปลข้อความของ docker เป็นสาเหตุเดียวที่ควรแก้ก่อน
_pull_diagnosis() {
  local errlog="$1" where="$2"
  if grep -qiE 'no such host|server misbehaving|i/o timeout|TLS handshake timeout|network is unreachable|connection refused|proxyconnect' "$errlog"; then
    echo "  → สาเหตุ: เครื่อง${where:+ $where} ออกเน็ตไปหา registry ไม่ได้ (DNS/ไฟร์วอลล์/proxy) — ไม่ใช่ image หาย" >&2
  elif grep -qiE 'toomanyrequests|rate limit' "$errlog"; then
    echo "  → สาเหตุ: registry จำกัดจำนวน pull — docker login แล้วสั่งซ้ำ" >&2
  elif grep -qiE 'unauthorized|denied' "$errlog"; then
    echo "  → สาเหตุ: ไม่มีสิทธิ์ดึง image นี้ — docker login ด้วยบัญชีที่เข้าถึงได้" >&2
  elif grep -qiE 'manifest unknown|not found' "$errlog"; then
    echo "  → สาเหตุ: tag/digest นี้ไม่มีบน registry แล้ว — lmds set ${SLUG:-<slug>} --image <repo:tag> ที่ยังมี" >&2
  elif grep -qiE 'no space left' "$errlog"; then
    echo "  → สาเหตุ: ดิสก์เต็ม — docker system prune -a หรือย้าย data-root" >&2
  elif grep -qiE 'unexpected EOF|connection reset|read: connection|EOF' "$errlog"; then
    echo "  → สาเหตุ: สายหลุดระหว่างโหลด (ลองซ้ำ ${DOCKER_PULL_ATTEMPTS} รอบแล้ว) — เน็ตไม่นิ่ง ลองใหม่ตอนเน็ตว่าง หรือดึงจากเครื่องอื่นแล้ว docker save | docker load" >&2
  fi
}

_pull_hints() {
  local image="$1" node="${2:-เครื่องนี้}"
  echo "  ดึง image ${image} บน ${node} ไม่สำเร็จ — สาเหตุที่พบบ่อย:" >&2
  case "$image" in
    ghcr.io/*)
      echo "    · ghcr.io จำกัดจำนวน pull แบบไม่ login (toomanyrequests / 429) → docker login ghcr.io -u <github user> (ใช้ PAT read:packages)" >&2 ;;
    nvcr.io/*)
      echo "    · nvcr.io ต้อง login เมื่อ image ไม่ public → docker login nvcr.io (user = \$oauthtoken · password = NGC API key)" >&2 ;;
    *)
      echo "    · Docker Hub จำกัด pull ของ user นิรนาม (100 ครั้ง/6 ชม. ต่อ IP) → docker login" >&2 ;;
  esac
  echo "    · manifest unknown / not found = tag/digest นี้ไม่มีแล้ว → เลือก image อื่น: lmds set ${SLUG} --image <image>" >&2
  echo "    · เครื่องออกเน็ตผ่าน proxy: docker daemon ไม่อ่าน HTTP_PROXY ของ shell → ตั้งใน /etc/systemd/system/docker.service.d/http-proxy.conf แล้ว systemctl restart docker" >&2
  echo "    · ${node} ไม่มีทางออกเน็ตเลย: ส่ง image จากเครื่องที่มี → docker save <image> | ssh <user>@<${node}> docker load" >&2
  echo "      (image ที่ load แบบนี้ไม่มี digest — ต้อง lmds set ${SLUG} --image <repo:tag> ให้ทุก node อ้างชื่อเดียวกัน)" >&2
}

_require_non_root() {
  if (( EUID == 0 )); then
    die "อย่ารัน controller ด้วย sudo/root — ให้รันเป็น user ปกติที่เป็นเจ้าของ HF cache และตั้ง SSH key ไว้ (sudo เปลี่ยน HOME/SSH_USER ทำให้ image check ชี้ไป root@worker)"
  fi
}

detect_advertise_ip() {
  # คืน 0 เสมอ (พิมพ์ว่างได้ถ้าตรวจไม่เจอ) — กัน set -e ตัดจบเมื่อ bare assignment
  if [[ -n "$ADVERTISE_IP" ]]; then printf '%s' "$ADVERTISE_IP"; return 0; fi
  local found=""
  if [[ -n "$ADVERTISE_INTERFACE" ]]; then
    found="$(ip -4 -o addr show dev "$ADVERTISE_INTERFACE" scope global 2>/dev/null |
      awk 'NR == 1 { split($4, a, "/"); print a[1] }' || true)"
    printf '%s' "$found"; return 0
  fi
  found="$(ip -4 route get "$ROUTE_PROBE_IP" 2>/dev/null |
    awk '{ for (i=1; i<=NF; i++) if ($i=="src") { print $(i+1); exit } }' || true)"
  if [[ -n "$found" ]]; then printf '%s' "$found"; return 0; fi
  found="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  printf '%s' "$found"
  return 0
}

validate_numbers() {
  [[ "$API_PORT" =~ ^[0-9]+$ ]] && (( API_PORT >= 1 && API_PORT <= 65535 )) ||
    die "invalid API_PORT: $API_PORT"
  [[ "$MAX_MODEL_LEN" =~ ^[0-9]+$ ]] && (( MAX_MODEL_LEN > 0 )) ||
    die "invalid context: $MAX_MODEL_LEN"
  # เพดานของโมเดล (max_position_embeddings จาก config.json) — vLLM ปฏิเสธ max-model-len ที่เกินอยู่แล้ว
  # แต่ตายช้าตอนสร้าง ModelConfig (stacked = worker ตายก่อน head จะเริ่ม) และข้อความอ่านยาก
  # · ปล่อยผ่านได้เฉพาะเมื่อผู้ใช้ตั้งใจ: ENGINE_ENV มี VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 (RoPE เกินเพดาน = nan)
  if (( NATIVE_CONTEXT > 0 && MAX_MODEL_LEN > NATIVE_CONTEXT )) &&
     [[ " ${ENGINE_ENV:-} " != *" VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 "* ]]; then
    die "context ${MAX_MODEL_LEN} เกินเพดานของโมเดลนี้ (${NATIVE_CONTEXT} = max_position_embeddings) — ใช้ --context ${NATIVE_CONTEXT} หรือต่ำกว่า · ต้องการเกินจริง ๆ ให้ตั้ง engine env VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 (ผลลัพธ์อาจเป็น nan เมื่อเกิน)"
  fi
  # ต่ำเกิน = ไม่เหลือที่ให้ KV cache · สูงเกิน = ชน OOM ตอน warm-up (unified memory ยิ่งไวเพราะ
  # CPU กับ GPU ใช้ pool เดียวกัน) · bash เทียบทศนิยมไม่ได้ จึงใช้ awk
  awk -v v="$GPU_MEMORY_UTILIZATION" 'BEGIN{exit !(v+0 > 0.3 && v+0 <= 0.98)}' ||
    die "invalid --gpu-util: $GPU_MEMORY_UTILIZATION (ต้องอยู่ระหว่าง 0.3 ถึง 0.98)"
  [[ "$CLIENT_OUTPUT" =~ ^[0-9]+$ ]] && (( CLIENT_OUTPUT > 0 )) ||
    die "invalid CLIENT_OUTPUT: $CLIENT_OUTPUT"
}

parse_options() {
  REMAINING_ARGS=()
  while (( $# )); do
    case "$1" in
      --context)         MAX_MODEL_LEN="$2"; shift 2 ;;
      --extra-args)     EXTRA_SERVE_ARGS="$2"; shift 2 ;;
      --extra-args=*)   EXTRA_SERVE_ARGS="${1#*=}"; shift ;;
      --context=*)       MAX_MODEL_LEN="${1#*=}"; shift ;;
      --gpu-util)       GPU_MEMORY_UTILIZATION="$2"; shift 2 ;;
      --gpu-util=*)   GPU_MEMORY_UTILIZATION="${1#*=}"; shift ;;
      --port)            API_PORT="$2"; shift 2 ;;
      --port=*)          API_PORT="${1#*=}"; shift ;;
      --bind)            API_HOST="$2"; shift 2 ;;
      --bind=*)          API_HOST="${1#*=}"; shift ;;
      --advertise-ip)    ADVERTISE_IP="$2"; shift 2 ;;
      --advertise-ip=*)  ADVERTISE_IP="${1#*=}"; shift ;;
      --interface)       ADVERTISE_INTERFACE="$2"; shift 2 ;;
      --interface=*)     ADVERTISE_INTERFACE="${1#*=}"; shift ;;
      --client-input)    CLIENT_INPUT="$2"; shift 2 ;;
      --client-input=*)  CLIENT_INPUT="${1#*=}"; shift ;;
      --client-output)   CLIENT_OUTPUT="$2"; shift 2 ;;
      --client-output=*) CLIENT_OUTPUT="${1#*=}"; shift ;;
      --dry-run)         DRY_RUN=1; shift ;;
      *) REMAINING_ARGS+=("$1"); shift ;;
    esac
  done
  validate_numbers
}

# ─────────────────── snapshot path resolution ───────────────────
_model_slug() { printf '%s' "${MODEL_ID//\//--}"; }

_model_cache_dir() {
  local hf_root="${1:-$HF_HOME}" slug candidate
  slug="$(_model_slug)"
  for candidate in "${hf_root}/hub/models--${slug}" "${hf_root}/models--${slug}"; do
    if [[ -d "${candidate}/snapshots" ]]; then printf '%s' "$candidate"; return 0; fi
  done
  printf '%s/hub/models--%s' "$hf_root" "$slug"
}

# path ฝั่งคอนเทนเนอร์ที่ HF ควรใช้เป็น hub cache (mount $HF_HOME ไว้ที่ /cache)
_container_hub_cache() {
  local hf_root="${1:-$HF_HOME}" slug
  slug="$(_model_slug)"
  if [[ -d "${hf_root}/models--${slug}/snapshots" && ! -d "${hf_root}/hub/models--${slug}/snapshots" ]]; then
    printf '/cache'      # เลย์เอาต์เก่า: โมเดลอยู่ที่รากของ HF_HOME
  else
    printf '/cache/hub'
  fi
}

_snapshot_path() {
  local hf_root="${1:-$HF_HOME}" model_dir ref_file commit snap
  model_dir="$(_model_cache_dir "$hf_root")"
  if [[ -d "${model_dir}/snapshots/${MODEL_REVISION}" ]]; then
    printf '%s' "${model_dir}/snapshots/${MODEL_REVISION}"; return 0
  fi
  ref_file="${model_dir}/refs/${MODEL_REVISION}"
  if [[ -f "$ref_file" ]]; then
    commit="$(tr -d '[:space:]' < "$ref_file")"
    if [[ -n "$commit" && -d "${model_dir}/snapshots/${commit}" ]]; then
      printf '%s' "${model_dir}/snapshots/${commit}"; return 0
    fi
  fi
  snap="$(find "${model_dir}/snapshots" -mindepth 1 -maxdepth 1 -type d -print -quit 2>/dev/null || true)"
  if [[ -n "$snap" ]]; then printf '%s' "$snap"; return 0; fi
  printf '%s' "${model_dir}/snapshots/${MODEL_REVISION}"
}

# ─────────────────────── runtime image lock ───────────────────────
_current_image_id() { docker inspect "$VLLM_IMAGE" --format '{{.Id}}' 2>/dev/null || true; }

_worker_image_id() { ssh_at "$1" "docker inspect '$VLLM_IMAGE' --format '{{.Id}}' 2>/dev/null" 2>/dev/null || true; }

prepare_runtime() {
  _require_non_root
  need docker
  _check_worker_ssh
  mkdir -p "$HF_HOME"
  # idempotent: image ที่มีแล้ว docker pull แค่เช็ค digest แล้วจบใน 1-2 วิ · ล้มต้องบอกเหตุ+ทางแก้
  # ไม่ใช่ตายเงียบด้วย exit code ของ docker ใต้ set -e (เดิมบรรทัดนี้ไม่มี || อะไรเลย)
  log "Pulling runtime image on head node …"
  if ! _docker_pull "$VLLM_IMAGE" "head"; then
    _pull_hints "$VLLM_IMAGE" "head"
    die "prepare-runtime หยุดที่ head — แก้ตามข้างบนแล้วสั่งใหม่: $0 prepare-runtime"
  fi
  local head_id worker_id
  head_id="$(_current_image_id)"
  [[ -n "$head_id" ]] || die "pull head image ไม่สำเร็จ"
  echo "$head_id" > "$IMAGE_LOCK_FILE"
  log "Head image locked: $head_id"

  # worker ทุกตัว: ตัวไหนล้มก็บอกชื่อตัวนั้นพร้อมคำสั่งที่รันบนเครื่องนั้นได้เลย
  local wip
  for wip in $WORKER_IPS; do
    log "Pulling runtime image on worker node (${wip}) …"
    # worker: ส่ง helper ตัวเดียวกันไปรันที่นั่น (retry + วินิจฉัย) — ไม่ใช่ docker pull เปล่า ๆ ที่ล้มเงียบ
    if ! ssh_at "$wip" "SLUG='${SLUG}' DOCKER_PULL_ATTEMPTS='${DOCKER_PULL_ATTEMPTS}' DOCKER_PULL_RETRY_WAIT='${DOCKER_PULL_RETRY_WAIT}'; $(declare -f _registry_of _docker_pull _pull_diagnosis); _docker_pull '$VLLM_IMAGE' 'worker ${wip}'"; then
      _pull_hints "$VLLM_IMAGE" "worker ${wip}"
      die "prepare-runtime หยุดที่ worker ${wip} — บนเครื่องนั้น: ssh ${SSH_USER}@${wip} docker pull '${VLLM_IMAGE}'
  แล้วสั่งซ้ำ: $0 prepare-runtime   (head ที่ pull แล้วจะผ่านทันที)"
    fi
  done
  for wip in $WORKER_IPS; do
    worker_id="$(_worker_image_id "$wip")"
    [[ -n "$worker_id" ]] || die "อ่าน image id ของ ${wip} ไม่ได้ — ssh ${SSH_USER}@${wip} docker inspect '${VLLM_IMAGE}'"
    [[ "$head_id" == "$worker_id" ]] ||
      die "image ต่างกันระหว่าง head (${head_id:0:19}…) กับ worker ${wip} (${worker_id:0:19}…)
  image ถูก tag ซ้ำคนละ build (tag ไม่ตรึง digest) — ให้ทุก node ดึงตัวเดียวกัน:
      ssh ${SSH_USER}@${wip} docker pull '${VLLM_IMAGE}'   แล้ว   $0 prepare-runtime"
    log "worker ${wip}: image ${worker_id:0:19}… ตรงกับ head"
  done
  log "Runtime images ตรงกันทุก node ($(( $(worker_count) + 1 )) เครื่อง). Lock: ${head_id:0:32}…"
}

# ก่อน start: image เดียวกันเป๊ะ (ID) บน head และ **worker ทุกตัว** · เดิมถามแค่ worker ตัวแรก
# คลัสเตอร์ 3-4 เครื่องที่ตัวท้ายยังไม่มี image จึงผ่านด่านนี้ไปตายตอน docker run บน worker
# นั้นด้วย "Unable to find image" ระหว่างที่ตัวอื่นเปิดไปแล้ว
_assert_runtime_images() {
  local head_id worker_id locked="" wip
  head_id="$(_current_image_id)"
  [[ -n "$head_id" ]] || die "ไม่พบ runtime image บน head: ${VLLM_IMAGE} — รัน: $0 prepare-runtime"
  for wip in $WORKER_IPS; do
    worker_id="$(_worker_image_id "$wip")"
    [[ -n "$worker_id" ]] || die "ไม่พบ runtime image บน worker ${wip}: ${VLLM_IMAGE}
  รัน: $0 prepare-runtime   (หรือเฉพาะเครื่องนั้น: ssh ${SSH_USER}@${wip} docker pull '${VLLM_IMAGE}')"
    [[ "$head_id" == "$worker_id" ]] || die "image ต่างกัน: head=${head_id:0:19}… worker ${wip}=${worker_id:0:19}…
  ทุก node ต้องใช้ build เดียวกัน (bundle.env VLLM_IMAGE ใช้ร่วมกัน) — รัน: $0 prepare-runtime
  (หรือเฉพาะเครื่องนั้น: ssh ${SSH_USER}@${wip} docker pull '${VLLM_IMAGE}')"
  done
  [[ -f "$IMAGE_LOCK_FILE" ]] && locked="$(cat "$IMAGE_LOCK_FILE")"
  [[ -z "$locked" || "$locked" == "$head_id" ]] ||
    die "image ปัจจุบัน (${head_id:0:19}…) ต่างจากที่ lock ไว้ (${locked:0:19}…) — รัน prepare-runtime ใหม่ก่อน start"
  printf '%s' "$head_id"
}

need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

runtime_info() {
  echo "Image     : $VLLM_IMAGE"
  echo "Backend   : mp (vLLM multiprocessing, TP=${TENSOR_PARALLEL_SIZE}, nnodes=${NNODES})"
  local locked="not yet locked (run prepare-runtime)"
  [[ -f "$IMAGE_LOCK_FILE" ]] && locked="$(cat "$IMAGE_LOCK_FILE")"
  echo "Locked ID : ${locked}"
  docker inspect "$VLLM_IMAGE" --format 'Current ID : {{.Id}}' 2>/dev/null || true
}

# ───────────────────────────── download ─────────────────────────────
# ไม่มีอะไรคืบหน้าเกินเท่านี้ = ถือว่าค้างตาย แล้วเริ่มใหม่ (ต่อจากของเดิมเสมอ)
DOWNLOAD_STALL_SECONDS="${DOWNLOAD_STALL_SECONDS:-600}"
DOWNLOAD_MAX_ATTEMPTS="${DOWNLOAD_MAX_ATTEMPTS:-10}"

_download_bytes() {
  du -sb "$(_model_cache_dir)" 2>/dev/null | cut -f1 || echo 0
}

# โฟลเดอร์ hub cache ฝั่งคอนเทนเนอร์ที่ snapshot_download จะเขียนลง
#
# เดิมใช้ cache_dir='/cache' = เลย์เอาต์แบน ($HF_HOME/models--…) ซึ่งต่างจากทุกทางอื่นของระบบ
# (single-vLLM · rsync ไป worker · lmds clone · hf CLI ใช้ $HF_HOME/hub/models--…) — head กับ
# worker จึงถือคนละเลย์เอาต์เสมอ และเครื่องมือที่มองหา hub/ ตอบว่า "ยังไม่มีไฟล์" ทั้งที่โหลดครบ
# ของที่โหลดค้างไว้แบบแบนอยู่แล้วต้องโหลดต่อที่เดิม (ย้ายไป hub/ = เริ่มใหม่ 150 GB)
_download_cache_dir() {
  if [[ -d "${HF_HOME}/models--$(_model_slug)" && ! -d "${HF_HOME}/hub/models--$(_model_slug)" ]]; then
    printf '/cache'
  else
    printf '/cache/hub'
  fi
}

# ดิสก์ต้องพอสำหรับส่วนที่ยังไม่ได้โหลด — โมเดลระดับนี้ 150-220 GB · เต็มกลางทางคือ
# "download ล้มเหลว" ที่คนโทษเน็ต/Xet ไปหลายรอบก่อนจะเห็น No space left ใน log
_check_download_disk() {
  (( TOTAL_SIZE_APPROX_GB > 0 )) || return 0
  local have need free_kb need_kb
  have="$(_download_bytes)"
  need=$(( TOTAL_SIZE_APPROX_GB * 1024 * 1024 * 1024 - ${have:-0} ))
  (( need > 0 )) || return 0
  need_kb=$(( need / 1024 * 105 / 100 ))          # เผื่อ 5% ให้ .incomplete/metadata
  free_kb="$(_free_kb "$HF_HOME")"
  (( ${free_kb:-0} > 0 )) || return 0              # df อ่านไม่ได้ = ไม่ฟันธง
  (( free_kb >= need_kb )) && return 0
  die "ดิสก์ที่ ${HF_HOME} เหลือ $(_human_kb "$free_kb") แต่ยังต้องโหลดอีก ~$(_human_kb "$need_kb") (โมเดล ~${TOTAL_SIZE_APPROX_GB} GB)
  ย้าย cache ไปดิสก์ที่ว่างพอ (ต้องใช้ path นี้ทุกคำสั่งหลังจากนี้ หรือเขียนลง bundle.env):
      HF_HOME=/data/hf $0 download
  worker ต้องมีที่เท่ากัน (sync-worker ตรวจให้อีกที) — ตั้ง WORKER_HF_HOME ถ้า path ฝั่งนั้นต่าง"
}

# log ของคอนเทนเนอร์ download บอกสาเหตุอยู่แล้ว แต่ผู้ใช้เห็นมันไหลผ่านไปหลายร้อยบรรทัด
# แล้วได้ "download ล้มเหลว" ปิดท้าย — หยิบบรรทัดที่เป็นสาเหตุมาพูด และบอกว่าต้องแก้ที่ไหน
# พิมพ์ชนิด (auth/notfound/disk/network/xet/unknown) ออก stdout · คำอธิบายออก stderr
_explain_download_failure() {
  local name="$1" text kind="unknown"
  text="$(docker logs --tail 80 "$name" 2>&1 || true)"
  if grep -qE 'GatedRepoError|401 Client Error|Access to model .* is restricted|is a gated' <<< "$text"; then
    kind="auth"
    echo "สาเหตุ: repo ปฏิเสธการเข้าถึง (gated / token ไม่มีสิทธิ์)" >&2
    echo "  1) กดขอสิทธิ์ที่ https://huggingface.co/${MODEL_ID} ให้ขึ้น ACCEPTED" >&2
    echo "  2) export HF_TOKEN=hf_xxx (token ของบัญชีที่ได้สิทธิ์) แล้ว: $0 download" >&2
  elif grep -qE '403 Client Error|Forbidden' <<< "$text"; then
    kind="auth"
    echo "สาเหตุ: token นี้ไม่มีสิทธิ์อ่าน ${MODEL_ID} (403) — ใช้ token ของบัญชีที่ได้รับสิทธิ์แล้ว" >&2
  elif grep -qE 'RepositoryNotFoundError|RevisionNotFoundError|404 Client Error' <<< "$text"; then
    kind="notfound"
    echo "สาเหตุ: ไม่พบ repo/revision ${MODEL_ID}@${MODEL_REVISION} (404) — repo ถูกลบ/เปลี่ยนชื่อ หรือ revision ไม่มีแล้ว" >&2
    echo "  สร้าง bundle ใหม่จาก hub (revision ล่าสุด) หรือ MODEL_REVISION=<commit> $0 download" >&2
  elif grep -qE 'No space left on device|OSError: \[Errno 28\]' <<< "$text"; then
    kind="disk"
    echo "สาเหตุ: ดิสก์เต็ม (${HF_HOME}) — ย้าย cache: HF_HOME=/data/hf $0 download" >&2
  elif grep -qE 'hex hash value|xet|Xet' <<< "$text"; then
    kind="xet"
    echo "สาเหตุ: Xet transfer ล้ม — จะลองใหม่โดยปิด Xet ให้เอง" >&2
  elif grep -qE 'Name or service not known|Temporary failure in name resolution|Connection refused|ProxyError|Max retries exceeded|ConnectionError|Read timed out|ConnectTimeout|SSLError|Network is unreachable' <<< "$text"; then
    kind="network"
    echo "สาเหตุ: ต่อ Hugging Face ไม่ได้จากในคอนเทนเนอร์ (เน็ต/DNS/proxy)" >&2
    echo "  ทดสอบจาก host: curl -sSI https://huggingface.co/api/models/${MODEL_ID} | head -1" >&2
    echo "  ออกเน็ตผ่าน proxy → export HTTPS_PROXY=http://proxy:port (controller ส่งต่อให้คอนเทนเนอร์เอง)" >&2
    echo "  ใช้ mirror → export HF_ENDPOINT=https://hf-mirror.com" >&2
  else
    echo "สาเหตุ (ท้าย log ของตัวโหลด):" >&2
    printf '%s\n' "$text" | grep -vE '^\s*$' | tail -6 | sed 's/^/  | /' >&2
  fi
  printf '%s' "$kind"
}

download() {
  need docker
  # ยืนยันว่ามี image ก่อนแตะเรื่องน้ำหนักโมเดล
  #
  # เคสจริงที่ลูกค้าเจอ 2026-09-01: image เป็น `nvcr.io/nvidia/vllm:latest` ซึ่งไม่มีอยู่จริง
  # แล้ว `docker run` ล้มด้วย "manifest unknown" · ของเดิมจับ exit code ที่ไม่เป็นศูนย์แล้ว
  # สรุปเองว่าเป็นปัญหา Xet → ลองใหม่โดยปิด Xet → ล้มอีก → พิมพ์ว่า
  # "download ล้มเหลวแม้ปิด Xet แล้ว" ซึ่งพาคนไปดูผิดที่ทั้งหมด
  ensure_image "${VLLM_IMAGE}"
{% endraw %}{% if report.gated %}  # gated repo: ไม่มี token = ดาวน์โหลดล้มด้วย 401 ที่อ่านยาก — ตรวจตั้งแต่ต้นดีกว่า
  if [[ -z "${HF_TOKEN:-}" ]]; then
    die "${MODEL_ID} เป็น gated repo — ต้องมี HF_TOKEN ก่อน download
  1) ขอสิทธิ์ที่ https://huggingface.co/${MODEL_ID} (ต้องขึ้น ACCEPTED)
  2) สร้าง token ที่ https://huggingface.co/settings/tokens
  3) export HF_TOKEN=hf_xxx   แล้วรันใหม่: $0 download
หมายเหตุ: token ไม่ได้ถูกเก็บไว้ในสคริปต์นี้โดยเจตนา (กัน secret หลุดไปกับ bundle)"
  fi
{% endif %}{% raw %}  mkdir -p "$HF_HOME"
  _check_download_disk
  log "Downloading ${MODEL_ID} @ ${MODEL_REVISION} (resume-safe) …"
  # PYTHONUNBUFFERED / -u: ในคอนเทนเนอร์ไม่มี tty แถบ progress ของ huggingface_hub
  # เลื่อนตัวเลขด้วย \r ล้วน ๆ ไม่เคยขึ้นบรรทัดใหม่ — stderr ที่ line-buffer ไว้จึงไม่ flush
  # ให้เลย · download หลายสิบ GB เงียบสนิทจนจบ คนดูแยกไม่ออกว่าโหลดอยู่หรือค้างไปแล้ว
  # ชื่อ container ต่างกันทุกรอบ — ค้างแล้วเริ่มใหม่ต้องไม่ไปชนตัวเดิมที่ยังลบไม่เสร็จ
  local dl_name="lmds-dl-$$-${RANDOM}"
  local dl_args=(
    run -d --name "$dl_name" --network host
    --user "$(id -u):$(id -g)"
    -e HOME=/tmp -e USER=lmds -e HF_HOME=/cache -e PYTHONUNBUFFERED=1
    -e "MODEL_ID=${MODEL_ID}" -e "MODEL_REVISION=${MODEL_REVISION}"
    -e HF_HUB_DOWNLOAD_TIMEOUT=30
    -v "${HF_HOME}:/cache"
  )
  # `-e HF_TOKEN` เฉย ๆ (ไม่มี =ค่า) = docker หยิบค่าจาก env ของเชลล์นี้ไปเอง
  #
  # ของเดิมเขียน `-e "HF_TOKEN=${HF_TOKEN}"` ซึ่งเอาค่าจริงไปแปะไว้ใน **argv ของ
  # docker run** — user ทุกคนบนเครื่องอ่านได้ด้วย `ps` เฉย ๆ (เจอจริงบน spark-head
  # 2026-08-31: token โผล่เต็ม ๆ ในบรรทัดคำสั่ง) · LMDS มีหลักเรื่องนี้อยู่แล้วในเส้นทาง
  # SSH ที่ส่งความลับทาง stdin เท่านั้น — เส้นทาง docker หลุดหลักนั้นไป
  [[ -n "${HF_TOKEN:-}" ]] && dl_args+=(-e HF_TOKEN)
  # proxy / mirror ของ shell ไม่ได้ติดเข้าคอนเทนเนอร์เอง (--network host แชร์แค่ network stack
  # ไม่ใช่ env) — ไซต์ที่ออกเน็ตผ่าน proxy หรือใช้ HF_ENDPOINT=hf-mirror จึง "download ล้มเหลว"
  # ด้วย Name or service not known ทั้งที่ curl จาก host ได้ · ส่งต่อเฉพาะที่ตั้งไว้ ด้วยชื่อ
  # (ไม่ใส่ค่า) เหมือน HF_TOKEN — proxy URL มักมีรหัสผ่านฝังอยู่ ไม่ควรโผล่ใน ps
  local passthru
  for passthru in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy \
                  HF_ENDPOINT HF_HUB_ETAG_TIMEOUT HF_XET_HIGH_PERFORMANCE HF_XET_NUM_CONCURRENT_RANGE_GETS; do
    [[ -n "${!passthru:-}" ]] && dl_args+=(-e "$passthru")
  done
  # Xet เป็น backend ใหม่ของ Hub ที่บาง repo (เช่นตระกูล Llama) ยังพังด้วย
  # "Unable to parse string as hex hash value" — ลองซ้ำโดยปิด Xet ให้อัตโนมัติ
  [[ -n "${HF_HUB_DISABLE_XET:-}" ]] && dl_args+=(-e "HF_HUB_DISABLE_XET=1")
  dl_args+=(-e "CACHE_DIR=$(_download_cache_dir)")
  dl_args+=(--entrypoint python3 "$VLLM_IMAGE" -u -c "
import os
from huggingface_hub import snapshot_download
path = snapshot_download(
    repo_id=os.environ['MODEL_ID'],
    revision=os.environ['MODEL_REVISION'],
    cache_dir=os.environ['CACHE_DIR'],
)
print('download complete:', path, flush=True)
")

  if ! docker "${dl_args[@]}" >/dev/null; then
    # ถึงตรงนี้ image มีแล้ว (ensure_image) — ที่ล้มคือ docker เอง (daemon / สิทธิ์ / disk ของ docker)
    die "docker run ตัวโหลดไม่ขึ้นเลย (ดูข้อความของ docker ด้านบน) — เช็ค: docker info · id -nG | grep docker · df -h /var/lib/docker"
  fi

  # เฝ้าว่ายังคืบหน้าอยู่ไหม — ไม่ใช่แค่ "process ยังไม่ตาย"
  #
  # เคสจริง 2026-08-31 บน spark-head: หยุดนิ่งที่ 36/170.9 GB นาน **1 ชั่วโมง 32 นาที**
  # โดยไม่มี error ไม่มี log · connection ไปหา CDN ยังเปิดค้าง process นอนหลับใน recv()
  # รอข้อมูลที่ไม่มีวันมา · ฝั่ง llama.cpp กันไว้แล้วด้วย --speed-limit/--speed-time ของ
  # curl แต่ huggingface_hub ในคอนเทนเนอร์ไม่มีตัวกันแบบนั้นเลย
  #
  # และคนที่เห็นว่ามันค้างมักสั่งใหม่ทับ แล้วตัวใหม่ไปติด lock ของตัวเดิม กลายเป็นกอง
  # ซ้อนกันสามตัวที่ไม่มีตัวไหนทำงาน (เจอจริงเช่นกัน)
  docker logs -f "$dl_name" 2>&1 &
  local logs_pid=$! last quiet=0 now
  last="$(_download_bytes)"
    # เทียบด้วย case ไม่ใช่ท่อไปหา grep — grep ที่ออกก่อนทำให้ docker โดน SIGPIPE
  # ใต้ set -o pipefail ทั้ง pipeline จึงคืนค่าไม่เป็นศูนย์แบบสุ่ม ๆ
  while [[ "$(docker inspect -f '{{.State.Running}}' "$dl_name" 2>/dev/null)" == "true" ]]; do
    sleep 30
    now="$(_download_bytes)"
    # เทียบว่า "เปลี่ยนไหม" ไม่ใช่ "มากขึ้นไหม"
    #
    # เคสจริง 2026-09-01 บน spark-head: ของเดิมเก็บ last เป็น "ค่าสูงสุดที่เคยเห็น" แล้ว
    # seed ไว้ตั้งแต่ก่อนเข้าลูป · พอ container ใหม่เริ่ม มันตัด .incomplete ของรอบก่อน
    # ทิ้งแล้วโหลดใหม่ ขนาดโฟลเดอร์จึง **ลดลง** จาก 164.6 GB เหลือ 153.9 GB · ทุกตัวอย่าง
    # หลังจากนั้นถูกเทียบกับ 164.6 GB ที่ไม่มีวันถึงภายใน 600 วิ → watchdog ฆ่า download
    # ที่กำลังทำงานดี ๆ ทุก 10 นาที → ตัดไฟล์ทิ้งอีก → วนไม่รู้จบ (เห็นจริง 3 รอบติด
    # 154→163 GB แล้วกลับมา 154 GB)
    #
    # ขนาดที่ "ลดลง" แปลว่าตัวโหลดกำลังเขียนอยู่ ไม่ใช่ค้าง — นับเป็นความคืบหน้าเหมือนกัน
    # ค้างจริงคือขนาด **ไม่ขยับเลย** ต่างหาก
    if [[ "${now:-0}" != "${last:-0}" ]]; then
      last="$now"; quiet=0
    else
      quiet=$(( quiet + 30 ))
      if (( quiet >= DOWNLOAD_STALL_SECONDS )); then
        log "ไม่มีอะไรคืบหน้ามา ${quiet} วินาที — ถือว่าค้าง หยุดแล้วเริ่มใหม่ต่อจากเดิม"
        docker stop -t 5 "$dl_name" >/dev/null 2>&1 || true
        kill "$logs_pid" 2>/dev/null || true
        docker rm -f "$dl_name" >/dev/null 2>&1 || true
        (( ${DL_ATTEMPT:-1} < ${DOWNLOAD_MAX_ATTEMPTS:-10} )) ||
          die "ค้างซ้ำ ${DL_ATTEMPT:-1} รอบ — ตรวจเน็ต/พร็อกซีแล้วสั่ง download ใหม่"
        # ค้างแล้วเริ่มใหม่ ต้องปิด Xet ไปด้วย ไม่ใช่เริ่มใหม่แบบเดิมเป๊ะ ๆ
        #
        # เคสจริง 2026-09-01 บน spark-head: Xet client ค้างสนิท — ทุกเธรดจอดที่ futex_do_wait,
# socket เปิดค้าง 11 เส้น, container log ว่างเปล่า, 12 นาทีไม่ขยับสักไบต์ · "ค้าง" แบบนี้
# ไม่เคยคืน exit code จึงไม่มีทางไปเข้าทาง fallback ที่ปิด Xet ข้างล่างเลย · เริ่มใหม่ทั้งที
# ยังเปิด Xet เหมือนเดิมก็ค้างซ้ำที่เดิมจนครบโควตา · พอปิด Xet โหลดต่อได้ทันทีที่ 34 MB/s
        DL_ATTEMPT=$(( ${DL_ATTEMPT:-1} + 1 )) HF_HUB_DISABLE_XET=1 download
        return
      fi
    fi
  done
  kill "$logs_pid" 2>/dev/null || true
  local code; code="$(docker wait "$dl_name" 2>/dev/null || echo 1)"
  if [[ "${code:-1}" != "0" ]]; then
    # อ่าน log ก่อน rm — หลังจากนั้นสาเหตุหายไปกับคอนเทนเนอร์
    local kind; kind="$(_explain_download_failure "$dl_name")"
    docker rm -f "$dl_name" >/dev/null 2>&1 || true
    case "$kind" in
      # ปิด Xet แล้วลองใหม่ไม่ช่วยกับพวกนี้ — เสียเวลาอีกรอบเปล่า ๆ แล้วได้ข้อความเดิม
      auth|notfound|disk)
        die "download ล้มเหลว — แก้ตามข้างบนแล้วสั่งซ้ำได้ (โหลดต่อจากเดิม): $0 download" ;;
    esac
    [[ -z "${HF_HUB_DISABLE_XET:-}" ]] ||
      die "download ล้มเหลวแม้ปิด Xet แล้ว — แก้ตามข้างบนแล้วสั่งซ้ำได้ (โหลดต่อจากเดิม): $0 download"
    log "download ล้มเหลว — ลองใหม่โดยปิด Xet transfer (ไฟล์ที่โหลดแล้วยังอยู่ โหลดต่อจากเดิม)"
    HF_HUB_DISABLE_XET=1 download
    return
  fi
  docker rm -f "$dl_name" >/dev/null 2>&1 || true
  log "Download complete."
}

# ─────────────────────────── verify-files ───────────────────────────
# container ตายก่อน health — ดึงสาเหตุจริงจาก log มาบอก ไม่ใช่แค่ "ดู logs"
#
# เคสจริง 2026-09-03 บน dgx-spark04: gpu-memory-utilization 0.4 กับ ctx 262144
# engine core โยน ValueError "No available memory for the cache blocks" แต่บรรทัดสุดท้าย
# ของ log คือ RuntimeError "Engine core initialization failed. See root cause above"
# hub เห็นแค่บรรทัดสุดท้าย คนจึงต้อง ssh ไป grep เอง · สาเหตุจริงอยู่สูงกว่านั้นเสมอ
explain_crash() {
  # NCCL/torch.distributed ตายด้วย DistBackendError/ncclSystemError ซึ่งไม่อยู่ในรายการเดิม —
  # stacked ตายแบบนี้บ่อยกว่า OOM เสียอีก (interface ผิด · worker ไม่มา · firewall กั้น MASTER_PORT)
  local errs='ValueError|RuntimeError|OutOfMemoryError|AssertionError|ImportError|ModuleNotFoundError|NotImplementedError|KeyError|TypeError|OSError|DistBackendError|DistNetworkError|DistStoreError|TimeoutError|ncclSystemError|ncclInternalError|ncclInvalidUsage|ncclRemoteError'
  local cause text
  # log มาจากที่ไหนก็ได้: head = docker บนเครื่องนี้ · worker = ผู้เรียกดึงผ่าน ssh มาใส่ CRASH_LOG_TEXT
  # (ฟังก์ชันเดียว ตัวจำแนกเดียว — worker เคยได้แค่ log ดิบ 100 บรรทัดโดยไม่มีคำอธิบาย)
  if [[ -n "${CRASH_LOG_TEXT-}" ]]; then
    text="$CRASH_LOG_TEXT"
  else
    text="$(docker logs --tail 500 "$CONTAINER_NAME" 2>&1 || true)"
  fi
  # `|| true` ท้าย pipeline จำเป็น: grep ที่ไม่เจอบรรทัด Error คืน 1 → ใต้ set -e + pipefail การ assign
  # นี้ทำสคริปต์ตายทันที ก่อนจะถึง die "container หยุดก่อน health" ของผู้เรียก · crash ที่ log ไม่มี
  # exception (โดน OOM-kill, image พัง) จึงถูกรายงานเป็นความว่างเปล่า exit 1 ไม่มีข้อความสักบรรทัด
  cause="$(printf '%s\n' "$text" \
    | grep -E "(${errs}): " \
    | grep -vE 'Engine core initialization failed|See root cause above' \
    | sed -E "s/^.*(${errs}): /\\1: /" \
    | head -1 | cut -c1-300 || true)"
  [[ -n "$cause" ]] || return 0
  echo "สาเหตุจาก log${CRASH_LOG_LABEL:+ (${CRASH_LOG_LABEL})}: ${cause}" >&2
  case "$cause" in
    *"No available memory for the cache blocks"*|*"Not enough memory"*|*OutOfMemoryError*)
      echo "  หน่วยความจำที่กันไว้ให้ engine (GPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-?}) ไม่พอสำหรับ KV cache ที่ context ${MAX_MODEL_LEN:-?}" >&2
      echo "  แก้ถาวร:  lmds set <bundle> --gpu-util 0.85   (หรือลด --context)" >&2
      echo "  ลองทันที: GPU_MEMORY_UTILIZATION=0.85 $0 restart" >&2 ;;
    *e2m1*|*ptxas*|*"cutlass"*"sm_121"*)
      echo "  FP4 kernel นี้ใช้บน sm_121 (GB10) ไม่ได้ — ต้องบังคับ Marlin ทั้ง head และ worker:" >&2
      echo "  lmds set ${SLUG} --engine-env \"VLLM_NVFP4_GEMM_BACKEND=marlin VLLM_TEST_FORCE_FP8_MARLIN=1 VLLM_USE_FLASHINFER_MOE_FP4=0 VLLM_MARLIN_USE_ATOMIC_ADD=1\"" >&2 ;;
    *"only supports fp8 kv-cache"*|*"ds_mla"*)
      echo "  สถาปัตยกรรมนี้ (DeepSeek MLA) บังคับ kv-cache fp8 — KV_CACHE_DTYPE=fp8 $0 restart  (ถาวร: bundle.env KV_CACHE_DTYPE=fp8)" >&2 ;;
    *NCCL*|*nccl*|*"Socket Timeout"*|*"process group"*|*"No route to host"*|*"Connection refused"*|*"Connection reset"*)
      echo "  NCCL/torch.distributed ระหว่าง node ล้ม — เช็คตามลำดับ:" >&2
      echo "    1) worker ยังอยู่ไหม: $0 logs worker 100   (worker ที่ตายทำให้ head ค้าง/ล้มตรงนี้)" >&2
      echo "    2) interface/IP ที่ใช้คุย: $0 network-info — NCCL_SOCKET_IFNAME ต้องเป็นสายที่มี TRANSPORT_IP_* จริงทั้งสองเครื่อง" >&2
      echo "    3) MASTER_PORT=${MASTER_PORT:-25000} + ช่วง ephemeral เปิดถึงกันบนสายนั้น (ufw/iptables)" >&2
      echo "    4) แยกว่าเป็น RoCE ไหม: NCCL_IB_DISABLE=1 $0 restart  (ขึ้นได้แต่ช้า = ปัญหาที่ HCA/GID_INDEX ไม่ใช่สาย)" >&2 ;;
  esac
}

warn_open_endpoint() {
  # bind 0.0.0.0 + ไม่มี key = ใครก็ตามในวง network ยิง API ได้โดยไม่ต้องยืนยันตัวตน
  [[ "$API_HOST" == "0.0.0.0" && -z "$API_KEY" ]] || return 0
  echo "คำเตือน: เปิดให้ทั้งวง network เข้าถึงได้โดยไม่มี API key" >&2
  echo "         ใช้เฉพาะในเครื่อง: $0 restart --bind 127.0.0.1" >&2
  echo "         หรือบังคับ token:  API_KEY=\$(openssl rand -hex 24) $0 restart" >&2
}

verify_files() {
  local snap; snap="$(_snapshot_path "$HF_HOME")"
  [[ -d "$snap" ]] || die "ยังไม่ได้ download (ไม่พบ $snap) — รัน: $0 download
  (controller นี้เป็นของ ${MODEL_ID} @ ${MODEL_REVISION:0:12} — ถ้าเพิ่ง download ผ่านสคริปต์อื่นในโฟลเดอร์เดียวกัน อาจเป็นโมเดลชื่อเดียวกันคนละ repo)"
  [[ -f "${snap}/config.json" ]] || die "ไฟล์จำเป็นหายไป: config.json"
  local broken
  broken="$(find -L "$snap" -type l 2>/dev/null || true)"
  [[ -z "$broken" ]] || die "พบ symlink เสียใน cache: $broken"
  local n
  n="$(find "$snap" -maxdepth 1 -name '*.safetensors' 2>/dev/null | wc -l | tr -d ' ')"
  (( n >= 1 )) || die "ไม่พบ .safetensors shard ใน ${snap}"
  if (( SHARD_COUNT > 0 )) && (( n != SHARD_COUNT )); then
    die "shard ไม่ครบ: คาด ${SHARD_COUNT} พบ ${n} ใน ${snap}"
  fi
{% endraw %}{% if shard_files %}
  # ตรวจทีละไฟล์ + ขนาดตรงกับที่ Hub รายงาน — นับจำนวนอย่างเดียวจับไฟล์ที่โหลดไม่ครบไม่ได้
  # สำคัญกว่าฝั่ง single เพราะ stacked มีขั้น rsync ข้ามเครื่องเพิ่มมาอีกจุดที่ไฟล์ขาดได้
  local i path actual_size
  for i in "${!SHARD_FILES[@]}"; do
    path="${snap}/${SHARD_FILES[$i]}"
    [[ -e "$path" ]] || die "shard หายไป: ${SHARD_FILES[$i]} — รัน: $0 download (resume ต่อได้)"
    if [[ -n "${SHARD_SIZES[$i]}" ]]; then
      actual_size="$(stat -Lc %s "$path" 2>/dev/null || stat -Lf %z "$path")"
      if [[ "$actual_size" != "${SHARD_SIZES[$i]}" ]]; then
        # ใหญ่เกิน กับ เล็กเกิน ต้องแก้คนละทาง — บอกผิดแล้วผู้ใช้ไปวนกับคำสั่งที่ไม่ช่วย
        # (ทางนี้โหลดด้วย snapshot_download ซึ่ง resume ถูกอยู่แล้ว ไฟล์ใหญ่เกินจึงหมายถึง
        #  แคชปนของเก่าคนละ revision มากกว่า — ลบแล้วโหลดใหม่เหมือนกัน)
        if (( actual_size > ${SHARD_SIZES[$i]} )); then
          die "${SHARD_FILES[$i]}: ไฟล์ใหญ่เกินจริง (ได้ ${actual_size} ต้องการ ${SHARD_SIZES[$i]})
ไฟล์เสียหรือเป็นของคนละ revision — โหลดต่อไม่ช่วย
ลบแล้วโหลดใหม่:  rm -f '$path'  แล้วรัน  $0 download"
        fi
        die "${SHARD_FILES[$i]}: ขนาดไม่ตรง (ได้ ${actual_size} ต้องการ ${SHARD_SIZES[$i]} — download ไม่ครบ)
โหลดต่อได้เลย (resume):  $0 download"
      fi
    fi
  done
  echo "shard ครบ {{ '${#SHARD_FILES[@]}' }} ไฟล์ (ขนาดตรงกับ Hub)"
{% endif %}{% raw %}
  echo "verify-files: OK (${n} shards @ ${snap})"
}

# ─────────────────────────── sync-worker ───────────────────────────
# ssh ที่ rsync ใช้ต้องเป็นตัวเดียวกับ ssh_at — เดิม rsync เรียก ssh เปล่า ๆ ซึ่ง (1) ถามรหัสผ่าน/
# host key แล้วค้างเงียบเมื่อรันจาก hub ที่ไม่มี tty (2) ไม่มี ConnectTimeout สายที่ตายรอไปเรื่อย ๆ
_RSYNC_SSH="ssh -o BatchMode=yes -o ConnectTimeout=10"

sync_worker() {
  need rsync
  _check_worker_ssh
  # ส่งของที่ยังไม่ครบไปก็ได้ worker ที่ไม่ครบ — verify ฝั่ง head ก่อนเสมอ ล้มตรงนี้ถูกกว่าไป
  # ล้มที่ verify-worker หลังลาก 150 GB (ข้อความของ verify_files บอกวิธี resume เอง)
  verify_files
  local snap; snap="$(_snapshot_path "$HF_HOME")"
  local model_cache cache_name worker_hf have_bytes need_kb free_kb rc
  model_cache="$(_model_cache_dir "$HF_HOME")"
  cache_name="$(basename "$model_cache")"
  worker_hf="${WORKER_HF_HOME}"
  have_bytes="$(du -sb "$model_cache" 2>/dev/null | cut -f1 || echo 0)"
  local wip rank=0 sip
  for wip in $WORKER_IPS; do
    rank=$(( rank + 1 ))
    # v2: ลากไฟล์ทางสายที่เร็วที่สุดที่ถึง worker rank นี้ได้ (ปกติคือสายตรงเดียวกับที่ NCCL ใช้)
    sip="$(_sync_ip_for_rank "$rank" "$wip")"
    [[ "$sip" == "$wip" ]] || log "worker rank ${rank}: rsync ทาง ${sip} (สายที่เร็วที่สุดที่ถึง)"
    wip="$sip"
    # rsync ต้องมีทั้งสองฝั่ง — ฝั่ง worker ที่ไม่มีจบด้วย "bash: rsync: command not found" exit 127
    # ที่ไม่บอกว่าเป็นเครื่องไหน
    ssh_at "$wip" "command -v rsync >/dev/null" ||
      die "worker ${wip} ไม่มี rsync — บนเครื่องนั้น: sudo apt-get install -y rsync   แล้วสั่งซ้ำ: $0 sync-worker"
    ssh_at "$wip" "mkdir -p '${worker_hf}/hub' '${WORKER_VLLM_CACHE}' '${WORKER_FLASHINFER_CACHE}'" ||
      die "สร้าง dir บน ${wip} ไม่ได้: ${worker_hf} (สิทธิ์เขียนของ ${SSH_USER} บนเครื่องนั้น)"
    # ปลายทางที่คอนเทนเนอร์รอบก่อนเขียนเป็น root → rsync ล้มด้วย Permission denied ทีละไฟล์ (exit 23)
    # ซ่อมด้วยกลไกเดียวกับ start (chown ผ่านคอนเทนเนอร์ ไม่ต้อง sudo บน worker)
    WORKER_IPS="$wip" _ensure_worker_owned_dir "${worker_hf}/hub/${cache_name}"
    # ดิสก์ฝั่ง worker: ส่วนที่ยังไม่มี (ครั้งแรก = ทั้งก้อน) ต้องพอ — เต็มกลางทางคือ rsync exit 11
    # หลังผ่านไปครึ่งชั่วโมง แล้วต้องมาไล่ว่าเครื่องไหนเต็ม
    if (( ${have_bytes:-0} > 0 )); then
      local there_bytes
      there_bytes="$(ssh_at "$wip" "du -sb '${worker_hf}/hub/${cache_name}' 2>/dev/null | cut -f1" 2>/dev/null || echo 0)"
      need_kb=$(( ((have_bytes - ${there_bytes:-0}) * 105 / 100 + 1023) / 1024 ))
      free_kb="$(ssh_at "$wip" "df -Pk '${worker_hf}' 2>/dev/null || df -Pk \"\$HOME\"" 2>/dev/null | awk 'NR == 2 { print $4 }' || echo 0)"
      if (( ${free_kb:-0} > 0 && need_kb > 0 && free_kb < need_kb )); then
        die "ดิสก์บน worker ${wip} (${worker_hf}) เหลือ $(_human_kb "$free_kb") แต่ต้องรับอีก ~$(_human_kb "$need_kb")
  ย้าย cache ฝั่ง worker: WORKER_HF_HOME=/data/hf $0 sync-worker   (start ใช้ค่าเดียวกัน — เขียนลง bundle.env ให้ถาวร)"
      fi
    fi
    log "Syncing model cache → worker ${wip} (~${TOTAL_SIZE_APPROX_GB} GB ครั้งแรก · สั่งซ้ำได้ ต่อจากเดิม)…"
    # .incomplete = เศษของ download รอบที่ค้าง (verify_files ผ่านแล้วแปลว่าไฟล์จริงครบ) ไม่ต้องลากไป
    rc=0
    rsync -aH --info=progress2 --no-owner --no-group --partial --append-verify \
      --exclude='*.lock' --exclude='tmp_*' --exclude='*.incomplete' \
      -e "$_RSYNC_SSH" \
      "${model_cache}/" \
      "${SSH_USER}@${wip}:${worker_hf}/hub/${cache_name}/" || rc=$?
    if (( rc != 0 )); then
      local why="rsync exit ${rc}"
      case "$rc" in
        11) why="ดิสก์ปลายทางเต็ม / เขียนไม่ได้ (rsync exit 11)" ;;
        12|255) why="สาย SSH/rsync ขาดกลางทาง (rsync exit ${rc})" ;;
        23) why="บางไฟล์คัดลอกไม่ได้ — มักเป็นสิทธิ์ของไฟล์ปลายทาง (rsync exit 23)" ;;
        30) why="ปลายทางไม่ตอบ (rsync timeout)" ;;
      esac
      die "sync ไป worker ${wip} ไม่สำเร็จ: ${why}
  สั่งซ้ำได้เลย โหลดต่อจากที่ค้าง: $0 sync-worker
  ดูของบน worker: ssh ${SSH_USER}@${wip} ls -la '${worker_hf}/hub/${cache_name}/blobs'"
    fi
  done
  log "sync-worker: DONE — ตรวจต่อ: $0 verify-worker"
}

# ─────────────────────────── verify-worker ───────────────────────────
verify_worker() {
  local worker_hf="${WORKER_HF_HOME}" slug wip spec=""
  slug="$(_model_slug)"
  _check_worker_ssh
  # ชื่อ+ขนาดจาก Hub ไปตรวจทีละไฟล์บน worker — นับจำนวนอย่างเดียวจับ rsync ที่ขาดกลางไฟล์ไม่ได้
  # (--partial ทิ้งไฟล์ครึ่งเดียวไว้ชื่อเดิม) แล้ว start ไปตายที่ safetensors header บน worker
  # ซึ่งข้อความบอกแค่ "unexpected end of file" ไม่บอกว่าไฟล์ไหน
  if declare -p SHARD_FILES >/dev/null 2>&1; then
    local i
    for i in "${!SHARD_FILES[@]}"; do spec+="${SHARD_FILES[$i]}=${SHARD_SIZES[$i]:-} "; done
  fi
  # สคริปต์ Python เดินทางเป็น base64 ทาง stdin — ห้ามฝังใน string ที่ส่งให้ ssh ตรง ๆ
  #
  # เดิม heredoc ของ Python อยู่ **ใน double quote** ของ argument ที่ส่งให้ ssh_at → bash ฝั่ง head
  # ถอด " ทุกตัวในโค้ดออกก่อนส่ง (os.environ["MODEL_SLUG"] กลายเป็น os.environ[MODEL_SLUG] ·
  # "/cache/hub/models--"+slug กลายเป็น /cache/hub/models--+slug) worker จึงตอบ SyntaxError ทุกครั้ง
  # และ verify-worker ไม่เคยผ่านเลยบนเครื่องจริง — ผู้ใช้เห็นแค่ "verify-worker ล้มเหลว" แล้วโทษ rsync
  # (พบตอน audit 2026-09-04 ด้วยเทสที่รัน python3 จริงผ่าน docker ปลอม)
  local py b64
  py="$(cat <<'PYEOF'
import os, pathlib, sys
slug = os.environ["MODEL_SLUG"]
rev = os.environ["MODEL_REVISION"]
want = int(os.environ.get("SHARD_COUNT", "0"))
roots = [pathlib.Path("/cache/hub/models--"+slug), pathlib.Path("/cache/models--"+slug)]
model_dir = next((p for p in roots if (p/'snapshots').exists()), roots[0])
snap = model_dir/'snapshots'/rev
ref = model_dir/'refs'/rev
if not snap.exists() and ref.exists():
    snap = model_dir/'snapshots'/ref.read_text().strip()
if not snap.exists():
    snaps = sorted((model_dir/'snapshots').glob('*')) if (model_dir/'snapshots').exists() else []
    if snaps: snap = snaps[-1]
if not snap.exists():
    sys.exit('worker snapshot missing: '+str(snap)+'  (run sync-worker)')
shards = sorted(snap.glob('*.safetensors'))
if not shards:
    sys.exit('no shards on worker  (run sync-worker)')
print('worker shards:', len(shards))
if want and len(shards) != want:
    sys.exit('worker shard count %d != expected %d  (run sync-worker to resume)' % (len(shards), want))
bad = []
for item in os.environ.get('SHARD_SPEC', '').split():
    name, _, size = item.partition('=')
    path = snap/name
    if not path.exists():
        bad.append('%s: missing' % name); continue
    if path.is_symlink() and not path.resolve().exists():
        bad.append('%s: broken symlink' % name); continue
    if size and path.stat().st_size != int(size):
        bad.append('%s: size %d != %s' % (name, path.stat().st_size, size))
if bad:
    print('\n'.join(bad))
    sys.exit('worker shards incomplete: %d file(s)  (run sync-worker to resume)' % len(bad))
if not (snap/'config.json').exists():
    sys.exit('worker config.json missing  (run sync-worker)')
print('verify-worker: PASS')
PYEOF
)"
  b64="$(printf '%s\n' "$py" | base64 | tr -d '\n')"
  for wip in $WORKER_IPS; do
  log "Verifying worker (${wip}) shards …"
  ssh_at "$wip" "echo '${b64}' | base64 -d | docker run -i --rm -v '${worker_hf}:/cache' -e HF_HOME=/cache -e SHARD_COUNT='${SHARD_COUNT}' -e MODEL_REVISION='${MODEL_REVISION}' -e MODEL_SLUG='${slug}' -e SHARD_SPEC='${spec}' --entrypoint python3 '$VLLM_IMAGE' -" ||
    die "verify-worker ล้มเหลวที่ worker ${wip} — โหลดต่อ (resume): $0 sync-worker   แล้ว: $0 verify-worker"
  done
  log "verify-worker: PASS"
}

# ─────────────────────────── doctor ───────────────────────────
doctor() {
  _require_non_root
  local image_id; image_id="$(_assert_runtime_images)"
  echo "Image: ${VLLM_IMAGE}"
  echo "ID   : ${image_id}"
  docker run --rm --gpus all --entrypoint python3 "$VLLM_IMAGE" - <<'PYEOF'
import platform
try:
    import torch
    print("torch      :", torch.__version__, "| cuda", torch.version.cuda)
    if torch.cuda.is_available():
        print("gpu        :", torch.cuda.get_device_name(0))
        print("capability :", torch.cuda.get_device_capability(0))
except Exception as e:
    print("torch      : unavailable", repr(e))
try:
    import vllm
    print("vllm       :", getattr(vllm, "__version__", "unknown"))
except Exception as e:
    print("vllm       : unavailable", repr(e))
print("python     :", platform.python_version())
PYEOF
  # v2: สายทุกเส้นของทุก rank ต้องขึ้นและ ping ถึงคู่ปลายสาย — สายเดียวหลุดใน ring = NCCL ค้างเงียบตอน init
  if _multilink; then
    _resolve_ifname >/dev/null 2>&1 || true
    _resolve_hca >/dev/null 2>&1 || true
    local links_out
    links_out="$(_print_links 2>&1)"
    printf '%s\n' "$links_out"
    if grep -qE 'ping=FAIL|link=(down|missing)|ip=no|SSH .* ล้มเหลว' <<< "$links_out"; then
      die "สายบางเส้นไม่พร้อม (ดูบรรทัด ping=FAIL / link=down / ip=no ด้านบน)
  ring 3 เครื่อง: ทุกเครื่องต้องมี route ไปยัง IP อีกฝั่งของคู่ผ่านสายตรง (ดู docs/RUNBOOK-MULTI-NODE.md §8)
  สายที่ negotiate ต่ำหรือหลุด: ip -br link · ethtool <iface> · เสียบสาย/ตั้ง IP แล้ว: $0 doctor"
    fi
    log "links: ทุกสายขึ้นและ ping ถึงคู่ปลายสาย"
  fi
}

# ─────────────────────── serve-args builder ───────────────────────
# $1 (ไม่บังคับ) = --master-addr ของ rank นี้ · ring: worker แต่ละตัวเห็น head คนละ IP (สายตรงของตัวเอง)
# TCPStore ของ rank 0 ฟังทุก interface อยู่แล้ว — ที่ต้องต่างกันคือฝั่งที่ต่อเข้าไป
build_common_args() {
  COMMON_ARGS=(
    serve "$MODEL_ID"
    --revision "$MODEL_REVISION"
    --served-model-name "$SERVED_MODEL_NAME"
    --tensor-parallel-size "$TENSOR_PARALLEL_SIZE"
    --distributed-executor-backend mp
    --nnodes "$NNODES"
    --master-addr "${1:-$TRANSPORT_IP_MASTER}"
    --master-port "$MASTER_PORT"
    --max-model-len "$MAX_MODEL_LEN"
    --max-num-seqs "$MAX_NUM_SEQS"
    --max-num-batched-tokens "$MAX_NUM_BATCHED_TOKENS"
    --gpu-memory-utilization "$GPU_MEMORY_UTILIZATION"
  )
  if [[ -n "$KV_CACHE_DTYPE" && "$KV_CACHE_DTYPE" != "auto" ]]; then
    COMMON_ARGS+=(--kv-cache-dtype "$KV_CACHE_DTYPE")
  fi
  if [[ -n "$MOE_BACKEND" ]]; then
    COMMON_ARGS+=(--moe-backend "$MOE_BACKEND")
  fi
  if [[ -n "$TOOL_CALL_PARSER" ]]; then
    COMMON_ARGS+=(--enable-auto-tool-choice --tool-call-parser "$TOOL_CALL_PARSER")
  fi
  if [[ -n "$REASONING_PARSER" ]]; then
    COMMON_ARGS+=(--reasoning-parser "$REASONING_PARSER")
  fi
  if [[ -n "$CHAT_TEMPLATE" ]]; then
    local tpl; tpl="$(_resolve_chat_template "$CHAT_TEMPLATE")"
    if [[ -n "$tpl" ]]; then
      COMMON_ARGS+=(--chat-template "$tpl")
    fi
  fi
  if [[ -n "$EXTRA_SERVE_ARGS" ]]; then
    local extra_arg
    for extra_arg in $EXTRA_SERVE_ARGS; do COMMON_ARGS+=("$extra_arg"); done
  fi
  if (( ${#EXTRA_SERVE_FLAGS[@]} > 0 )); then
    COMMON_ARGS+=("${EXTRA_SERVE_FLAGS[@]}")
  fi
}

# หา interface จาก IP ที่ตั้งไว้ — ดีกว่าให้คนกรอกชื่อ interface เอง เพราะชื่อบน DGX Spark
# ยาวและต่างกันระหว่างพอร์ต (enp1s0f1np1 vs enP2p1s0f1np1) พิมพ์ผิดแล้ว NCCL เงียบ ๆ ไปใช้เส้นช้า
detect_interface() {
  local target="$1"
  ip -o -4 addr show 2>/dev/null |
    awk -v want="$target" '$4 ~ ("^" want "/") {print $2; exit}'
}

# interface ของ worker อาจชื่อไม่เหมือน head ต่อให้เป็นเครื่องรุ่นเดียวกัน — ถามเครื่องนั้นเอง
detect_worker_interface() {
  ssh_worker "ip -o -4 addr show 2>/dev/null | awk -v want='${TRANSPORT_IP_WORKER}' \
    '\$4 ~ (\"^\" want \"/\") {print \$2; exit}'" 2>/dev/null || true
}

# RoCE HCA ที่คู่กับ NIC หาได้จาก sysfs — ไม่ตั้งแล้ว NCCL ตกไปใช้ TCP
# สาย 200G จะทำงานได้เท่าอีเทอร์เน็ตธรรมดา ซึ่งเป็นเคสที่ไล่ยากมากเพราะ "ก็รันได้"
# รับ comma list ได้ (v2: head มีสองสาย) → คืน comma list ในลำดับเดียวกัน · สายที่หา HCA ไม่เจอถูกข้าม
detect_hca_for_interface() {
  local want="$1" ifn dev out=""
  [[ -n "$want" ]] || return 0
  for ifn in ${want//,/ }; do
    for dev in "$IB_SYSFS_ROOT"/*; do
      [[ -e "$dev/device/net/$ifn" ]] || continue
      out="${out:+$out,}$(basename "$dev")"
      break
    done
  done
  printf '%s' "$out"
  return 0
}

_resolve_hca() {
  [[ -n "$NCCL_IB_HCA" ]] && return 0
  # v2: ทะเบียนรู้ HCA ของ head อยู่แล้ว (ทุกสาย) — ไม่รู้ค่อยเดินจาก sysfs ทีละ interface
  NCCL_IB_HCA="$(_node_hcas 0)"
  [[ -n "$NCCL_IB_HCA" ]] && return 0
  NCCL_IB_HCA="$(detect_hca_for_interface "$NCCL_SOCKET_IFNAME")"
  [[ -n "$NCCL_IB_HCA" ]] && log "พบ RoCE HCA ของ ${NCCL_SOCKET_IFNAME}: ${NCCL_IB_HCA}"
  return 0
}

_resolve_ifname() {
  # ค่าที่ตั้งมาเองชนะเสมอ ไม่มีค่อยหาให้จาก IP
  [[ -n "$NCCL_SOCKET_IFNAME" ]] && return 0
  # v2: head ต้องประกาศ **ทุกสาย** (ring: worker สองตัวอยู่คนละสาย) — detect จาก IP เดียวได้แค่สายแรก
  NCCL_SOCKET_IFNAME="$(_node_ifnames 0)"
  [[ -n "$NCCL_SOCKET_IFNAME" ]] && return 0
  NCCL_SOCKET_IFNAME="$(detect_interface "$TRANSPORT_IP_MASTER")"
  [[ -n "$NCCL_SOCKET_IFNAME" ]] &&
    log "พบ interface ของ ${TRANSPORT_IP_MASTER}: ${NCCL_SOCKET_IFNAME}"
  return 0
}

_nccl_env_pairs() {
  # พิมพ์ทีละบรรทัด KEY=VALUE — ใช้ทั้ง head (docker -e) และ worker (export)
  # arg 2 = HCA ของเครื่องนั้น (worker ส่งของตัวเองมา) · ไม่ส่ง = ของ head
  #
  # เดิม NCCL_IB_HCA ที่ resolve บน head ถูก push ให้ worker ทั้งก้อน — mlx5_N ของ worker
  # ไม่จำเป็นต้องเลขเดียวกับ head ต่อให้เป็นเครื่องรุ่นเดียวกัน (ลำดับ enumerate ต่างกันได้)
  # ชื่อผิด = NCCL หา HCA ไม่เจอแล้วตกไป TCP เงียบ ๆ ทั้งที่ head ใช้ RoCE อยู่
  local ifname="${1:-$NCCL_SOCKET_IFNAME}"
  local hca="${2-$NCCL_IB_HCA}"
  echo "NCCL_IGNORE_CPU_AFFINITY=1"
  echo "NCCL_IB_GID_INDEX=${NCCL_IB_GID_INDEX}"
  # ring: คู่ A-B วิ่งสายหนึ่ง คู่ A-C อีกสาย — ไม่เปิดตัวนี้ NCCL บังคับ NIC เดียวทั้ง communicator
  if [[ -n "${NCCL_CROSS_NIC:-}" ]]; then echo "NCCL_CROSS_NIC=${NCCL_CROSS_NIC}"; fi
  if [[ -n "$ifname" ]]; then
    echo "NCCL_SOCKET_IFNAME=${ifname}"
    echo "GLOO_SOCKET_IFNAME=${ifname}"
    echo "TP_SOCKET_IFNAME=${ifname}"
    # UCX/OMPI เลือกเส้นเองแยกจาก NCCL — ไม่บอกด้วยจะหลุดไปใช้ management NIC
    echo "UCX_NET_DEVICES=${ifname}"
    echo "OMPI_MCA_btl_tcp_if_include=${ifname}"
  else
    echo "WARN: หา interface ของ ${TRANSPORT_IP_MASTER} ไม่เจอ — NCCL อาจเลือกเส้นผิด" >&2
  fi
  if [[ -n "$hca" ]]; then
    echo "NCCL_IB_HCA=${hca}"
    echo "NCCL_IB_DISABLE=0"
  else
    echo "NCCL_IB_DISABLE=1"
    echo "WARN: ไม่พบ RoCE HCA ของ ${ifname:-<ไม่รู้ interface>} — fallback TCP (ช้าลง)" >&2
  fi
}

# ─────────────────────────── start ───────────────────────────
# ถาม IP/user ของคลัสเตอร์ก่อน start — ค่า default ในไฟล์เป็นแค่ตัวอย่าง เครื่องจริงแทบไม่เคยตรง
# (ข้อบังคับของ controller contract v3.0.0 สำหรับ stacked)
# กันเคสรันสคริปต์ head ผิดเครื่อง — เจอตอนเริ่ม ดีกว่าไปตายตอน NCCL init ที่อ่านไม่รู้เรื่อง
check_running_on_master() {
  local ifname
  ifname="$(detect_interface "$TRANSPORT_IP_MASTER")"
  [[ -n "$ifname" ]] || die \
    "เครื่องนี้ไม่มี IP ${TRANSPORT_IP_MASTER} (head) — สคริปต์นี้ต้องรันบนเครื่อง head เท่านั้น
    ถ้าสลับ head/worker ให้แก้ MASTER_IP/WORKER_IP หรือ cluster.env"
  # v2: head ต้องถือ IP ของทุกสายที่ hub บันทึก — สายที่หายไปหนึ่งเส้น = worker rank นั้นต่อ head ไม่ถึง
  local link ip
  for link in $(_rank_var LINKS 0); do
    ip="${link#*:}"; ip="${ip%%/*}"
    [[ -z "$ip" || -n "$(detect_interface "$ip")" ]] || die \
      "เครื่องนี้ไม่มี IP ${ip} บนสาย ${link%%:*} ตาม cluster.env (LINKS_0) — สายหลุด/ยังไม่ตั้ง IP หรือทะเบียนเก่า
    ดู: ip -br addr · แก้ทะเบียนแล้วเขียนใหม่: lmds node cluster --write ${SLUG} --head <เครื่อง head>"
  done
}

prompt_cluster_config() {
  [[ -t 0 ]] || return 0
  # ค่ามาจาก hub แล้ว (cluster.env) — ถามซ้ำมีแต่จะให้พิมพ์ผิด
  if [[ -f "$CLUSTER_ENV" ]]; then
    log "ใช้ค่าคลัสเตอร์จาก $CLUSTER_ENV (head ${MASTER_IP} · worker ${WORKER_IP})"
    return 0
  fi
  local ans
  printf '\n== Cluster configuration (กด Enter เพื่อใช้ค่าเดิม) ==\n'
  read -rp "  Head (master) node IP [${MASTER_IP}]: " ans || true; [[ -z "$ans" ]] || MASTER_IP="$ans"
  read -rp "  Worker node IP        [${WORKER_IP}]: " ans || true; [[ -z "$ans" ]] || WORKER_IP="$ans"
  read -rp "  SSH user for nodes    [${SSH_USER}]: " ans || true; [[ -z "$ans" ]] || SSH_USER="$ans"
  if (( NNODES > 2 )); then
    read -rp "  All worker IPs (rank order, space-separated) [${WORKER_IPS}]: " ans || true
    [[ -z "$ans" ]] || WORKER_IPS_EXPLICIT="$ans"
  fi
  # คำตอบต้องไปถึง TRANSPORT_IP_* / WORKER_IPS ด้วย — ดูคำอธิบายที่ _derive_cluster_defaults
  _derive_cluster_defaults
  # กด Enter ยืนยัน = ผู้ใช้บอกว่าค่านี้คือเครื่องจริง (คลัสเตอร์ที่ใช้ 10.100.152.x จริงมีอยู่)
  # ไม่ใช่ค่าตัวอย่างอีกต่อไป — ไม่งั้น _require_cluster_config จะปฏิเสธทั้งที่เพิ่งถามไป
  MASTER_IP_EXPLICIT="$MASTER_IP"; WORKER_IP_EXPLICIT="$WORKER_IP"
  printf '\n'
}

# ─────────────── ซ่อมสิทธิ์ cache dir ───────────────
# docker เคยสร้าง cache เป็น root มาก่อน → รอบถัดไป user เขียนไม่ได้ แล้ว start ล้มแบบไล่ยาก
# ซ่อมด้วย container ตัวเดิม (ไม่ต้องพึ่ง sudo บน host) — เคสจริงจาก reference v8.2 "permission-safe"
_ensure_local_owned_dir() {
  local dir="$1" uid gid
  uid="$(id -u)"; gid="$(id -g)"
  mkdir -p "$(dirname "$dir")" || die "สร้าง parent ของ $dir ไม่ได้"
  if [[ -e "$dir" && ! -w "$dir" ]]; then
    log "ซ่อมสิทธิ์ cache บน head: $dir"
    docker run --rm -v "$dir:/repair" --entrypoint sh "$VLLM_IMAGE" \
      -c "chown -R ${uid}:${gid} /repair" ||
      die "ซ่อม $dir ไม่ได้ — รันเอง: sudo chown -R ${uid}:${gid} '$dir'"
  fi
  mkdir -p "$dir" || die "สร้าง $dir ไม่ได้"
  [[ -w "$dir" ]] || die "เขียน $dir ไม่ได้ — รันเอง: sudo chown -R ${uid}:${gid} '$dir'"
}

_ensure_worker_owned_dir() {
  local dir="$1" ruid rgid wip
  for wip in $WORKER_IPS; do
    ruid="$(ssh_at "$wip" "id -u")" || die "อ่าน UID ของ ${wip} ผ่าน SSH ไม่ได้"
    rgid="$(ssh_at "$wip" "id -g")" || die "อ่าน GID ของ ${wip} ผ่าน SSH ไม่ได้"
    ssh_at "$wip" "mkdir -p '$(dirname "$dir")'" || die "สร้าง parent บน ${wip} ไม่ได้: $dir"
    if ssh_at "$wip" "test -e '$dir'" 2>/dev/null && ! ssh_at "$wip" "test -w '$dir'" 2>/dev/null; then
      log "ซ่อมสิทธิ์ cache บน ${wip}: $dir"
      ssh_at "$wip" "docker run --rm -v '$dir:/repair' --entrypoint sh '$VLLM_IMAGE' -c 'chown -R ${ruid}:${rgid} /repair'" ||
        die "ซ่อม $dir บน ${wip} ไม่ได้ — บนเครื่องนั้นรัน: sudo chown -R ${ruid}:${rgid} '$dir'"
    fi
    ssh_at "$wip" "mkdir -p '$dir' && test -w '$dir'" || die "เขียน $dir บน ${wip} ไม่ได้"
  done
}

# FlashInfer JIT cache ที่ค้างจาก image เก่าทำให้โหลด TVM-FFI module คนละ signature แล้วพังตอน start
# เป็นทางกู้เดียวเมื่อเจออาการนี้ — ไม่มีคำสั่งนี้ผู้ใช้ติดตาย
# โฟลเดอร์เป็นของ user แต่ไฟล์ข้างในเป็นของ root (คอนเทนเนอร์รอบก่อนสร้างไว้) — เช็ก -w
# ที่ตัวโฟลเดอร์จึงผ่าน แล้วไปตายตอน rm ทีละไฟล์ · chown ทั้งต้นไม้ก่อนเสมอ ไม่ใช่เฉพาะตอนเขียนไม่ได้
_force_own_tree_local() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  docker run --rm -v "$dir:/repair" --entrypoint sh "$VLLM_IMAGE" \
    -c "chown -R $(id -u):$(id -g) /repair" >/dev/null 2>&1 || true
}

_force_own_tree_remote() {
  local host="$1" dir="$2" ruid rgid
  ruid="$(ssh_at "$host" "id -u")" || return 0
  rgid="$(ssh_at "$host" "id -g")" || return 0
  ssh_at "$host" "test -d '$dir' && docker run --rm -v '$dir:/repair' --entrypoint sh '$VLLM_IMAGE' \
    -c 'chown -R ${ruid}:${rgid} /repair' >/dev/null 2>&1 || true" || true
}

clear_fi_cache() {
  _require_non_root
  log "หยุด deployment ก่อนล้าง FlashInfer cache …"
  stop
  _ensure_local_owned_dir "$FLASHINFER_CACHE"
  _force_own_tree_local "$FLASHINFER_CACHE"
  log "ล้าง FlashInfer cache บน head: ${FLASHINFER_CACHE}"
  find "$FLASHINFER_CACHE" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + ||
    die "ล้าง cache บน head ไม่สำเร็จ — ไฟล์อาจเป็นของ root: sudo rm -rf '${FLASHINFER_CACHE}'/*"
  _ensure_worker_owned_dir "$WORKER_FLASHINFER_CACHE"
  local wip
  for wip in $WORKER_IPS; do
    _force_own_tree_remote "$wip" "$WORKER_FLASHINFER_CACHE"
    log "ล้าง FlashInfer cache บน ${wip}: ${WORKER_FLASHINFER_CACHE}"
    ssh_at "$wip" "find '${WORKER_FLASHINFER_CACHE}' -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +" ||
      die "ล้าง cache บน ${wip} ไม่สำเร็จ — ไฟล์อาจเป็นของ root"
  done
  log "ล้างครบทั้งสอง node แล้ว"
}

props() { curl -fsS "http://127.0.0.1:${API_PORT}/v1/models" | python3 -m json.tool; }

ensure_image() {
  # ดึง image ให้เห็นความคืบหน้า *ก่อน* จะเอาไปใช้ที่อื่น
  #
  # เดิม image ที่ยังไม่มีถูกดึงเงียบ ๆ ระหว่าง `docker run` ที่ผลถูกเก็บเข้าตัวแปร
  # (`out="$(docker run ... 2>&1)"`) — progress bar ของ docker จึงหายเข้าไปในตัวแปร
  # ผู้ใช้เห็นแค่บรรทัดสุดท้ายค้างอยู่หลายสิบนาที แยกไม่ออกว่ากำลังโหลดหรือค้างไปแล้ว
  # (image พวกนี้ 20-30 GB · เจอจริงกับ avarok/dgx-vllm-nvfp4-kernel)
  local image="$1"
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  echo "ดึง image ${image} (ยังไม่มีในเครื่อง — ขนาดหลาย GB ใช้เวลาสักครู่)…"
  if ! _docker_pull "$image" "head"; then
    _pull_hints "$image" "head"
    die "ดึง image ${image} ไม่สำเร็จ — แก้ตามข้างบนแล้วสั่งซ้ำ (หรือดึงให้ครบทุก node ทีเดียว: $0 prepare-runtime)"
  fi
}

# port ว่างบน head? — container รันด้วย --network host จึงไม่ "publish" port
# ตัวกรอง docker publish= จับไม่เจอเลย ต้องดู listening socket จริง
#
# เทียบทั้ง token ไม่ใช่ substring: ของเดิม *":${API_PORT} "* จับ *:18000 ว่าเป็น :8000 ด้วย
# → port 8000 ว่างจริงแต่ start ถูกปฏิเสธเพราะมีอะไรฟังอยู่ที่ 18000 · ตัวหน้าต้องเป็น : หรือ .
# (ss/netstat พิมพ์ 0.0.0.0:8000 · *:8000 · [::]:8000) ตัวหลังต้องเป็นช่องว่างหรือจบบรรทัด
_head_port_in_use() {
  local listening=""
  if command -v ss >/dev/null 2>&1; then
    listening="$(ss -tln 2>/dev/null || true)"
  elif command -v netstat >/dev/null 2>&1; then
    listening="$(netstat -tln 2>/dev/null || true)"
  fi
  grep -Eq "[:.]${API_PORT}([[:space:]]|$)" <<< "$listening"
}

# image รู้จักสถาปัตยกรรมของโมเดลไหม — ถามก่อนปล่อย worker/HCA/NCCL ทั้งคลัสเตอร์
# เคสจริง 2026-09-05 (Qwen3.8-Flash-Next-NVFP4 stacked บน spark-head+worker): ทำครบทุกขั้น 2.5 ชม. แล้ว head
# ตายตอนอ่าน config "model type qwen4_exp … Transformers does not recognize" — single controller มีด่านนี้
# มาตั้งแต่ต้น แต่ stacked ไม่มี · ถามด้วย image ตัวเดียวกับที่จะ start (VLLM_IMAGE/bundle.env)
check_architecture() {
  local snapshot config model_type verdict
  snapshot="$(_snapshot_path 2>/dev/null || true)"
  config="${snapshot}/config.json"
  [[ -n "$snapshot" && -f "$config" ]] || return 0
  model_type="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('model_type',''))" "$config" 2>/dev/null || true)"
  [[ -n "$model_type" ]] || return 0
  verdict="$(docker run --rm --entrypoint python3 "$VLLM_IMAGE" -c "
import sys
try:
    from transformers.models.auto.configuration_auto import CONFIG_MAPPING_NAMES
    import transformers
except Exception:
    sys.exit(0)
print('KNOWN' if sys.argv[1] in CONFIG_MAPPING_NAMES else 'UNKNOWN', transformers.__version__)
" "$model_type" 2>/dev/null | tail -1 || true)"
  case "$verdict" in
    UNKNOWN*)
      echo "ERROR: image นี้ไม่รู้จักสถาปัตยกรรม '${model_type}' (transformers ${verdict#UNKNOWN }) — ยังไม่ปล่อย worker" >&2
      echo "  โมเดลใหม่กว่ารันไทม์ — ต้องใช้ image ที่ใหม่กว่า (เช่น vllm/vllm-openai:nightly) ทั้ง head และ worker:" >&2
      echo "    lmds set {{ slug }} --image <image>   แล้ว   $0 prepare-runtime   แล้ว   $0 start" >&2
      echo "  เช็คก่อนได้ว่าตัวไหนรู้จัก:  docker run --rm --entrypoint python3 <image> -c \\" >&2
      echo "    \"from transformers.models.auto.configuration_auto import CONFIG_MAPPING_NAMES as m; print('${model_type}' in m)\"" >&2
      exit 1 ;;
    KNOWN*) echo "architecture: ${model_type} — รองรับ (transformers ${verdict#KNOWN })" ;;
  esac
}

start() {
  if [[ -z "$DRY_RUN" ]]; then
    ensure_image "${VLLM_IMAGE}"
    _require_non_root
    need docker; need curl
    check_running_on_master
    # WORKER_IPS = IP ที่ head ใช้ถึง worker แต่ละ rank (v2: HEAD_TO_WORKER_IP_<rank> คนละสายกันได้)
    _check_worker_ssh
  fi
  _resolve_ifname
  _resolve_hca
  local WORKER_IFNAME="$NCCL_SOCKET_IFNAME"
  # ข้อมูลเพื่อ log เท่านั้น (worker แต่ละตัวถูกถามจริงในลูปข้างล่าง) — dry-run/v2 ไม่ต้อง ssh เพิ่ม
  local detected_worker=""
  if [[ -z "$DRY_RUN" ]] && ! _multilink; then detected_worker="$(detect_worker_interface)"; fi
  if [[ -n "$detected_worker" ]]; then
    WORKER_IFNAME="$detected_worker"
    [[ "$WORKER_IFNAME" == "$NCCL_SOCKET_IFNAME" ]] ||
      log "worker ใช้ interface คนละชื่อกับ head: ${WORKER_IFNAME}"
  fi
  local image_id
  if [[ -n "$DRY_RUN" ]]; then
    # ไม่แตะ docker เลย — ใช้ id ที่ prepare-runtime ล็อกไว้ ไม่มีก็ค่าแทน (มีผลแค่ชื่อโฟลเดอร์ cache ที่พิมพ์)
    image_id="$(cat "$IMAGE_LOCK_FILE" 2>/dev/null || true)"; image_id="${image_id:-sha256:dry-run}"
  else
    image_id="$(_assert_runtime_images)"
  fi
  local cache_key="${image_id#sha256:}"; cache_key="${cache_key:0:16}"
  local head_fi="${FLASHINFER_CACHE}/${cache_key}"
  local worker_fi="${WORKER_FLASHINFER_CACHE}/${cache_key}"
  local worker_hf="${WORKER_HF_HOME}" wip

  if [[ -z "$DRY_RUN" ]]; then
    if _head_port_in_use; then
      die "port ${API_PORT} ถูกใช้อยู่บน head — stop ตัวที่ชนก่อน (ดู: ss -tlnp | grep ${API_PORT})"
    fi

    # ลบ container ค้าง
    docker rm -f "$MASTER_CONTAINER" >/dev/null 2>&1 || true
    for wip in $WORKER_IPS; do
      ssh_at "$wip" "docker rm -f '${WORKER_CONTAINER}' >/dev/null 2>&1 || true" || true
    done

    verify_files
    check_architecture
    _ensure_local_owned_dir "$FLASHINFER_CACHE"
    _ensure_local_owned_dir "$head_fi"
    _ensure_local_owned_dir "$VLLM_CACHE"
    for wip in $WORKER_IPS; do
      ssh_at "$wip" "mkdir -p '${worker_hf}' '${WORKER_VLLM_CACHE}'" ||
        die "เตรียม dir บน ${wip} ไม่ได้"
    done
    _ensure_worker_owned_dir "$WORKER_FLASHINFER_CACHE"
    _ensure_worker_owned_dir "$worker_fi"
  else
    echo "== DRY RUN: ${CLUSTER_TOPOLOGY:-single-link} · NNODES=${NNODES} TP=${TENSOR_PARALLEL_SIZE} · head ${TRANSPORT_IP_MASTER} · worker(s) ${WORKER_IPS} =="
    echo "== head NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-<auto>} NCCL_IB_HCA=${NCCL_IB_HCA:-<auto>}${NCCL_CROSS_NIC:+ NCCL_CROSS_NIC=$NCCL_CROSS_NIC} =="
  fi

  build_common_args
  local quoted_common; quoted_common="$(printf ' %q' "${COMMON_ARGS[@]}")"

  # NCCL env สำหรับ docker -e (head) และ export (worker)
  local -a nccl_docker=()
  local line
  while IFS= read -r line; do
    [[ "$line" == WARN:* ]] && continue
    nccl_docker+=(-e "$line")
  done < <(_nccl_env_pairs 2>/dev/null)

  # ── Step 1: worker ทุกตัว (rank 1..N-1, headless) ก่อน ──
  # container ชื่อเดียวกันได้เพราะอยู่คนละเครื่อง · rank เรียงตามลำดับใน WORKER_IPS
  local rank=0 worker_script wifname whca wtip wmaster detected _ifn _h
  for wip in $WORKER_IPS; do
    rank=$(( rank + 1 ))
    # interface/IP ที่ worker ใช้คุย NCCL คือฝั่ง transport (สาย 200G) ไม่ใช่ IP ที่ head ssh ไปหา
    # v2: = HEAD_TO_WORKER_IP_<rank> (สายตรง head↔worker ตัวนี้) · --master-addr = WORKER_HEAD_IP_<rank>
    wtip="$(_worker_transport_ip "$rank" "$wip")"
    wmaster="$(_worker_head_ip "$rank")"
    # v2: ทะเบียนบอกทุก interface ของ worker (ring: สองสาย ไปคนละเครื่อง) — detect จาก IP เดียวได้แค่สายแรก
    wifname="$(_node_ifnames "$rank")"
    detected=""
    if [[ -z "$DRY_RUN" ]]; then
      detected="$(ssh_at "$wip" "ip -o -4 addr show 2>/dev/null | awk -v want='${wtip}' \
        '\$4 ~ (\"^\" want \"/\") {print \$2; exit}'" 2>/dev/null || true)"
    fi
    if [[ -z "$wifname" ]]; then
      wifname="$detected"
    elif [[ -n "$detected" && ",${wifname}," != *",${detected},"* ]]; then
      log "worker ${wip}: IP ${wtip} อยู่บน ${detected} ซึ่งไม่อยู่ในรายการสายของ cluster.env (${wifname}) — ทะเบียนอาจเก่า"
    fi
    [[ -n "$wifname" || -n "$DRY_RUN" ]] || die "worker ${wip} ไม่มี IP ${wtip} บน interface ไหนเลย (ip -br addr บนเครื่องนั้น)
  IP ที่ worker ใช้คุย NCCL ต้องอยู่บนเครื่อง worker จริง — ตั้ง TRANSPORT_IP_WORKER (worker ตัวแรก) หรือ
  TRANSPORT_IPS_WORKER=\"<ip rank1> <ip rank2> …\" ให้ตรงกับสายที่ต่อถึง ${TRANSPORT_IP_MASTER} ของ head · ดู: $0 network-info"
    # HCA ของ worker หาบนเครื่อง worker เอง (sysfs เดียวกับ detect_hca_for_interface ของ head) ทีละ interface
    # ค่าที่ผู้ใช้ตั้ง NCCL_IB_HCA มาเองใช้ทั้งคลัสเตอร์ · ทะเบียน (NCCL_IB_HCAS_<rank>) รองลงมา ·
    # หาไม่เจอ = worker ตัวนั้นใช้ TCP ไม่ยืมชื่อของ head
    whca="$NCCL_IB_HCA_EXPLICIT"
    [[ -n "$whca" ]] || whca="$(_node_hcas "$rank")"
    if [[ -z "$whca" && -n "$wifname" && -z "$DRY_RUN" ]]; then
      for _ifn in ${wifname//,/ }; do
        _h="$(ssh_at "$wip" "for d in /sys/class/infiniband/*; do [ -e \"\$d/device/net/${_ifn}\" ] && basename \"\$d\"; done" 2>/dev/null || true)"
        _h="${_h%%$'\n'*}"
        [[ -n "$_h" ]] && whca="${whca:+$whca,}$_h"
      done
    fi
    [[ -z "$whca" || "$whca" == "$NCCL_IB_HCA" ]] || log "worker ${wip} ใช้ HCA คนละตัวกับ head: ${whca}"
    build_common_args "$wmaster"
    quoted_common="$(printf ' %q' "${COMMON_ARGS[@]}")"
    log "Starting worker rank ${rank} (headless) on ${wip} [${wtip} → head ${wmaster} · ${wifname:-auto}${whca:+ / ${whca}}] …"
    # env ทุกตัวผ่าน %q — ค่าที่มีช่องว่าง/อักขระพิเศษ (เช่น JSON ใน VLLM_* หรือ path) เคยถูก
    # แตกเป็นหลาย token ตอน export ในสคริปต์ของ worker ทั้งที่ head ได้ค่าถูกผ่าน docker -e
    worker_script="$(cat <<WSCRIPT
#!/bin/bash
set -e
export VLLM_HOST_IP=${wtip}
export HF_HOME=/cache
# เลย์เอาต์ hub cache ต้องดูจากดิสก์ของ **worker เอง** ไม่ใช่ของ head
#
# เคสจริง 2026-09-01: _container_hub_cache รันบน head แล้วเอาคำตอบไปแปะใส่สคริปต์ของ
# worker · head โหลดเองด้วย cache_dir=/cache จึงได้เลย์เอาต์แบน (/cache/models--…)
# ส่วน worker ได้ของจาก rsync ที่ลงเป็นเลย์เอาต์มาตรฐาน (/cache/hub/models--…)
# head เลยสั่ง HF_HUB_CACHE=/cache ให้ worker ทั้งที่ของจริงอยู่ใต้ hub/ →
# LocalEntryNotFoundError ทั้งที่น้ำหนักครบ 171 GB อยู่บนเครื่องแล้ว
#
# เช็กตอนรันในคอนเทนเนอร์ของ worker เอง จึงถูกเสมอไม่ว่าเลย์เอาต์ฝั่งไหนจะเป็นแบบใด
if [ -d "/cache/models--$(_model_slug)/snapshots" ] && [ ! -d "/cache/hub/models--$(_model_slug)/snapshots" ]; then
  export HF_HUB_CACHE=/cache
else
  export HF_HUB_CACHE=/cache/hub
fi
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
$(_nccl_env_pairs "$wifname" "$whca" 2>/dev/null | grep -v '^WARN:' | sed 's/^/export /')
$(for pair in "${EXTRA_DOCKER_ENV[@]}"; do printf 'export %q\n' "$pair"; done)
$(for pair in ${ENGINE_ENV}; do printf 'export %q\n' "$pair"; done)
exec vllm${quoted_common} --node-rank ${rank} --host 127.0.0.1 --port 18000 --headless
WSCRIPT
)"
    if [[ -n "$DRY_RUN" ]]; then
      echo "== worker rank ${rank} @ ${wip} — /tmp/lmds-${SLUG}/worker.sh =="
      printf '%s\n' "$worker_script"
    else
      ssh_at "$wip" "mkdir -p /tmp/lmds-${SLUG} && cat > /tmp/lmds-${SLUG}/worker.sh" <<< "$worker_script"
      ssh_at "$wip" "chmod +x /tmp/lmds-${SLUG}/worker.sh"
    fi
    local -a wrun=(
      docker run -d --name "${WORKER_CONTAINER}"
      --gpus all --network host --ipc host
      -v "${worker_hf}:/cache"
      -v "${WORKER_VLLM_CACHE}:/root/.cache/vllm"
      -v "${worker_fi}:/root/.cache/flashinfer"
      -v "/tmp/lmds-${SLUG}:/tmp/lmds-${SLUG}"
    )
    local wpair
    for wpair in ${ENGINE_ENV}; do wrun+=(-e "$wpair"); done
    wrun+=(--entrypoint bash "${VLLM_IMAGE}" "/tmp/lmds-${SLUG}/worker.sh")
    if [[ -n "$DRY_RUN" ]]; then
      echo "== worker rank ${rank} @ ${wip} — ssh ${SSH_USER}@${wip}: =="
      printf '%q ' "${wrun[@]}"; echo
      continue
    fi
    ssh_at "$wip" "$(printf '%q ' "${wrun[@]}")" || die "start worker container บน ${wip} ไม่สำเร็จ"
  done
  # head ใช้ COMMON_ARGS ของตัวเอง (--master-addr = TRANSPORT_IP_MASTER) — ลูปข้างบนเพิ่งประกอบของ worker
  build_common_args
  quoted_common="$(printf ' %q' "${COMMON_ARGS[@]}")"

  if [[ -n "$DRY_RUN" ]]; then
    local -a hdry=(docker run -d --name "$MASTER_CONTAINER" --gpus all --network host --ipc host
      -e "VLLM_HOST_IP=${TRANSPORT_IP_MASTER}")
    while IFS= read -r line; do [[ "$line" == WARN:* ]] || hdry+=(-e "$line"); done < <(_nccl_env_pairs 2>/dev/null)
    for pair in "${EXTRA_DOCKER_ENV[@]}"; do hdry+=(-e "$pair"); done
    for pair in ${ENGINE_ENV}; do hdry+=(-e "$pair"); done
    hdry+=(--entrypoint bash "$VLLM_IMAGE" -lc "exec vllm${quoted_common} --node-rank 0 --host ${API_HOST} --port ${API_PORT}")
    echo "== head rank 0 (local) =="
    printf '%q ' "${hdry[@]}"; echo
    echo "== DRY RUN จบ — ไม่ได้แตะ docker/ssh =="
    return 0
  fi

  log "รอ worker init ${WORKER_INIT_WAIT}s …"
  sleep "$WORKER_INIT_WAIT"
  for wip in $WORKER_IPS; do
    if [[ "$(ssh_at "$wip" "docker inspect -f '{{.State.Running}}' '${WORKER_CONTAINER}' 2>/dev/null" || true)" != "true" ]]; then
      ssh_at "$wip" "docker logs --tail 200 '${WORKER_CONTAINER}' 2>&1" || true
      _explain_worker_crash "$wip"
      die "worker container บน ${wip} หยุดก่อน head จะเริ่ม — ดู log ด้านบน (เพิ่มเติม: $0 logs worker 500)"
    fi
  done

  # ── Step 2: head (rank 0, serving API) ──
  log "Starting head (rank 0, API) locally …"
  local -a hrun=(
    docker run -d --name "$MASTER_CONTAINER"
    --gpus all --network host --ipc host
    -v "${HF_HOME}:/cache"
    -v "${VLLM_CACHE}:/root/.cache/vllm"
    -v "${head_fi}:/root/.cache/flashinfer"
    -e "VLLM_HOST_IP=${TRANSPORT_IP_MASTER}"
    -e HF_HOME=/cache -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1
    -e "HF_HUB_CACHE=$(_container_hub_cache "$HF_HOME")"
  )
  local pair
  for pair in "${EXTRA_DOCKER_ENV[@]}"; do hrun+=(-e "$pair"); done
  for pair in ${ENGINE_ENV}; do hrun+=(-e "$pair"); done
  hrun+=("${nccl_docker[@]}")
  # ค่า key ไม่ไปบน argv ของ docker run (`ps` อ่านได้ทั้งเครื่อง) — export แล้วให้ docker หยิบจาก env
  # (หลักเดียวกับ single-vLLM · รีวิว 2026-09-04)
  if [[ -n "$API_KEY" ]]; then export VLLM_API_KEY="$API_KEY"; hrun+=(-e VLLM_API_KEY); fi
  hrun+=(--entrypoint bash "$VLLM_IMAGE"
    -lc "exec vllm${quoted_common} --node-rank 0 --host $(printf '%q' "$API_HOST") --port $(printf '%q' "$API_PORT")")
  # array ขึ้นต้นด้วย docker อยู่แล้ว — เรียกซ้ำจะได้ `docker docker run -d …`
  "${hrun[@]}"

  write_meta
  # ── Step 3: health poll ──
  log "รอ /health (สูงสุด ${STARTUP_TIMEOUT}s — โหลดโมเดลใหญ่ + warm-up ข้าม node ใช้เวลานาน)…"
  local deadline=$(( $(date +%s) + STARTUP_TIMEOUT ))
  local next_worker_check=$(( $(date +%s) + WORKER_CHECK_INTERVAL ))
  while (( $(date +%s) < deadline )); do
    if curl -fsS "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
      log "Server พร้อม"
      echo "started: $(detect_advertise_ip):${API_PORT} (${SERVED_MODEL_NAME})"
      warn_open_endpoint
      network_info
      return 0
    fi
    if [[ "$(docker inspect -f '{{.State.Running}}' "$MASTER_CONTAINER" 2>/dev/null || true)" != "true" ]]; then
      CONTAINER_NAME="$MASTER_CONTAINER" explain_crash
      die "head container หยุดก่อน health ผ่าน — ดู: $0 logs head 200"
    fi
    # worker ตายระหว่างรอ head — เดิมดู worker แค่หลัง WORKER_INIT_WAIT แล้วเฝ้าแต่ head
    # worker ที่ OOM ตอนโหลดน้ำหนักทำให้ head ค้างรอ NCCL init จนครบ STARTUP_TIMEOUT
    # (ชั่วโมงกว่าสำหรับโมเดลใหญ่) โดยไม่มีอะไรบอกว่าเครื่องไหนตาย
    if (( $(date +%s) >= next_worker_check )); then
      for wip in $WORKER_IPS; do
        if [[ "$(ssh_at "$wip" "docker inspect -f '{{.State.Running}}' '${WORKER_CONTAINER}' 2>/dev/null" || true)" != "true" ]]; then
          ssh_at "$wip" "docker logs --tail 100 '${WORKER_CONTAINER}' 2>&1" || true
          _explain_worker_crash "$wip"
          docker rm -f "$MASTER_CONTAINER" >/dev/null 2>&1 || true
          die "worker container บน ${wip} ตายระหว่างรอ head health — หยุด head แล้ว · log ของ worker อยู่ด้านบน (เพิ่มเติม: $0 logs worker 200)"
        fi
      done
      next_worker_check=$(( $(date +%s) + WORKER_CHECK_INTERVAL ))
    fi
    sleep 10
  done
  die "ไม่ health ภายใน ${STARTUP_TIMEOUT}s — container ยังรันอยู่ ดู: $0 logs head 200"
}

# worker ตายแล้วได้แต่ log ดิบ — ให้ตัวจำแนกเดียวกับ head อ่านให้ (ดึง log ผ่าน ssh มาใส่ CRASH_LOG_TEXT)
_explain_worker_crash() {
  local wip="$1" text
  text="$(ssh_at "$wip" "docker logs --tail 500 '${WORKER_CONTAINER}' 2>&1" 2>/dev/null || true)"
  [[ -n "$text" ]] || return 0
  CRASH_LOG_TEXT="$text" CRASH_LOG_LABEL="worker ${wip}" explain_crash || true
}

# argv จริงที่ vLLM จะได้ — ไม่แตะ docker/ssh · ใช้เทียบว่า bundle.env/bundle.args/สูตร ถึง argv ไหม
# (hub และผู้ใช้ตรวจสอบ stacked ได้เหมือน single ที่มี serve-args มาก่อน)
serve_args() {
  build_common_args
  echo "# head (rank 0)${LINKS_0:+ — VLLM_HOST_IP=${TRANSPORT_IP_MASTER} NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-$(_node_ifnames 0)} NCCL_IB_HCA=${NCCL_IB_HCA:-$(_node_hcas 0)}${NCCL_CROSS_NIC:+ NCCL_CROSS_NIC=$NCCL_CROSS_NIC}}:"
  printf '%s\n' vllm "${COMMON_ARGS[@]}" --node-rank 0 --host "$API_HOST" --port "$API_PORT"
  if _multilink; then
    # v2: worker แต่ละ rank ได้ env และ --master-addr ของตัวเอง (ring: คนละสาย คนละ IP ของ head)
    local r=0 wip
    for wip in $WORKER_IPS; do
      r=$(( r + 1 ))
      build_common_args "$(_worker_head_ip "$r")"
      echo "# worker rank ${r} @ ${wip} — VLLM_HOST_IP=$(_worker_transport_ip "$r" "$wip") NCCL_SOCKET_IFNAME=$(_node_ifnames "$r") NCCL_IB_HCA=${NCCL_IB_HCA_EXPLICIT:-$(_node_hcas "$r")}${NCCL_CROSS_NIC:+ NCCL_CROSS_NIC=$NCCL_CROSS_NIC}:"
      printf '%s\n' vllm "${COMMON_ARGS[@]}" --node-rank "$r" --host 127.0.0.1 --port 18000 --headless
    done
  else
    echo "# worker rank 1..$(worker_count) (headless, ต่างกันแค่ --node-rank N):"
    printf '%s\n' vllm "${COMMON_ARGS[@]}" --node-rank 1 --host 127.0.0.1 --port 18000 --headless
  fi
  if [[ -n "$ENGINE_ENV" || ${#EXTRA_DOCKER_ENV[@]} -gt 0 ]]; then
    echo "# engine env (ทั้ง head และ worker ทุกตัว):"
    local pair
    for pair in "${EXTRA_DOCKER_ENV[@]}"; do printf '%s\n' "$pair"; done
    for pair in ${ENGINE_ENV}; do printf '%s\n' "$pair"; done
  fi
}

write_meta() {
  mkdir -p "$RUN_DIR"
  local script_path
  script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  cat > "${RUN_DIR}/server.meta" <<EOF
slug=${SLUG}
model=${SERVED_MODEL_NAME}
model_id=${MODEL_ID}
engine=vllm
mode=docker
port=${API_PORT}
container=${MASTER_CONTAINER}
pid_file=
controller=${script_path}
started_at=$(date +%Y-%m-%dT%H:%M:%S)
EOF
}

# ─────────────────────────── stop ───────────────────────────
stop() {
  log "Stopping head …"
  docker rm -f "$MASTER_CONTAINER" >/dev/null 2>&1 || true
  # worker มีได้มากกว่าหนึ่ง (dgx-spark-stacked-4) — ข้อความต้องพูดถึงทุกตัว ไม่ใช่แค่ WORKER_IP ตัวแรก
  log "Stopping worker(s) on ${WORKER_IPS} …"
  local wip
  for wip in $WORKER_IPS; do
    ssh_at "$wip" "docker rm -f '${WORKER_CONTAINER}' >/dev/null 2>&1 || true" || true
  done
  # mp backend ทิ้ง shared memory ไว้ — ไม่เก็บกวาด start รอบหน้าจะชนของเก่า
  sudo -n sh -c 'rm -f /dev/shm/psm_* /dev/shm/sem.mp-*' 2>/dev/null || true
  for wip in $WORKER_IPS; do
    ssh_at "$wip" "sudo -n sh -c 'rm -f /dev/shm/psm_* /dev/shm/sem.mp-*' 2>/dev/null || true" || true
  done
  echo "stopped ${MASTER_CONTAINER} + ${WORKER_CONTAINER}"
}

# ─────────────────────────── status ───────────────────────────
status() {
  echo "Model   : ${SERVED_MODEL_NAME} (${MODEL_ID})"
  echo "Topology: stacked TP=${TENSOR_PARALLEL_SIZE} nnodes=${NNODES}  head=${MASTER_IP} worker(s)=${WORKER_IPS}"
  if _cluster_config_is_placeholder; then
    echo "Cluster : ยังไม่ตั้งค่า (IP ข้างบนเป็นตัวอย่าง — ไม่มี ${CLUSTER_ENV}) → lmds node cluster --write ${SLUG} --head <เครื่อง head>"
  fi
  echo "--- Head (local) ---"
  docker ps -a --filter "name=^${MASTER_CONTAINER}$" --format 'table {{.Names}}\t{{.Status}}' 2>/dev/null || true
  echo "--- Worker(s) (${WORKER_IPS}) ---"
  local wip
  for wip in $WORKER_IPS; do
    echo "-- worker ${wip}"
    ssh_at "$wip" "docker ps -a --filter 'name=^${WORKER_CONTAINER}$' --format 'table {{.Names}}\t{{.Status}}'" 2>/dev/null || echo "(SSH ล้มเหลว)"
  done
  if _multilink; then
    echo "--- Links ---"
    _resolve_ifname >/dev/null 2>&1 || true
    _resolve_hca >/dev/null 2>&1 || true
    _print_links
  fi
  echo "--- API ---"
  if curl -fsS "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
    echo "API: healthy"
    local models seen
    models="$(curl -fsS ${API_KEY:+-H "Authorization: Bearer $API_KEY"} \
      "http://127.0.0.1:${API_PORT}/v1/models" 2>/dev/null || true)"
    printf '%s\n' "$models"
    # พอร์ตเดียวกันอาจเป็นของโมเดลอื่นที่รันอยู่ก่อน (เคสจริง spark-head 2026-09-04: status ของ bundle
    # stacked บอก healthy ทั้งที่ container ของมันไม่มีสักตัว — 8000 เป็นของ qwen3-coder-next แบบ single)
    # "healthy" เฉย ๆ จึงหลอกให้คิดว่า stacked ขึ้นแล้ว
    seen="$(printf '%s' "$models" | { command -v python3 >/dev/null 2>&1 && python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)["data"]
except Exception:
    sys.exit(0)
print((data[0].get("id") or "").strip() if data else "")
' || true; })"
    if [[ -n "$seen" && "$seen" != "$SERVED_MODEL_NAME" ]]; then
      echo "⚠ พอร์ต ${API_PORT} ตอบเป็นโมเดล '${seen}' ไม่ใช่ '${SERVED_MODEL_NAME}' — เซิร์ฟเวอร์อื่นยึดพอร์ตอยู่ (bundle นี้ยังไม่ขึ้น)"
      echo "  หยุดตัวนั้นก่อน หรือรันตัวนี้คนละพอร์ต: $0 start --port 8001  (ถาวร: lmds set ${SLUG} --port 8001)"
    fi
  else
    echo "API: not responding (http://127.0.0.1:${API_PORT})"
  fi
}

# ─────────────────────────── logs ───────────────────────────
logs() {
  # รองรับทั้ง `logs <N>` (fleet: head N บรรทัด) และ `logs <head|worker> [N]`
  local target n
  if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    target="head"; n="${1}"
  else
    target="${1:-head}"; n="${2:-200}"
  fi
  case "$target" in
    head|master) docker logs --tail "$n" "$MASTER_CONTAINER" 2>&1 ;;
    worker)      for wip in $WORKER_IPS; do
                   echo "===== worker ${wip} ====="
                   ssh_at "$wip" "docker logs --tail '$n' '${WORKER_CONTAINER}' 2>&1" || true
                 done ;;
    *)           die "logs target ต้องเป็น: head | worker (หรือใส่ตัวเลขจำนวนบรรทัด)" ;;
  esac
}

# ─────────────────────────── network-info ───────────────────────────
network_info() {
  local adv; adv="$(detect_advertise_ip)"
  # หา interface/HCA แบบเดียวกับ start (อ่าน ip + sysfs เท่านั้น) — เดิม network-info พิมพ์
  # "HCA <ยังไม่ตั้ง — จะ fallback TCP>" บนเครื่องจริงที่ start หา rocep1s0f1 เจอ ทำให้คนไปไล่ปัญหา RoCE ที่ไม่มี
  _resolve_ifname >/dev/null 2>&1 || true
  _resolve_hca >/dev/null 2>&1 || true
  echo "Head IP    : ${MASTER_IP}  (transport ${TRANSPORT_IP_MASTER})"
  echo "Worker IP  : ${WORKER_IP}  (transport ${TRANSPORT_IP_WORKER})"
  if (( $(worker_count) > 1 )); then
    local wip r=0
    for wip in $WORKER_IPS; do r=$(( r + 1 )); echo "  rank ${r}   : ${wip}  (transport $(_worker_transport_ip "$r" "$wip"))"; done
  fi
  if _cluster_config_is_placeholder; then
    echo "Cluster    : ยังไม่ตั้งค่า — IP ข้างบนเป็นตัวอย่าง (ไม่มี ${CLUSTER_ENV})"
  fi
  echo "NCCL if    : ${NCCL_SOCKET_IFNAME:-<ยังไม่ตั้ง — แนะนำให้ตั้ง>}"
  echo "NCCL HCA   : ${NCCL_IB_HCA:-<ยังไม่ตั้ง — จะ fallback TCP>}"
  _print_links
  echo "Master port: ${MASTER_PORT}"
  echo "Bind       : ${API_HOST}:${API_PORT}"
  echo "Endpoint   : http://${adv}:${API_PORT}/v1"
  echo "Model      : ${SERVED_MODEL_NAME}"
  echo "Context    : ${MAX_MODEL_LEN}"
  echo "Discover fabric: ip -br link | grep -Ei '200|roce|mlx'"
}

# ─────────────────────────── client-config ───────────────────────────
client_config() {
  local input_budget
  if [[ "$CLIENT_INPUT" == "auto" ]]; then
    input_budget=$(( MAX_MODEL_LEN - CLIENT_OUTPUT - TEMPLATE_OVERHEAD_TOKENS ))
  else
    input_budget="$CLIENT_INPUT"
  fi
  (( input_budget > 0 )) || die "context เล็กเกิน: input budget = ${input_budget}"
  cat <<EOF
{
  "base_url": "http://$(detect_advertise_ip):${API_PORT}/v1",
  "model": "${SERVED_MODEL_NAME}",
  "api_key": "${API_KEY:-not-required}",
  "max_input_tokens": ${input_budget},
  "max_output_tokens": ${CLIENT_OUTPUT},
  "server_context": ${MAX_MODEL_LEN}
}
EOF
}

# ─────────────────────────── test-text ───────────────────────────
test_text() {
  assert_our_server
  # 512 ไม่ใช่ 64: โมเดลสาย reasoning ใช้ budget ไปกับ <think> ก่อน ถ้าให้น้อยจะได้
  # finish_reason "length" โดยยังไม่ทันตอบ ซึ่งดูเหมือนโมเดลพัง
  local response
  response="$(curl -fsS "http://127.0.0.1:${API_PORT}/v1/chat/completions" \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} \
    -H "Content-Type: application/json" \
    -d "{
      \"model\": \"${SERVED_MODEL_NAME}\",
      \"messages\": [{\"role\": \"user\", \"content\": \"ตอบสั้น ๆ: 2+2 เท่ากับเท่าไร\"}],
      \"max_tokens\": 512
    }")" || die "เรียก /v1/chat/completions ไม่สำเร็จ — ดู log: $0 logs 200"

  echo "$response"
  echo ""

  if command -v python3 >/dev/null 2>&1; then
    printf "%s" "$response" | python3 -c '
import json, re, sys
try:
    msg = json.load(sys.stdin)["choices"][0]["message"]
except (ValueError, KeyError, IndexError):
    sys.exit(0)
raw = msg.get("content") or ""
answer = re.sub(r"(?s)^.*?</think>", "", raw).strip()
if answer:
    print("test-text: OK — " + answer[:200])
elif raw.strip() or (msg.get("reasoning_content") or "").strip():
    print("test-text: โมเดลตอบแต่ยังคิดไม่จบใน 512 tokens (reasoning model)")
    print("           ไม่ใช่ความผิดพลาด — เซิร์ฟเวอร์รับงานและตอบกลับได้ปกติ")
else:
    print("test-text: เซิร์ฟเวอร์ตอบกลับแต่ไม่มีข้อความ — ดู log: logs 200")
' || true
  fi
}

# ─────────────────────────── test-reasoning ───────────────────────────
# ติดมาทุก bundle ไม่ใช่เฉพาะที่เปิด reasoning ไว้ตอนสร้าง — ให้สวิตช์เปิดได้แต่ไม่มี
# ทางพิสูจน์ว่าได้ผล คือย้ายจุดบอดไปที่ใหม่เฉย ๆ · parser ผิดตัวไม่ error มันแค่เงียบ
# แล้วปล่อยให้ chain-of-thought ปนอยู่ในคำตอบจนกว่าจะมีคนสังเกตเอง
test_reasoning() {
  assert_our_server
  need curl
  python3 - "$API_PORT" "$SERVED_MODEL_NAME" "${API_KEY:-}" <<'PYEOF'
import json, sys, urllib.request

port, model, key = int(sys.argv[1]), sys.argv[2], sys.argv[3]
headers = {"Content-Type": "application/json"}
if key:
    headers["Authorization"] = "Bearer " + key
payload = json.dumps({
    "model": model,
    "messages": [{"role": "user", "content": "What is 37 multiplied by 43? Show your work."}],
    "max_tokens": 512,
}).encode()
req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions", data=payload, headers=headers)
msg = json.load(urllib.request.urlopen(req, timeout=180))["choices"][0]["message"]
# vLLM ใช้มาแล้วสองชื่อ: `reasoning_content` ในรุ่นเก่า และ `reasoning` ในรุ่นใหม่
# ดูแค่ชื่อเดียวจะรายงานว่า parser ไม่ทำงานทั้งที่ทำงานอยู่ แล้วส่งคนไปแก้ของที่ถูกแล้ว
think = msg.get("reasoning_content") or msg.get("reasoning") or ""
answer = msg.get("content") or ""
if "1591" not in (think + answer):
    print("FAIL: ไม่พบคำตอบ 1591")
    print("  reasoning:", think[:200])
    print("  content  :", answer[:200])
    sys.exit(1)
if not think:
    # แยกสองกรณีให้ชัด ไม่งั้นคนจะไปไล่เปลี่ยน parser ทั้งที่โมเดลไม่ได้คิดออกมาเลย
    leaked = any(m in answer for m in ("</think>", "<think>"))
    if leaked:
        print("WARN: โมเดลพ่น <think> ออกมาใน content — --reasoning-parser ไม่ตรงหรือยังไม่ได้ตั้ง")
    else:
        print("WARN: ตอบถูก แต่ไม่มีทั้ง reasoning_content และร่องรอย <think> ใน content")
        print("  แปลว่าโมเดลไม่ได้แยก chain-of-thought ออกมาในรอบนี้ ซึ่งอาจถูกต้องแล้ว")
        print("  (คำถามง่ายเกินจนไม่ต้องคิด หรือ template ปิด thinking ไว้)")
        print("  ไม่ใช่หลักฐานว่า parser ผิด — ถ้าจะยืนยัน ให้ลองคำถามที่ต้องคิดหลายขั้น")
    sys.exit(0)
print(f"PASS: 1591 ถูกต้อง · reasoning {len(think)} ตัวอักษร · answer {len(answer)} ตัวอักษร")
PYEOF
}

# ─────────────────────────── parsers ───────────────────────────
list_parsers() {
  need docker
  ensure_image "${VLLM_IMAGE}"
  # ถามชื่อจาก engine เอง — ชื่อไฟล์ในซอร์สไม่ตรงกับชื่อที่ลงทะเบียน
  # (เช่นไฟล์ qwen3xml.py แต่ชื่อจริงคือ qwen3_xml) และรายชื่อเปลี่ยนไปตามเวอร์ชัน
  # vLLM 0.28 ย้าย registry จาก vllm.entrypoints.openai.tool_parsers ไป vllm.tool_parsers —
  # ลองที่ใหม่ก่อน ที่เก่าตาม · อ่านจาก module ไม่ได้เลย (ย้ายอีกรอบ/เปลี่ยนชื่อ class) ก็ยัง
  # เหลือ `vllm serve --help` ที่ argparse พิมพ์ choices ให้ — ดีกว่าตอบว่า "อ่านไม่ได้" แล้วให้
  # คนไปเปิด --help เอง ซึ่งเจอจริงกับ image nightly cu130 (0.28)
  docker run --rm --entrypoint python3 "${VLLM_IMAGE}" -c '
import os, re, subprocess, sys

def registry(module, cls_name):
    m = __import__(module, fromlist=["*"])
    c = getattr(m, cls_name)
    found = set()
    for attr in dir(c):                       # เก็บทั้ง registry ปกติและแบบ lazy
        if attr.endswith("parsers"):
            value = getattr(c, attr, None)
            if isinstance(value, dict):
                found |= set(value)
    return sorted(found)

HELP = None

def help_text():
    global HELP
    if HELP is None:
        HELP = ""
        env = dict(os.environ, COLUMNS="200")
        for argv in (["vllm", "serve", "--help"],
                     [sys.executable, "-m", "vllm.entrypoints.cli.main", "serve", "--help"]):
            try:
                proc = subprocess.run(argv, capture_output=True, text=True, timeout=180, env=env)
            except Exception:
                continue
            if proc.stdout.strip():
                HELP = proc.stdout
                break
    return HELP

def from_help(flag):
    # argparse พิมพ์ choices เป็น  --flag {a,b,c}  ติดกับ flag หรือขึ้นบรรทัดถัดไปในย่อหน้าเดียวกัน
    text = help_text()
    m = re.search(re.escape(flag) + r"\s+\{([^}]+)\}", text)
    if not m:
        para = re.search(re.escape(flag) + r"[^\n]*\n((?:[ \t]+[^\n]*\n)*)", text)
        m = re.search(r"\{([^}]+)\}", para.group(0)) if para else None
    if not m:
        return []
    return sorted(x.strip() for x in m.group(1).split(",") if x.strip())

def report(label, flag, candidates):
    for module, cls_name in candidates:
        try:
            names = registry(module, cls_name)
        except Exception:
            continue
        if names:
            print(f"{label}:")
            print("  " + " ".join(names))
            return
    names = from_help(flag)
    if names:
        print(f"{label}:  (จาก vllm serve --help)")
        print("  " + " ".join(names))
        return
    print(f"{label}: อ่านจาก engine ไม่ได้ — ดูจาก --help ของ engine แทน")

report("tool parsers  (--tool-parser)", "--tool-call-parser", [
    ("vllm.tool_parsers", "ToolParserManager"),
    ("vllm.entrypoints.openai.tool_parsers", "ToolParserManager"),
    ("sglang.srt.function_call.function_call_parser", "FunctionCallParser"),
])
report("reasoning parsers  (--reasoning-parser)", "--reasoning-parser", [
    ("vllm.reasoning", "ReasoningParserManager"),
    ("sglang.srt.reasoning_parser", "ReasoningParser"),
])
' 2>/dev/null || die "รันไม่สำเร็จ — image อาจยังไม่ถูกดึงลงมา"
}

# ─────────────────────────── test-tools ───────────────────────────
test_tools() {
  assert_our_server
  need curl
  python3 - "$API_PORT" "$SERVED_MODEL_NAME" "${1:-both}" "$0" "${API_KEY:-}" <<'PYEOF'
import json, re, sys, urllib.request

port, model, mode, prog, key = int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
headers = {"Content-Type": "application/json"}
if key:
    headers["Authorization"] = "Bearer " + key

# auto คือโหมดที่ Claude Code / Hermes / OpenClaw / agent ทุกตัวส่งมาจริง — โมเดล
# เขียนตามรูปแบบของมันเอง แล้ว parser ต้องแปลให้ได้
# required สั่งให้ engine บังคับรูปแบบด้วย guided decoding จึงผ่านได้แม้ parser ผิด
# ทดสอบแค่ required แล้วรายงานว่าใช้ได้ = วัดเส้นทางที่ไม่มีใครเดิน
TOOLS = [{"type": "function", "function": {
    "name": "get_weather", "description": "Get current weather for a location",
    "parameters": {"type": "object",
                   "properties": {"location": {"type": "string"}},
                   "required": ["location"]}}}]

# รูปแบบดิบที่โมเดลเขียน → parser ที่แปลมันออก · เดาให้ ไม่ต้องไล่ลองทีละตัว
SHAPES = [
    (r"<function=|<parameter=",       "qwen3_coder"),
    (r"<tool_call>\s*\{",             "qwen3_xml (Qwen3.5+) หรือ hermes (Qwen รุ่นเก่า)"),
    (r"<\|tool.call",                 "deepseek_v3 / deepseek_v31"),
    (r"<\|python_tag\|>",             "llama3_json"),
    (r'"name"\s*:\s*"get_weather"',   "llama3_json (หรือ mistral)"),
    (r"^\s*\[?\s*get_weather\s*\(",   "pythonic (หรือ llama4_pythonic)"),
]


def ask(choice_mode):
    payload = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": "What is the weather in Bangkok?"}],
        "tools": TOOLS, "tool_choice": choice_mode, "max_tokens": 512,
    }).encode()
    req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions", data=payload, headers=headers)
    msg = json.load(urllib.request.urlopen(req, timeout=180))["choices"][0]["message"]
    return msg.get("tool_calls") or [], (msg.get("content") or "")


def guess(text):
    for pattern, name in SHAPES:
        if re.search(pattern, text, re.M):
            return name
    return ""


def one_line(calls):
    fn = calls[0]["function"]
    return f"{fn['name']}({fn['arguments'][:80]})"


modes = ["auto", "required"] if mode == "both" else [mode]
seen = {}
for m in modes:
    calls, text = ask(m)
    seen[m] = (calls, text)
    print(f"  {m:9s} → {one_line(calls) if calls else 'ไม่มี tool_calls'}")

print()
auto_calls, auto_text = seen.get("auto", (None, ""))
req_calls = seen.get("required", (None, ""))[0]

if auto_calls:
    print("PASS: โมเดลเรียก tool ได้เองในโหมด auto — ใช้กับ agent ได้จริง")
    sys.exit(0)

if auto_calls is None:                      # ผู้ใช้ขอ required อย่างเดียว
    if req_calls:
        print("PASS(required): ผ่านเฉพาะโหมดบังคับ")
        print(f"  ยังไม่ได้พิสูจน์ว่า agent ใช้ได้ · รัน: {prog} test-tools auto")
        sys.exit(0)
    print("FAIL(required): ไม่มี tool_calls แม้จะบังคับ — parser ไม่ตรงกับโมเดล")
    sys.exit(1)

# auto ไม่ผ่าน = agent ใช้ไม่ได้ ไม่ว่า required จะผ่านหรือไม่
print("FAIL(auto): ไม่มี tool_calls — Claude Code และ agent อื่นจะเห็นเป็นข้อความเปล่า")
if req_calls:
    print("  โหมด required ผ่าน เพราะ engine บังคับรูปแบบให้เอง")
    print("  แปลว่าโมเดลเรียก tool เป็น แต่ --tool-parser แปลรูปแบบของมันไม่ออก")
elif req_calls is not None:
    print("  โหมด required ก็ไม่ผ่าน — parser ผิด หรือโมเดลนี้เรียก tool ไม่เป็น")
if auto_text.strip():
    print("  สิ่งที่โมเดลเขียนออกมาจริง:")
    print("    " + auto_text.strip()[:200].replace("\n", " "))
hint = guess(auto_text)
if hint:
    print(f"  รูปแบบนี้ตรงกับ parser: {hint}")
    print(f"  ลองใหม่:  {prog} restart --tool-parser <ชื่อข้างบน>")
else:
    print(f"  ดูชื่อ parser ที่ใช้ได้ทั้งหมด:  {prog} parsers")
sys.exit(1)
PYEOF
}

