#!/usr/bin/env bash
# {{ slug }} — vLLM stacked (multi-node) controller
# Model:    {{ plan.model_id }} @ {{ plan.revision }}
# Target:   {{ fit.target_name }} | Generated by LMDS {{ lmds_version }} ({{ plan.generator }})
# Topology: stacked — {{ node_count }} nodes, tensor-parallel {{ tensor_parallel }}, mp backend (worker-first startup)
# Standard: dgx-spark-controllers v3.0.0 controller contract + validated stacked reference (v8.2)
#
# หลักการ (จาก skills_Strack.md):
#   - worker-first: เปิด rank 1 (headless) ก่อน แล้วค่อยเปิด rank 0 (API)
#   - lock runtime image ด้วย image-ID ให้ตรงกันทั้งสอง node ก่อน start
#   - แยก lifecycle: prepare-runtime → download → verify-files → sync-worker → verify-worker → start
#   - ต้องมี fabric ระหว่าง node (200G RoCE/Ethernet) + passwordless SSH master→worker
set -Eeuo pipefail

# ============================ CONFIG (แก้ได้ผ่าน env) ============================
SLUG="{{ slug }}"
SCRIPT_VERSION="${SCRIPT_VERSION:-{{ controller_version }}}"
MODEL_LABEL="${MODEL_LABEL:-{{ model_label }}}"
RUNTIME_LABEL="${RUNTIME_LABEL:-{{ runtime_label }}}"
MODEL_FEATURES="${MODEL_FEATURES:-{{ model_features }}}"
MODEL_ID="{{ plan.model_id }}"
MODEL_REVISION="{{ plan.revision }}"
# ชื่อโมเดลที่ API เสิร์ฟออกไป — ตั้งเองได้ผ่าน env เหมือน knob อื่น ๆ
# ลูกค้าที่ย้ายมาจากระบบเดิมมักต้องใช้ชื่อเดิมเป๊ะ ไม่งั้น client ทุกตัวต้องแก้ตาม
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-{{ plan.served_model_name }}}"
VLLM_IMAGE="${VLLM_IMAGE:-{{ plan.runtime.image_ref }}}"
MASTER_CONTAINER="${MASTER_CONTAINER:-lmds-{{ slug }}-head}"
WORKER_CONTAINER="${WORKER_CONTAINER:-lmds-{{ slug }}-worker}"

# ── Cluster nodes (ต้องแก้ให้ตรงเครื่องจริง) ──
# hub เขียน cluster.env ให้ได้ด้วย `lmds node cluster --write {{ slug }}` — มีก็ใช้เลยไม่ต้องถาม
# env ที่ตั้งมาจากภายนอกยังชนะไฟล์นี้เสมอ (ไฟล์ถูกอ่านก่อน default ทั้งหมดด้านล่าง)
CLUSTER_ENV="${CLUSTER_ENV:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cluster.env}"
if [[ -f "$CLUSTER_ENV" ]]; then
  set -a; . "$CLUSTER_ENV"; set +a
fi

MASTER_IP="${MASTER_IP:-10.100.152.1}"
WORKER_IP="${WORKER_IP:-10.100.152.2}"
SSH_USER="${SSH_USER:-${USER:-$(id -un)}}"
# คลัสเตอร์ที่มากกว่า 2 เครื่อง: ใส่ IP ของ worker ทุกตัวคั่นด้วยช่องว่าง เรียงตาม node-rank
# (rank 1, 2, 3 …) · ค่าเริ่มต้นคือ worker เดียว = พฤติกรรมเดิมทุกประการ
WORKER_IPS="${WORKER_IPS:-{% if node_count > 2 %}{% for i in range(2, node_count + 1) %}10.100.152.{{ i }}{{ " " if not loop.last }}{% endfor %}{% else %}$WORKER_IP{% endif %}}"
# fabric/transport IP สำหรับ NCCL — ถ้าใช้ QSFP แยก interface ให้ override สองตัวนี้
TRANSPORT_IP_MASTER="${TRANSPORT_IP_MASTER:-$MASTER_IP}"
TRANSPORT_IP_WORKER="${TRANSPORT_IP_WORKER:-$WORKER_IP}"
MASTER_PORT="${MASTER_PORT:-25000}"

# ── NCCL / RoCE (ต้องตั้งชื่อ interface จริงบนเครื่อง; ว่าง = fallback TCP ช้าลง) ──
# หา interface: ip -br link | grep -Ei '200|roce|mlx' ; ibdev2netdev 2>/dev/null
NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-}"
NCCL_IB_HCA="${NCCL_IB_HCA:-}"
NCCL_IB_GID_INDEX="${NCCL_IB_GID_INDEX:-3}"

# ── Paths ──
HF_HOME="${HF_HOME:-${HOME}/.cache/huggingface}"
VLLM_CACHE="${VLLM_CACHE:-${HOME}/.cache/vllm}"
FLASHINFER_CACHE="${FLASHINFER_CACHE:-${HOME}/.cache/flashinfer}"
WORKER_HF_HOME="${WORKER_HF_HOME:-$HF_HOME}"
WORKER_VLLM_CACHE="${WORKER_VLLM_CACHE:-$VLLM_CACHE}"
WORKER_FLASHINFER_CACHE="${WORKER_FLASHINFER_CACHE:-$FLASHINFER_CACHE}"
RUN_DIR="${RUN_DIR:-${HOME}/.lmds/run/{{ slug }}}"
# ล็อก image ต่อ bundle ไม่ใช่ต่อเครื่อง — เครื่องเดียวมี stacked ได้หลายตัวและใช้คนละ image
# (เช่น DeepSeek V4 ต้องใช้ build เฉพาะ ไม่ใช่ image เดียวกับ Llama)
IMAGE_LOCK_FILE="${IMAGE_LOCK_FILE:-${HF_HOME}/.lmds-image-id-{{ slug }}}"

# ── Serving ──
API_HOST="${API_HOST:-0.0.0.0}"
API_PORT="${API_PORT:-8000}"
API_KEY="${API_KEY:-}"
ADVERTISE_IP="${ADVERTISE_IP:-}"
ADVERTISE_INTERFACE="${ADVERTISE_INTERFACE:-}"
ROUTE_PROBE_IP="${ROUTE_PROBE_IP:-1.1.1.1}"

MAX_MODEL_LEN="${MAX_MODEL_LEN:-{{ plan.serving.context }}}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-{{ plan.serving.gpu_memory_utilization }}}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-{{ plan.serving.max_num_seqs }}}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
TENSOR_PARALLEL_SIZE="${TENSOR_PARALLEL_SIZE:-{{ tensor_parallel }}}"
NNODES="${NNODES:-{{ node_count }}}"

# feature flags — ว่าง = ปิด (planner เลือกให้แล้ว; override เองได้)
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-{{ plan.serving.kv_cache_dtype }}}"
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-{{ (plan.tool_calling.parser if plan.tool_calling.enabled else '') or '' }}}"
REASONING_PARSER="${REASONING_PARSER:-{{ (plan.reasoning.parser if plan.reasoning.enabled else '') or '' }}}"
# บาง template ที่มากับโมเดลไม่ได้ออกรูปแบบ tool ที่ vLLM แปลงเป็น tool_calls ได้
# (Llama 3.3 เป็นตัวอย่าง) — สูตรจะระบุตัวที่ใช้ได้มาให้ ตั้ง parser อย่างเดียวไม่พอ
CHAT_TEMPLATE="${CHAT_TEMPLATE:-{{ plan.tool_calling.chat_template_override or '' }}}"
# MoE backend (เช่น marlin) — ว่างโดยดีฟอลต์ ใส่เองเฉพาะโมเดล MoE ที่ต้องระบุ
MOE_BACKEND="${MOE_BACKEND:-}"
# flag เพิ่มจาก planner (ผ่าน allowlist แล้ว)
EXTRA_SERVE_FLAGS=({% for flag in extra_flag_pairs %}{{ flag }} {% endfor %})
# env ที่ runtime ต้องการแต่ไม่ใช่ flag ของ vLLM — บางโมเดลเลือก backend ผิดถ้าไม่ตั้ง
# (เช่น DeepSeek V4 ต้องปิด CUDA-graph memory profiler ไม่งั้นตายตอน determine_available_memory)
EXTRA_DOCKER_ENV=({% for pair in extra_env_pairs %}{{ pair }} {% endfor %})

# ── Client budget ──
CLIENT_OUTPUT="${CLIENT_OUTPUT:-{{ plan.serving.max_output_tokens }}}"
CLIENT_INPUT="${CLIENT_INPUT:-auto}"
TEMPLATE_OVERHEAD_TOKENS="2048"

# ── Model shard verification (0 = ไม่บังคับจำนวน) ──
SHARD_COUNT="${SHARD_COUNT:-{{ shard_count }}}"
{% if shard_files -%}
SHARD_FILES=(
{% for shard in shard_files %}  "{{ shard.filename }}"
{% endfor %})
SHARD_SIZES=(
{% for shard in shard_files %}  "{{ shard.size }}"
{% endfor %})
{% endif -%}
TOTAL_SIZE_APPROX_GB="${TOTAL_SIZE_APPROX_GB:-{{ total_size_gb }}}"

STARTUP_TIMEOUT="${STARTUP_TIMEOUT:-{{ health_timeout }}}"
WORKER_INIT_WAIT="${WORKER_INIT_WAIT:-12}"
# ================================================================================
{% raw %}
# ─────────────────────────── helpers ───────────────────────────
# ชื่อไฟล์เปล่าจากสูตร = ตัวอย่างที่ vLLM แจกมากับ image · เติม path ให้
# path เต็มที่ผู้ใช้ระบุเองต้องไม่ถูกแตะ
_resolve_chat_template() {
  local value="$1"
  [[ -z "$value" || "$value" == */* ]] && { echo "$value"; return; }
  echo "/opt/vllm/vllm-src/examples/${value}"
}

die() { echo "ERROR: $*" >&2; exit 1; }

# พอร์ตเดียวกันรับได้ทีละเซิร์ฟเวอร์ และทุก bundle ตั้งต้นที่พอร์ตเดียวกัน — ถ้าโมเดลอื่น
# ยึดพอร์ตนี้อยู่ ชุดทดสอบจะยิงไปโดนตัวนั้นแล้ว "ผ่าน" ทั้งที่ทดสอบคนละโมเดล
# (เจอจริง: test-text ของ gemma-4-31b ได้คำตอบจาก Qwen3-Coder-30B ที่รันอยู่ก่อน)
assert_our_server() {
  local seen
  seen="$(curl -fsS -m 10 "http://127.0.0.1:${API_PORT}/v1/models" \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} 2>/dev/null \
    | { command -v python3 >/dev/null 2>&1 && python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)["data"]
except Exception:
    sys.exit(0)
print((data[0].get("id") or "").strip() if data else "")
' || cat; })" || return 0
  [ -n "$seen" ] || return 0                       # อ่านไม่ได้ = ไม่ฟันธง ปล่อยผ่าน
  [ "$seen" = "$SERVED_MODEL_NAME" ] && return 0
  die "พอร์ต ${API_PORT} ตอบมาเป็นโมเดล '${seen}' ไม่ใช่ '${SERVED_MODEL_NAME}'
     มีเซิร์ฟเวอร์อื่นยึดพอร์ตนี้อยู่ — ผลทดสอบที่ได้จะเป็นของโมเดลนั้น ไม่ใช่ตัวนี้
     แก้: หยุดตัวที่ชน หรือรันตัวนี้คนละพอร์ต  $0 restart --port 8001"
}
log() { echo "[$(date '+%H:%M:%S')] $*"; }
ssh_at() { local host="$1"; shift; ssh -o BatchMode=yes -o ConnectTimeout=10 "${SSH_USER}@${host}" "$@"; }
# worker ตัวแรก — ใช้กับงานที่อ้างถึง "worker" ตัวเดียวโดยธรรมชาติ
ssh_worker() { ssh_at "$WORKER_IP" "$@"; }
worker_count() { set -- $WORKER_IPS; echo "$#"; }

_require_non_root() {
  if (( EUID == 0 )); then
    die "อย่ารัน controller ด้วย sudo/root — ให้รันเป็น user ปกติที่เป็นเจ้าของ HF cache และตั้ง SSH key ไว้ (sudo เปลี่ยน HOME/SSH_USER ทำให้ image check ชี้ไป root@worker)"
  fi
}

detect_advertise_ip() {
  # คืน 0 เสมอ (พิมพ์ว่างได้ถ้าตรวจไม่เจอ) — กัน set -e ตัดจบเมื่อ bare assignment
  if [[ -n "$ADVERTISE_IP" ]]; then printf '%s' "$ADVERTISE_IP"; return 0; fi
  local found=""
  if [[ -n "$ADVERTISE_INTERFACE" ]]; then
    found="$(ip -4 -o addr show dev "$ADVERTISE_INTERFACE" scope global 2>/dev/null |
      awk 'NR == 1 { split($4, a, "/"); print a[1] }' || true)"
    printf '%s' "$found"; return 0
  fi
  found="$(ip -4 route get "$ROUTE_PROBE_IP" 2>/dev/null |
    awk '{ for (i=1; i<=NF; i++) if ($i=="src") { print $(i+1); exit } }' || true)"
  if [[ -n "$found" ]]; then printf '%s' "$found"; return 0; fi
  found="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  printf '%s' "$found"
  return 0
}

validate_numbers() {
  [[ "$API_PORT" =~ ^[0-9]+$ ]] && (( API_PORT >= 1 && API_PORT <= 65535 )) ||
    die "invalid API_PORT: $API_PORT"
  [[ "$MAX_MODEL_LEN" =~ ^[0-9]+$ ]] && (( MAX_MODEL_LEN > 0 )) ||
    die "invalid context: $MAX_MODEL_LEN"
  # ต่ำเกิน = ไม่เหลือที่ให้ KV cache · สูงเกิน = ชน OOM ตอน warm-up (unified memory ยิ่งไวเพราะ
  # CPU กับ GPU ใช้ pool เดียวกัน) · bash เทียบทศนิยมไม่ได้ จึงใช้ awk
  awk -v v="$GPU_MEMORY_UTILIZATION" 'BEGIN{exit !(v+0 > 0.3 && v+0 <= 0.98)}' ||
    die "invalid --gpu-util: $GPU_MEMORY_UTILIZATION (ต้องอยู่ระหว่าง 0.3 ถึง 0.98)"
  [[ "$CLIENT_OUTPUT" =~ ^[0-9]+$ ]] && (( CLIENT_OUTPUT > 0 )) ||
    die "invalid CLIENT_OUTPUT: $CLIENT_OUTPUT"
}

parse_options() {
  REMAINING_ARGS=()
  while (( $# )); do
    case "$1" in
      --context)         MAX_MODEL_LEN="$2"; shift 2 ;;
      --context=*)       MAX_MODEL_LEN="${1#*=}"; shift ;;
      --gpu-util)       GPU_MEMORY_UTILIZATION="$2"; shift 2 ;;
      --gpu-util=*)   GPU_MEMORY_UTILIZATION="${1#*=}"; shift ;;
      --port)            API_PORT="$2"; shift 2 ;;
      --port=*)          API_PORT="${1#*=}"; shift ;;
      --bind)            API_HOST="$2"; shift 2 ;;
      --bind=*)          API_HOST="${1#*=}"; shift ;;
      --advertise-ip)    ADVERTISE_IP="$2"; shift 2 ;;
      --advertise-ip=*)  ADVERTISE_IP="${1#*=}"; shift ;;
      --interface)       ADVERTISE_INTERFACE="$2"; shift 2 ;;
      --interface=*)     ADVERTISE_INTERFACE="${1#*=}"; shift ;;
      --client-input)    CLIENT_INPUT="$2"; shift 2 ;;
      --client-input=*)  CLIENT_INPUT="${1#*=}"; shift ;;
      --client-output)   CLIENT_OUTPUT="$2"; shift 2 ;;
      --client-output=*) CLIENT_OUTPUT="${1#*=}"; shift ;;
      *) REMAINING_ARGS+=("$1"); shift ;;
    esac
  done
  validate_numbers
}

# ─────────────────── snapshot path resolution ───────────────────
_model_slug() { printf '%s' "${MODEL_ID//\//--}"; }

_model_cache_dir() {
  local hf_root="${1:-$HF_HOME}" slug candidate
  slug="$(_model_slug)"
  for candidate in "${hf_root}/hub/models--${slug}" "${hf_root}/models--${slug}"; do
    if [[ -d "${candidate}/snapshots" ]]; then printf '%s' "$candidate"; return 0; fi
  done
  printf '%s/hub/models--%s' "$hf_root" "$slug"
}

# path ฝั่งคอนเทนเนอร์ที่ HF ควรใช้เป็น hub cache (mount $HF_HOME ไว้ที่ /cache)
_container_hub_cache() {
  local hf_root="${1:-$HF_HOME}" slug
  slug="$(_model_slug)"
  if [[ -d "${hf_root}/models--${slug}/snapshots" && ! -d "${hf_root}/hub/models--${slug}/snapshots" ]]; then
    printf '/cache'      # เลย์เอาต์เก่า: โมเดลอยู่ที่รากของ HF_HOME
  else
    printf '/cache/hub'
  fi
}

_snapshot_path() {
  local hf_root="${1:-$HF_HOME}" model_dir ref_file commit snap
  model_dir="$(_model_cache_dir "$hf_root")"
  if [[ -d "${model_dir}/snapshots/${MODEL_REVISION}" ]]; then
    printf '%s' "${model_dir}/snapshots/${MODEL_REVISION}"; return 0
  fi
  ref_file="${model_dir}/refs/${MODEL_REVISION}"
  if [[ -f "$ref_file" ]]; then
    commit="$(tr -d '[:space:]' < "$ref_file")"
    if [[ -n "$commit" && -d "${model_dir}/snapshots/${commit}" ]]; then
      printf '%s' "${model_dir}/snapshots/${commit}"; return 0
    fi
  fi
  snap="$(find "${model_dir}/snapshots" -mindepth 1 -maxdepth 1 -type d -print -quit 2>/dev/null || true)"
  if [[ -n "$snap" ]]; then printf '%s' "$snap"; return 0; fi
  printf '%s' "${model_dir}/snapshots/${MODEL_REVISION}"
}

# ─────────────────────── runtime image lock ───────────────────────
_current_image_id() { docker inspect "$VLLM_IMAGE" --format '{{.Id}}' 2>/dev/null || true; }

prepare_runtime() {
  _require_non_root
  need docker
  mkdir -p "$HF_HOME"
  log "Pulling runtime image on head node …"
  docker pull "$VLLM_IMAGE"
  local head_id worker_id
  head_id="$(_current_image_id)"
  [[ -n "$head_id" ]] || die "pull head image ไม่สำเร็จ"
  echo "$head_id" > "$IMAGE_LOCK_FILE"
  log "Head image locked: $head_id"

  local wip
  for wip in $WORKER_IPS; do
    log "Pulling runtime image on worker node (${wip}) …"
    ssh_at "$wip" "docker pull '$VLLM_IMAGE'" || die "pull image บน ${wip} ไม่สำเร็จ (เช็ค SSH/docker)"
  done
  for wip in $WORKER_IPS; do
    worker_id="$(ssh_at "$wip" "docker inspect '$VLLM_IMAGE' --format '{{.Id}}'" || true)"
    [[ -n "$worker_id" ]] || die "อ่าน image id ของ ${wip} ไม่ได้"
    [[ "$head_id" == "$worker_id" ]] ||
      die "image ต่างกันระหว่าง head ($head_id) กับ ${wip} ($worker_id) — re-pull ทุก node"
  done
  log "Runtime images ตรงกันทุก node ($(( $(worker_count) + 1 )) เครื่อง). Lock: ${head_id:0:32}…"
}

_assert_runtime_images() {
  local head_id worker_id locked=""
  head_id="$(_current_image_id)"
  [[ -n "$head_id" ]] || die "ไม่พบ runtime image บน head: ${VLLM_IMAGE} — รัน: $0 prepare-runtime"
  worker_id="$(ssh_worker "docker inspect '$VLLM_IMAGE' --format '{{.Id}}'" 2>/dev/null || true)"
  [[ -n "$worker_id" ]] || die "ไม่พบ runtime image บน worker — รัน: $0 prepare-runtime"
  [[ "$head_id" == "$worker_id" ]] || die "image mismatch head=${head_id} worker=${worker_id} — prepare-runtime ใหม่"
  [[ -f "$IMAGE_LOCK_FILE" ]] && locked="$(cat "$IMAGE_LOCK_FILE")"
  [[ -z "$locked" || "$locked" == "$head_id" ]] ||
    die "image ปัจจุบันต่างจากที่ lock ไว้ — รัน prepare-runtime ใหม่ก่อน start"
  printf '%s' "$head_id"
}

need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

runtime_info() {
  echo "Image     : $VLLM_IMAGE"
  echo "Backend   : mp (vLLM multiprocessing, TP=${TENSOR_PARALLEL_SIZE}, nnodes=${NNODES})"
  local locked="not yet locked (run prepare-runtime)"
  [[ -f "$IMAGE_LOCK_FILE" ]] && locked="$(cat "$IMAGE_LOCK_FILE")"
  echo "Locked ID : ${locked}"
  docker inspect "$VLLM_IMAGE" --format 'Current ID : {{.Id}}' 2>/dev/null || true
}

# ───────────────────────────── download ─────────────────────────────
download() {
  need docker
{% endraw %}{% if report.gated %}  # gated repo: ไม่มี token = ดาวน์โหลดล้มด้วย 401 ที่อ่านยาก — ตรวจตั้งแต่ต้นดีกว่า
  if [[ -z "${HF_TOKEN:-}" ]]; then
    die "${MODEL_ID} เป็น gated repo — ต้องมี HF_TOKEN ก่อน download
  1) ขอสิทธิ์ที่ https://huggingface.co/${MODEL_ID} (ต้องขึ้น ACCEPTED)
  2) สร้าง token ที่ https://huggingface.co/settings/tokens
  3) export HF_TOKEN=hf_xxx   แล้วรันใหม่: $0 download
หมายเหตุ: token ไม่ได้ถูกเก็บไว้ในสคริปต์นี้โดยเจตนา (กัน secret หลุดไปกับ bundle)"
  fi
{% endif %}{% raw %}  mkdir -p "$HF_HOME"
  log "Downloading ${MODEL_ID} @ ${MODEL_REVISION} (resume-safe) …"
  # PYTHONUNBUFFERED / -u: ในคอนเทนเนอร์ไม่มี tty แถบ progress ของ huggingface_hub
  # เลื่อนตัวเลขด้วย \r ล้วน ๆ ไม่เคยขึ้นบรรทัดใหม่ — stderr ที่ line-buffer ไว้จึงไม่ flush
  # ให้เลย · download หลายสิบ GB เงียบสนิทจนจบ คนดูแยกไม่ออกว่าโหลดอยู่หรือค้างไปแล้ว
  local dl_args=(
    run --rm -i --network host
    --user "$(id -u):$(id -g)"
    -e HOME=/tmp -e HF_HOME=/cache -e PYTHONUNBUFFERED=1
    -e "MODEL_ID=${MODEL_ID}" -e "MODEL_REVISION=${MODEL_REVISION}"
    -v "${HF_HOME}:/cache"
  )
  [[ -n "${HF_TOKEN:-}" ]] && dl_args+=(-e "HF_TOKEN=${HF_TOKEN}")
  # Xet เป็น backend ใหม่ของ Hub ที่บาง repo (เช่นตระกูล Llama) ยังพังด้วย
  # "Unable to parse string as hex hash value" — ลองซ้ำโดยปิด Xet ให้อัตโนมัติ
  [[ -n "${HF_HUB_DISABLE_XET:-}" ]] && dl_args+=(-e "HF_HUB_DISABLE_XET=1")
  dl_args+=(--entrypoint python3 "$VLLM_IMAGE" -u -)

  if ! docker "${dl_args[@]}" <<'PYEOF'
import os
from huggingface_hub import snapshot_download
path = snapshot_download(
    repo_id=os.environ["MODEL_ID"],
    revision=os.environ["MODEL_REVISION"],
    cache_dir="/cache",
)
print("download complete:", path, flush=True)
PYEOF
  then
    [[ -z "${HF_HUB_DISABLE_XET:-}" ]] || die "download ล้มเหลวแม้ปิด Xet แล้ว — ดูข้อความด้านบน"
    log "download ล้มเหลว — ลองใหม่โดยปิด Xet transfer (ไฟล์ที่โหลดแล้วยังอยู่ โหลดต่อจากเดิม)"
    HF_HUB_DISABLE_XET=1 download
    return
  fi
  log "Download complete."
}

# ─────────────────────────── verify-files ───────────────────────────
warn_open_endpoint() {
  # bind 0.0.0.0 + ไม่มี key = ใครก็ตามในวง network ยิง API ได้โดยไม่ต้องยืนยันตัวตน
  [[ "$API_HOST" == "0.0.0.0" && -z "$API_KEY" ]] || return 0
  echo "คำเตือน: เปิดให้ทั้งวง network เข้าถึงได้โดยไม่มี API key" >&2
  echo "         ใช้เฉพาะในเครื่อง: $0 restart --bind 127.0.0.1" >&2
  echo "         หรือบังคับ token:  API_KEY=\$(openssl rand -hex 24) $0 restart" >&2
}

verify_files() {
  local snap; snap="$(_snapshot_path "$HF_HOME")"
  [[ -d "$snap" ]] || die "ยังไม่ได้ download (ไม่พบ $snap) — รัน: $0 download"
  [[ -f "${snap}/config.json" ]] || die "ไฟล์จำเป็นหายไป: config.json"
  local broken
  broken="$(find -L "$snap" -type l 2>/dev/null || true)"
  [[ -z "$broken" ]] || die "พบ symlink เสียใน cache: $broken"
  local n
  n="$(find "$snap" -maxdepth 1 -name '*.safetensors' 2>/dev/null | wc -l | tr -d ' ')"
  (( n >= 1 )) || die "ไม่พบ .safetensors shard ใน ${snap}"
  if (( SHARD_COUNT > 0 )) && (( n != SHARD_COUNT )); then
    die "shard ไม่ครบ: คาด ${SHARD_COUNT} พบ ${n} ใน ${snap}"
  fi
{% endraw %}{% if shard_files %}
  # ตรวจทีละไฟล์ + ขนาดตรงกับที่ Hub รายงาน — นับจำนวนอย่างเดียวจับไฟล์ที่โหลดไม่ครบไม่ได้
  # สำคัญกว่าฝั่ง single เพราะ stacked มีขั้น rsync ข้ามเครื่องเพิ่มมาอีกจุดที่ไฟล์ขาดได้
  local i path actual_size
  for i in "${!SHARD_FILES[@]}"; do
    path="${snap}/${SHARD_FILES[$i]}"
    [[ -e "$path" ]] || die "shard หายไป: ${SHARD_FILES[$i]} — รัน: $0 download (resume ต่อได้)"
    if [[ -n "${SHARD_SIZES[$i]}" ]]; then
      actual_size="$(stat -Lc %s "$path" 2>/dev/null || stat -Lf %z "$path")"
      [[ "$actual_size" == "${SHARD_SIZES[$i]}" ]] ||
        die "${SHARD_FILES[$i]}: ขนาดไม่ตรง (ได้ ${actual_size} ต้องการ ${SHARD_SIZES[$i]} — download ไม่ครบ?)"
    fi
  done
  echo "shard ครบ {{ '${#SHARD_FILES[@]}' }} ไฟล์ (ขนาดตรงกับ Hub)"
{% endif %}{% raw %}
  echo "verify-files: OK (${n} shards @ ${snap})"
}

# ─────────────────────────── sync-worker ───────────────────────────
sync_worker() {
  need rsync
  local snap; snap="$(_snapshot_path "$HF_HOME")"
  [[ -d "$snap" ]] || die "ยังไม่มี snapshot ในเครื่อง — รัน download ก่อน"
  local model_cache cache_name worker_hf
  model_cache="$(_model_cache_dir "$HF_HOME")"
  cache_name="$(basename "$model_cache")"
  worker_hf="${WORKER_HF_HOME}"
  local wip
  for wip in $WORKER_IPS; do
    log "Syncing model cache → worker ${wip} (~${TOTAL_SIZE_APPROX_GB} GB ครั้งแรก)…"
    ssh_at "$wip" "mkdir -p '${worker_hf}/hub' '${WORKER_VLLM_CACHE}' '${WORKER_FLASHINFER_CACHE}'" ||
      die "สร้าง dir บน ${wip} ไม่ได้ (เช็ค SSH)"
    rsync -aH --info=progress2 --no-owner --no-group --partial --append-verify \
      --exclude='*.lock' --exclude='tmp_*' \
      "${model_cache}/" \
      "${SSH_USER}@${wip}:${worker_hf}/hub/${cache_name}/"
  done
  log "sync-worker: DONE"
}

# ─────────────────────────── verify-worker ───────────────────────────
verify_worker() {
  local worker_hf="${WORKER_HF_HOME}" slug wip
  slug="$(_model_slug)"
  for wip in $WORKER_IPS; do
  log "Verifying worker (${wip}) shards …"
  ssh_at "$wip" "docker run --rm -v '${worker_hf}:/cache' -e HF_HOME=/cache -e SHARD_COUNT='${SHARD_COUNT}' -e MODEL_REVISION='${MODEL_REVISION}' -e MODEL_SLUG='${slug}' --entrypoint python3 '$VLLM_IMAGE' - <<'PYEOF'
import os, pathlib, sys
slug = os.environ["MODEL_SLUG"]
rev = os.environ["MODEL_REVISION"]
want = int(os.environ.get("SHARD_COUNT", "0"))
roots = [pathlib.Path("/cache/hub/models--"+slug), pathlib.Path("/cache/models--"+slug)]
model_dir = next((p for p in roots if (p/'snapshots').exists()), roots[0])
snap = model_dir/'snapshots'/rev
ref = model_dir/'refs'/rev
if not snap.exists() and ref.exists():
    snap = model_dir/'snapshots'/ref.read_text().strip()
if not snap.exists():
    snaps = sorted((model_dir/'snapshots').glob('*')) if (model_dir/'snapshots').exists() else []
    if snaps: snap = snaps[-1]
if not snap.exists():
    sys.exit('worker snapshot missing: '+str(snap))
shards = sorted(snap.glob('*.safetensors'))
if not shards:
    sys.exit('no shards on worker')
print('worker shards:', len(shards))
if want and len(shards) != want:
    sys.exit('worker shard count %d != expected %d' % (len(shards), want))
print('verify-worker: PASS')
PYEOF
" || die "verify-worker ล้มเหลวที่ ${wip}"
  done
  log "verify-worker: PASS"
}

