  download)     download ;;
  verify-files) verify_files ;;
{% if runtime_assets -%}
  prepare-runtime) prepare_runtime ;;
{% endif %}  start)        start ;;
  stop)         stop ;;
  restart)      stop; start ;;
  status)       status ;;
  logs)         shift; logs "$@" ;;
  test-reasoning)  test_reasoning ;;
  test-tools)      test_tools "${2:-both}" ;;
  parsers)         list_parsers ;;
  client-config) client_config ;;
  info|banner) info ;;
  network-info) network_info ;;
  test-text)    test_text ;;
  wait-health)  wait_health ;;
  *)            usage ;;
esac
