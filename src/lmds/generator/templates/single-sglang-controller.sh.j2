#!/usr/bin/env bash
# {{ slug }} — SGLang single-node controller
# Model:    {{ plan.model_id }} @ {{ plan.revision }}
# Target:   {{ fit.target_name }} | Generated by LMDS {{ lmds_version }} ({{ plan.generator }})
# Standard: dgx-spark-controllers v3.0.0 controller contract
set -Eeuo pipefail

# ============================ CONFIG (แก้ได้) ============================
SCRIPT_VERSION="${SCRIPT_VERSION:-{{ controller_version }}}"
# ลายเซ็นของชุด template ที่ render ไฟล์นี้ (sha256 ของ generator/templates/*.j2) — hub เทียบกับของตัวเอง
# เพื่อรู้ว่า controller นี้ "เก่ากว่า lmds" จริง ไม่ใช่แค่เลข version ต่างกัน (0.6.0 ↔ 0.6.1 ที่ template ไม่เปลี่ยน = ไม่ stale)
TEMPLATE_HASH="{{ template_hash }}"
MODEL_LABEL="${MODEL_LABEL:-{{ model_label }}}"
RUNTIME_LABEL="${RUNTIME_LABEL:-{{ runtime_label }}}"
MODEL_FEATURES="${MODEL_FEATURES:-{{ model_features }}}"
MODEL_ID="{{ plan.model_id }}"
MODEL_REVISION="{{ plan.revision }}"
# ชื่อโมเดลที่ API เสิร์ฟออกไป — ตั้งเองได้ผ่าน env เหมือน knob อื่น ๆ
# ลูกค้าที่ย้ายมาจากระบบเดิมมักต้องใช้ชื่อเดิมเป๊ะ ไม่งั้น client ทุกตัวต้องแก้ตาม
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-{{ plan.served_model_name }}}"
# image เปลี่ยนผ่าน env ได้เหมือน knob อื่น ๆ — bundle ที่ image ใช้ไม่ได้ (tag ผิด/ถูกถอน)
# จะได้แก้ได้โดยไม่ต้อง deploy ใหม่ทั้งชุด · stacked ทำแบบนี้อยู่แล้ว single ตกไป
# runtime ของ bundle นี้ — ตรึงที่ digest ไม่ใช่ tag
#
# tag เคลื่อนที่ได้: `:latest` วันนี้กับเดือนหน้าเป็นคนละ image · bundle ที่ทดสอบ
# ผ่านแล้วจึงกลายเป็นคนละ runtime ได้โดยไม่มีอะไรในไฟล์นี้เปลี่ยนเลย ซึ่งเป็นอาการ
# ที่ไล่หาสาเหตุยากที่สุด เพราะ "ไม่ได้แก้อะไรสักหน่อย"
#
# tag ที่ digest นี้มาจาก ณ วันที่ generate: {{ plan.runtime.image_ref }}
# อยากใช้ตัวอื่นก็ override ได้ตามเดิม: SGLANG_IMAGE=<image> ./controller start
# repo ของ image มาจาก renderer (image_repo) เพราะ registry ที่มีพอร์ตตัดที่ ':' ตัวแรกไม่ได้ ·
# fallback เดิมเหลือไว้ให้ render บรรทัดนี้เดี่ยว ๆ ด้วย plan อย่างเดียวได้ (เทส image pin)
SGLANG_IMAGE="${{ '{' }}SGLANG_IMAGE:-{% if plan.runtime.image_pin %}{{ image_repo if image_repo is defined else plan.runtime.image_ref.split(':')[0] }}@{{ plan.runtime.image_pin }}{% else %}{{ plan.runtime.image_ref }}{% endif %}{{ '}' }}"
CONTAINER_NAME="${CONTAINER_NAME:-lmds-{{ slug }}}"

# ── ค่าที่บันทึกไว้กับ bundle นี้ (เขียนโดยหน้าเว็บ / `lmds set`) ──
# อ่านก่อน default ทั้งหมดข้างล่าง และทุกบรรทัดในไฟล์เป็นรูป ${VAR:-value} ลำดับ
# ความสำคัญจึงเป็น: flag บรรทัดคำสั่ง > env จากภายนอก > ไฟล์นี้ > ค่าของ bundle
#
# มีไฟล์นี้เพราะค่าที่ตั้งบนหน้าเว็บเคยอยู่แค่ในเบราว์เซอร์: systemd ตอน autostart
# และปุ่ม test-* เรียก controller เปล่า ๆ ทุกตัวจึงตกไปใช้ default — พอ reboot
# โมเดลทุกตัวบนเครื่องเดียวกันก็ไปชนกันที่ port เดียว
BUNDLE_ENV="${BUNDLE_ENV:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bundle.env}"
if [[ -f "$BUNDLE_ENV" ]]; then
  set -a; . "$BUNDLE_ENV"; set +a
fi

MAX_MODEL_LEN="${MAX_MODEL_LEN:-{{ plan.serving.context }}}"
API_HOST="${API_HOST:-0.0.0.0}"
API_PORT="${API_PORT:-8000}"
API_KEY="${API_KEY:-}"
ENGINE_ENV="${ENGINE_ENV:-}"
# แฟล็กเพิ่มของ engine — อ่านทั้งบรรทัดจาก bundle.args (เขียนโดย `lmds set --extra-args`)
# ไม่เก็บใน bundle.env เพราะรูป ${VAR:-value} ของ bash หยุดที่ `}` ตัวแรก JSON อย่าง
# --speculative-config {"method":"mtp"} จึงถูกตัดกลางคัน (ทดสอบแล้ว 2026-09-03)
# แตกเป็น argv ด้วยช่องว่าง — JSON ต้องเขียนติดกัน หรือใช้รูป --flag=value
# ค่าตั้งต้นของแฟล็กเพิ่ม — publish เขียนค่าที่พิสูจน์แล้วลงตรงนี้ · single quote โดยเจตนา:
# JSON เช่น --speculative-config {"method":"mtp"} มี } ซึ่งจะตัด ${VAR:-...} ขาดกลางคัน
# (SGLang เคยไม่มีช่องนี้เลย — `lmds set --extra-args` บอกว่าบันทึกแล้วแต่ engine ไม่เคยได้รับ)
EXTRA_SERVE_ARGS_DEFAULT=''
BUNDLE_ARGS="${BUNDLE_ARGS:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bundle.args}"
if [[ -z "${EXTRA_SERVE_ARGS:-}" && -f "$BUNDLE_ARGS" ]]; then
  EXTRA_SERVE_ARGS="$(tr '\n' ' ' < "$BUNDLE_ARGS")"
fi
EXTRA_SERVE_ARGS="${EXTRA_SERVE_ARGS:-$EXTRA_SERVE_ARGS_DEFAULT}"
ADVERTISE_IP="${ADVERTISE_IP:-}"
ADVERTISE_INTERFACE="${ADVERTISE_INTERFACE:-}"
ROUTE_PROBE_IP="${ROUTE_PROBE_IP:-1.1.1.1}"

GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-{{ plan.serving.gpu_memory_utilization }}}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-{{ plan.serving.max_num_seqs }}}"
# prompt ยาวถูกซอยเป็นก้อนเท่านี้ก่อนเข้า GPU — ของ SGLang โดยเฉพาะ
CHUNKED_PREFILL_SIZE="${CHUNKED_PREFILL_SIZE:-8192}"
# ชื่อ dtype ตามที่ planner ให้มา (ภาษา vLLM) — แปลเป็นชื่อของ SGLang ตอน start (ดู _sglang_kv_cache_dtype)
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-{{ plan.serving.kv_cache_dtype }}}"
{% if tensor_parallel > 1 -%}
TENSOR_PARALLEL_SIZE="${TENSOR_PARALLEL_SIZE:-{{ tensor_parallel }}}"
{% endif -%}
CLIENT_OUTPUT="${CLIENT_OUTPUT:-{{ plan.serving.max_output_tokens }}}"
CLIENT_INPUT="${CLIENT_INPUT:-auto}"
TEMPLATE_OVERHEAD_TOKENS="2048"

HF_HOME="${HF_HOME:-${HOME}/.cache/huggingface}"
RUN_DIR="${RUN_DIR:-${HOME}/.lmds/run/{{ slug }}}"
{% if runtime_assets -%}
# ไฟล์ runtime ภายนอกที่ผู้ใช้อนุมัติแล้ว — mount เข้า container ที่ /opt/lmds/plugins (read-only)
PLUGIN_DIR="${PLUGIN_DIR:-${HOME}/.lmds/plugins/{{ slug }}}"
PLUGIN_MOUNT="/opt/lmds/plugins"
ASSET_FILES=(
{% for asset in runtime_assets %}  "{{ asset.filename }}"
{% endfor %})
ASSET_URLS=(
{% for asset in runtime_assets %}  "{{ asset.url }}"
{% endfor %})
ASSET_SHAS=(
{% for asset in runtime_assets %}  "{{ asset.sha256 }}"
{% endfor %})
{% endif -%}
# Tool calling is a runtime knob, not a build-time decision. A bundle generated
# before anyone knew the model could do tools can be switched on in place:
#   ./controller restart --tool-parser hermes
# Empty = off, which is what a model with no known parser should stay.
TOOL_CALL_PARSER="${TOOL_CALL_PARSER:-{% if plan.tool_calling.enabled %}{{ plan.tool_calling.parser }}{% endif %}}"
# Same story for reasoning. Without this flag vLLM still runs, but the model's
# chain of thought lands in `content` instead of `reasoning_content`, so every
# consumer has to strip the narration by guesswork. Empty = off.
REASONING_PARSER="${REASONING_PARSER:-{% if plan.reasoning.enabled %}{{ plan.reasoning.parser }}{% endif %}}"
# บาง template ที่มากับโมเดลไม่ได้ออกรูปแบบ tool ที่ vLLM แปลงเป็น tool_calls ได้
# (Llama 3.3 เป็นตัวอย่าง) — สูตรจะระบุตัวที่ใช้ได้มาให้ ตั้ง parser อย่างเดียวไม่พอ
CHAT_TEMPLATE="${CHAT_TEMPLATE:-{{ plan.tool_calling.chat_template_override or "" }}}"
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-{{ health_timeout }}}"
# ========================================================================

# SGLang รับได้ทั้ง path ของไฟล์และชื่อ template ที่มันรู้จักเอง ต่างจาก vLLM ที่ชื่อ
# เปล่า ๆ หมายถึงไฟล์ตัวอย่างในโฟลเดอร์ของ image · ที่นี่ส่งต่อตามที่กรอกมา
_resolve_chat_template() { echo "$1"; }

# planner พูดภาษา vLLM (`fp8`, `nvfp4_ds_mla` ของสูตร DeepSeek-V4) แต่ argparse ของ SGLang รับแค่
# auto | fp8_e5m2 | fp8_e4m3 (build ใหม่มี bf16) — ส่งชื่อ vLLM ไปตรง ๆ = ตายตั้งแต่ parse argument
# ก่อนจะได้โหลดอะไร · fp8 ของ vLLM คือ e4m3 · ชื่อที่ SGLang ไม่มีคู่ (nvfp4_ds_mla) ถอยเป็น auto
# พร้อมบอกดัง ๆ ว่าทิ้งอะไรไป ไม่ใช่เงียบ
_sglang_kv_cache_dtype() {
  case "$1" in
    auto|fp8_e5m2|fp8_e4m3|bf16) printf '%s' "$1" ;;
    fp8) printf 'fp8_e4m3' ;;
    *)
      echo "WARN: kv-cache dtype '$1' เป็นชื่อเฉพาะของ vLLM — SGLang ไม่รู้จัก ใช้ auto แทน (ตั้งเอง: KV_CACHE_DTYPE=fp8_e4m3)" >&2
      printf 'auto' ;;
  esac
}

die() { echo "ERROR: $*" >&2; exit 1; }

# พอร์ตเดียวกันรับได้ทีละเซิร์ฟเวอร์ และทุก bundle ตั้งต้นที่พอร์ตเดียวกัน — ถ้าโมเดลอื่น
# ยึดพอร์ตนี้อยู่ ชุดทดสอบจะยิงไปโดนตัวนั้นแล้ว "ผ่าน" ทั้งที่ทดสอบคนละโมเดล
# (เจอจริง: test-text ของ gemma-4-31b ได้คำตอบจาก Qwen3-Coder-30B ที่รันอยู่ก่อน)
assert_our_server() {
  local seen
  seen="$(curl -fsS -m 10 "http://127.0.0.1:${API_PORT}/v1/models" \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} 2>/dev/null \
    | { command -v python3 >/dev/null 2>&1 && python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)["data"]
except Exception:
    sys.exit(0)
print((data[0].get("id") or "").strip() if data else "")
' || cat; })" || return 0
  [ -n "$seen" ] || return 0                       # อ่านไม่ได้ = ไม่ฟันธง ปล่อยผ่าน
  [ "$seen" = "$SERVED_MODEL_NAME" ] && return 0
  die "พอร์ต ${API_PORT} ตอบมาเป็นโมเดล '${seen}' ไม่ใช่ '${SERVED_MODEL_NAME}'
     มีเซิร์ฟเวอร์อื่นยึดพอร์ตนี้อยู่ — ผลทดสอบที่ได้จะเป็นของโมเดลนั้น ไม่ใช่ตัวนี้
     แก้: หยุดตัวที่ชน หรือรันตัวนี้คนละพอร์ต  $0 restart --port 8001"
}
need() {
  # DRY_RUN ประกอบคำสั่งอย่างเดียว ไม่แตะ docker/nvidia-smi — เครื่องที่ generate bundle
  # (เช่น hub ที่ไม่มี GPU) ต้องดู argv ที่จะรันได้โดยไม่ต้องมีของพวกนั้นติดตั้ง
  [[ -n "${DRY_RUN:-}" ]] && return 0
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

validate_numbers() {
  [[ "$API_PORT" =~ ^[0-9]+$ ]] && (( API_PORT >= 1 && API_PORT <= 65535 )) ||
    die "invalid API_PORT: $API_PORT"
  [[ "$MAX_MODEL_LEN" =~ ^[0-9]+$ ]] && (( MAX_MODEL_LEN > 0 )) ||
    die "invalid context: $MAX_MODEL_LEN"
  # ต่ำเกิน = ไม่เหลือที่ให้ KV cache · สูงเกิน = ชน OOM ตอน warm-up (unified memory ยิ่งไวเพราะ
  # CPU กับ GPU ใช้ pool เดียวกัน) · bash เทียบทศนิยมไม่ได้ จึงใช้ awk
  # 0.3 พอดีต้องผ่าน — fit/sizing ตั้งพื้นไว้ที่ 0.3 ให้โมเดลเล็ก แล้ว `> 0.3` เคยปฏิเสธ
  awk -v v="$GPU_MEMORY_UTILIZATION" 'BEGIN{exit !(v+0 >= 0.3 && v+0 <= 0.98)}' ||
    die "invalid --gpu-util: $GPU_MEMORY_UTILIZATION (ต้องอยู่ระหว่าง 0.3 ถึง 0.98)"
  [[ "$CLIENT_OUTPUT" =~ ^[0-9]+$ ]] && (( CLIENT_OUTPUT > 0 )) ||
    die "invalid CLIENT_OUTPUT: $CLIENT_OUTPUT"
}

detect_advertise_ip() {
  if [[ -n "$ADVERTISE_IP" ]]; then printf '%s' "$ADVERTISE_IP"; return; fi
  if [[ -n "$ADVERTISE_INTERFACE" ]]; then
    ip -4 -o addr show dev "$ADVERTISE_INTERFACE" scope global |
      awk 'NR == 1 { split($4, a, "/"); print a[1] }'
    return
  fi
  local route_src
  route_src="$(ip -4 route get "$ROUTE_PROBE_IP" 2>/dev/null |
    awk '{ for (i=1; i<=NF; i++) if ($i=="src") { print $(i+1); exit } }')"
  if [[ -n "$route_src" ]]; then printf '%s' "$route_src"; return; fi
  hostname -I 2>/dev/null | awk '{print $1}'
}

parse_options() {
  REMAINING_ARGS=()
  while (( $# )); do
    case "$1" in
      --context)        MAX_MODEL_LEN="$2"; shift 2 ;;
      --extra-args)     EXTRA_SERVE_ARGS="$2"; shift 2 ;;
      --extra-args=*)   EXTRA_SERVE_ARGS="${1#*=}"; shift ;;
      --context=*)      MAX_MODEL_LEN="${1#*=}"; shift ;;
      --gpu-util)      GPU_MEMORY_UTILIZATION="$2"; shift 2 ;;
      --gpu-util=*)  GPU_MEMORY_UTILIZATION="${1#*=}"; shift ;;
      --port)           API_PORT="$2"; shift 2 ;;
      --port=*)         API_PORT="${1#*=}"; shift ;;
      --bind)           API_HOST="$2"; shift 2 ;;
      --bind=*)         API_HOST="${1#*=}"; shift ;;
      --advertise-ip)   ADVERTISE_IP="$2"; shift 2 ;;
      --advertise-ip=*) ADVERTISE_IP="${1#*=}"; shift ;;
      --interface)      ADVERTISE_INTERFACE="$2"; shift 2 ;;
      --interface=*)    ADVERTISE_INTERFACE="${1#*=}"; shift ;;
      --client-input)   CLIENT_INPUT="$2"; shift 2 ;;
      --client-input=*) CLIENT_INPUT="${1#*=}"; shift ;;
      --client-output)  CLIENT_OUTPUT="$2"; shift 2 ;;
      --client-output=*) CLIENT_OUTPUT="${1#*=}"; shift ;;
      --tool-parser)    TOOL_CALL_PARSER="$2"; shift 2 ;;
      --tool-parser=*)  TOOL_CALL_PARSER="${1#*=}"; shift ;;
      --reasoning-parser)    REASONING_PARSER="$2"; shift 2 ;;
      --reasoning-parser=*)  REASONING_PARSER="${1#*=}"; shift ;;
      *) REMAINING_ARGS+=("$1"); shift ;;
    esac
  done
  validate_numbers
}

network_info() {
  echo "Bind:      ${API_HOST}:${API_PORT}"
  echo "Endpoint:  http://$(detect_advertise_ip):${API_PORT}/v1"
  echo "Model:     ${SERVED_MODEL_NAME}"
  echo "Context:   ${MAX_MODEL_LEN}"
}

# HF cache มีสองเลย์เอาต์: $HF_HOME/hub/models--X (ปัจจุบัน) และ $HF_HOME/models--X (เก่า)
# เดิมที่นี่รู้จักแค่แบบแรก — โมเดลที่ผู้ใช้โหลดเองด้วยเครื่องมือรุ่นเก่าจึงถูกมองว่า
# "ยังไม่ได้ download" ทั้งที่ไฟล์ครบ แล้ว repair/download ก็โหลดซ้ำลง hub/ อีกหลายสิบ GB
# (แบบ stacked รองรับสองเลย์เอาต์อยู่ก่อนแล้ว — ตรงนี้ตามให้เท่ากัน)
_model_cache_dir() {
  local slug="${MODEL_ID//\//--}" candidate
  for candidate in "${HF_HOME}/hub/models--${slug}" "${HF_HOME}/models--${slug}"; do
    [[ -d "${candidate}/snapshots" ]] && { printf '%s' "$candidate"; return 0; }
  done
  printf '%s/hub/models--%s' "$HF_HOME" "$slug"
}

snapshot_dir() {
  printf '%s/snapshots/%s' "$(_model_cache_dir)" "$MODEL_REVISION"
}

# path ที่ HF ควรใช้เป็น hub cache *ฝั่งคอนเทนเนอร์* (host $HF_HOME ถูก mount ไว้ที่ /cache)
# เลย์เอาต์เก่าวางโมเดลไว้ที่รากพอดี ชี้ /cache/hub จะหาไม่เจอแล้วโหลดใหม่ทั้งก้อน
_container_hub_cache() {
  local slug="${MODEL_ID//\//--}"
  if [[ -d "${HF_HOME}/models--${slug}/snapshots" && ! -d "${HF_HOME}/hub/models--${slug}/snapshots" ]]; then
    printf '/cache'
  else
    printf '/cache/hub'
  fi
}

ensure_image() {
  # ดึง image ให้เห็นความคืบหน้า *ก่อน* จะเอาไปใช้ที่อื่น
  #
  # เดิม image ที่ยังไม่มีถูกดึงเงียบ ๆ ระหว่าง `docker run` ที่ผลถูกเก็บเข้าตัวแปร
  # (`out="$(docker run ... 2>&1)"`) — progress bar ของ docker จึงหายเข้าไปในตัวแปร
  # ผู้ใช้เห็นแค่บรรทัดสุดท้ายค้างอยู่หลายสิบนาที แยกไม่ออกว่ากำลังโหลดหรือค้างไปแล้ว
  # (image พวกนี้ 20-30 GB · เจอจริงกับ avarok/dgx-vllm-nvfp4-kernel)
  local image="$1"
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  echo "ดึง image ${image} (ยังไม่มีในเครื่อง — ขนาดหลาย GB ใช้เวลาสักครู่)…"
  docker pull "$image" || die "ดึง image ${image} ไม่สำเร็จ"
}

check_gpu() {
  need docker
  ensure_image "${SGLANG_IMAGE}"
  local out
  out="$(docker run --rm --gpus all --entrypoint nvidia-smi "$SGLANG_IMAGE" -L 2>&1)" ||
    die "GPU ใน container ใช้ไม่ได้: $out"
  echo "$out"
}

download() {
  need docker
  # ยืนยันว่ามี image ก่อนแตะเรื่องน้ำหนักโมเดล — ไม่งั้น "manifest unknown" ถูกอ่านเป็นปัญหา Xet (ดู vLLM)
  ensure_image "${SGLANG_IMAGE}"
{% if report.gated %}  # gated repo: ไม่มี token = huggingface_hub โยน traceback ยาวเหยียดที่อ่านไม่รู้เรื่อง
  # ตรวจตั้งแต่ต้นแล้วบอกให้ตรง ๆ ดีกว่า
  if [[ -z "${HF_TOKEN:-}" ]]; then
    die "${MODEL_ID} เป็น gated repo — ต้องมี HF_TOKEN ก่อน download
  1) ขอสิทธิ์ที่ https://huggingface.co/${MODEL_ID} (ต้องขึ้น ACCEPTED)
  2) สร้าง token ที่ https://huggingface.co/settings/tokens
  3) export HF_TOKEN=hf_xxx   แล้วรันใหม่: $0 download
หมายเหตุ: token ไม่ได้ถูกเก็บไว้ในสคริปต์นี้โดยเจตนา (กัน secret หลุดไปกับ bundle)"
  fi
{% endif %}  mkdir -p "$HF_HOME"

  # download รันในคอนเทนเนอร์ — env ที่ตั้งบน host ไม่ถึงข้างในเอง ต้องส่งต่อให้
  #
  # -u / PYTHONUNBUFFERED: ในคอนเทนเนอร์ไม่มี tty (ไม่ได้ขอ -t เพราะต้องรันแบบไม่โต้ตอบ)
  # แถบ progress ของ huggingface_hub เลื่อนตัวเลขด้วย \r ล้วน ๆ ไม่เคยขึ้นบรรทัดใหม่ —
  # ซึ่ง stderr ที่ line-buffer ไว้จะไม่ยอม flush ให้เลย · ผลคือ download 50 GB เงียบสนิท
  # ทั้งชั่วโมงแล้วค่อยพ่นออกมาทีเดียวตอนจบ คนดูแยกไม่ออกว่ากำลังโหลดอยู่หรือค้างไปแล้ว
  # ไม่มีอะไรคืบหน้าเกินเท่านี้ = ถือว่าค้างตาย แล้วเริ่มใหม่ (ต่อจากของเดิม)
  #
  # เคสจริง 2026-08-31 บน spark-head: โหลดไปได้ 36 GB จาก 170.9 GB แล้วหยุดนิ่ง
  # **1 ชั่วโมง 32 นาที** โดยไม่มี error ไม่มี log ไม่มีอะไรบอก · connection ไปหา CDN
  # ยังเปิดค้างอยู่ process นอนหลับใน recv() รอข้อมูลที่ไม่มีวันมา
  #
  # ฝั่ง llama.cpp กันเคสนี้ไว้แล้วด้วย `--speed-limit/--speed-time` ของ curl พร้อม
  # คอมเมนต์ที่เขียนไว้เองว่า "ไม่มี error ไม่มี timeout --retry จึงไม่เคยทำงาน" —
  # แต่เส้นทาง vLLM ใช้ huggingface_hub ในคอนเทนเนอร์ซึ่งไม่มีตัวกันแบบนั้นเลย
  #
  # ที่แย่กว่าคือคนที่เห็นว่ามันค้างมักสั่งใหม่ทับ แล้วตัวใหม่ไปติด lock ของตัวที่ค้างอยู่
  # กลายเป็นกองซ้อนกันสามตัวที่ไม่มีตัวไหนทำงานเลย (เจอจริงเช่นกัน)
  DOWNLOAD_STALL_SECONDS="${DOWNLOAD_STALL_SECONDS:-600}"

  _download_bytes() {
    du -sb "$(_model_cache_dir)" 2>/dev/null | cut -f1 || echo 0
  }

  _snapshot_download() {
    local disable_xet="$1"
    local name="lmds-dl-$$-${RANDOM}"

    # `-e HF_TOKEN` เฉย ๆ (ไม่มี =ค่า) = docker หยิบค่าจาก env ของเชลล์นี้ไปเอง
    #
    # ของเดิมเขียน `-e HF_TOKEN="$HF_TOKEN"` ซึ่งเอาค่าจริงไปแปะไว้ใน **argv ของ
    # docker run** — user ทุกคนบนเครื่องอ่านได้ด้วย `ps` เฉย ๆ (เจอจริงบน spark-head)
    # ทั้งที่ LMDS มีหลักเรื่องนี้อยู่แล้วในเส้นทาง SSH: ความลับไม่เดินทางผ่าน argv
    docker run -d --name "$name" \
      --user "$(id -u):$(id -g)" \
      -e HOME=/tmp -e USER=lmds -e HF_HOME=/cache -e HF_HUB_CACHE="$(_container_hub_cache)" \
      -e PYTHONUNBUFFERED=1 \
      -e HF_HUB_DOWNLOAD_TIMEOUT=30 \
      ${HF_TOKEN:+-e HF_TOKEN} \
      ${disable_xet:+-e HF_HUB_DISABLE_XET=1} \
      -v "${HF_HOME}:/cache" \
      --entrypoint python3 "$SGLANG_IMAGE" -u -c "
from huggingface_hub import snapshot_download
snapshot_download(repo_id='${MODEL_ID}', revision='${MODEL_REVISION}', cache_dir=None)
print('download complete')
" >/dev/null || return 1

    # ปล่อย log ออกมาให้เห็นความคืบหน้า พร้อมเฝ้าว่ายังขยับอยู่ไหม
    docker logs -f "$name" 2>&1 &
    local logs_pid=$!
    local last quiet=0
    last="$(_download_bytes)"
        # เทียบด้วย case ไม่ใช่ท่อไปหา grep — grep ที่ออกก่อนทำให้ docker โดน SIGPIPE
    # ใต้ set -o pipefail ทั้ง pipeline จึงคืนค่าไม่เป็นศูนย์แบบสุ่ม ๆ
    while [[ "$(docker inspect -f '{{ '{{.State.Running}}' }}' "$name" 2>/dev/null)" == "true" ]]; do
      sleep 30
      local now; now="$(_download_bytes)"
      # เทียบว่า "เปลี่ยนไหม" ไม่ใช่ "มากขึ้นไหม"
      #
      # เคสจริง 2026-09-01 บน spark-head: ของเดิมเก็บ last เป็น "ค่าสูงสุดที่เคยเห็น" แล้ว
      # seed ไว้ตั้งแต่ก่อนเข้าลูป · พอ container ใหม่เริ่ม มันตัด .incomplete ของรอบก่อน
      # ทิ้งแล้วโหลดใหม่ ขนาดโฟลเดอร์จึง **ลดลง** จาก 164.6 GB เหลือ 153.9 GB · ทุกตัวอย่าง
      # หลังจากนั้นถูกเทียบกับ 164.6 GB ที่ไม่มีวันถึงภายใน 600 วิ → watchdog ฆ่า download
      # ที่กำลังทำงานดี ๆ ทุก 10 นาที → ตัดไฟล์ทิ้งอีก → วนไม่รู้จบ (เห็นจริง 3 รอบติด
      # 154→163 GB แล้วกลับมา 154 GB)
      #
      # ขนาดที่ "ลดลง" แปลว่าตัวโหลดกำลังเขียนอยู่ ไม่ใช่ค้าง — นับเป็นความคืบหน้าเหมือนกัน
      # ค้างจริงคือขนาด **ไม่ขยับเลย** ต่างหาก
      if [[ "${now:-0}" != "${last:-0}" ]]; then
        last="$now"; quiet=0
      else
        quiet=$(( quiet + 30 ))
        if (( quiet >= DOWNLOAD_STALL_SECONDS )); then
          echo "" >&2
          echo "ไม่มีอะไรคืบหน้ามา ${quiet} วินาที — ถือว่าค้าง หยุดแล้วเริ่มใหม่ต่อจากเดิม" >&2
          docker stop -t 5 "$name" >/dev/null 2>&1 || true
          kill "$logs_pid" 2>/dev/null || true
          docker rm -f "$name" >/dev/null 2>&1 || true
          return 75
        fi
      fi
    done
    kill "$logs_pid" 2>/dev/null || true
    local code; code="$(docker wait "$name" 2>/dev/null || echo 1)"
    docker rm -f "$name" >/dev/null 2>&1 || true
    return "${code:-1}"
  }

  # ค้างแล้วเริ่มใหม่ได้หลายรอบ — ไฟล์ .incomplete ยังอยู่ครบ จึงต่อจากเดิมเสมอ
  _snapshot_download_resilient() {
    local disable_xet="$1" attempt=0
    while (( attempt < ${DOWNLOAD_MAX_ATTEMPTS:-10} )); do
      attempt=$(( attempt + 1 ))
      _snapshot_download "$disable_xet" && return 0
      local code=$?
      (( code == 75 )) || return "$code"      # ล้มด้วยเหตุอื่น = ปล่อยให้ผู้เรียกจัดการ
      # ค้างแล้วเริ่มใหม่ ต้องปิด Xet ไปด้วย ไม่ใช่เริ่มใหม่แบบเดิมเป๊ะ ๆ
      #
      # เคสจริง 2026-09-01 บน spark-head: Xet client ค้างสนิท — ทุกเธรดจอดที่ futex_do_wait,
# socket เปิดค้าง 11 เส้น, container log ว่างเปล่า, 12 นาทีไม่ขยับสักไบต์ · "ค้าง" แบบนี้
# ไม่เคยคืน exit code จึงไม่มีทางไปเข้าทาง fallback ที่ปิด Xet ข้างล่างเลย · เริ่มใหม่ทั้งที
# ยังเปิด Xet เหมือนเดิมก็ค้างซ้ำที่เดิมจนครบโควตา · พอปิด Xet โหลดต่อได้ทันทีที่ 34 MB/s
      disable_xet=1
      echo "เริ่มใหม่รอบที่ $(( attempt + 1 )) (ได้มาแล้ว $(( $(_download_bytes) / 1073741824 )) GB)" >&2
      sleep 5
    done
    echo "ค้างซ้ำ ${attempt} รอบ — ตรวจเน็ต/พร็อกซีแล้วสั่ง download ใหม่" >&2
    return 1
  }

  # Xet เป็น backend ใหม่ของ Hub ที่บาง repo (เช่นตระกูล Llama) ยังพังด้วย
  # "Unable to parse string as hex hash value" — ลองซ้ำโดยปิด Xet ให้อัตโนมัติ
  # แทนที่จะโยน traceback ของ Python ใส่หน้าผู้ใช้แล้วจบ
  if [[ -n "${HF_HUB_DISABLE_XET:-}" ]]; then
    _snapshot_download_resilient 1
  elif ! _snapshot_download_resilient ""; then
    echo "" >&2
    echo "download ล้มเหลว — ลองใหม่โดยปิด Xet transfer (HF_HUB_DISABLE_XET=1)" >&2
    echo "ไฟล์ที่โหลดมาแล้วยังอยู่ ระบบจะโหลดต่อจากเดิม ไม่เริ่มใหม่ทั้งหมด" >&2
    _snapshot_download_resilient 1
  fi
}

{% if shard_files -%}
# shard ที่ต้องมีครบ พร้อมขนาดจาก Hub (ว่าง = Hub ไม่รายงานขนาด → ข้ามการเทียบ)
SHARD_FILES=(
{% for shard in shard_files %}  "{{ shard.filename }}"
{% endfor %})
SHARD_SIZES=(
{% for shard in shard_files %}  "{{ shard.size }}"
{% endfor %})
{% endif -%}

verify_files() {
  local snap
  snap="$(snapshot_dir)"
  [[ -d "$snap" ]] || die "ยังไม่ได้ download (ไม่พบ $snap) — รัน: $0 download"
  local f
  for f in {{ required_files }}; do
    [[ -e "${snap}/${f}" ]] || die "ไฟล์จำเป็นหายไป: ${f}"
  done
{% if shard_files %}
  # ตรวจ shard ครบ + ขนาดตรงกับที่ Hub รายงาน — download ที่ขาดจะถูกจับตรงนี้
  # ไม่ใช่ไปพังตอน start ซึ่งไล่หาสาเหตุยากกว่ามาก
  local i path actual_size
  for i in "${!SHARD_FILES[@]}"; do
    path="${snap}/${SHARD_FILES[$i]}"
    [[ -e "$path" ]] || die "shard หายไป: ${SHARD_FILES[$i]} — รัน: $0 download (resume ต่อได้)"
    if [[ -n "${SHARD_SIZES[$i]}" ]]; then
      actual_size="$(stat -Lc %s "$path" 2>/dev/null || stat -Lf %z "$path")"
      if [[ "$actual_size" != "${SHARD_SIZES[$i]}" ]]; then
        # ใหญ่เกิน กับ เล็กเกิน ต้องแก้คนละทาง — บอกผิดแล้วผู้ใช้ไปวนกับคำสั่งที่ไม่ช่วย
        # (ทางนี้โหลดด้วย snapshot_download ซึ่ง resume ถูกอยู่แล้ว ไฟล์ใหญ่เกินจึงหมายถึง
        #  แคชปนของเก่าคนละ revision มากกว่า — ลบแล้วโหลดใหม่เหมือนกัน)
        if (( actual_size > ${SHARD_SIZES[$i]} )); then
          die "${SHARD_FILES[$i]}: ไฟล์ใหญ่เกินจริง (ได้ ${actual_size} ต้องการ ${SHARD_SIZES[$i]})
ไฟล์เสียหรือเป็นของคนละ revision — โหลดต่อไม่ช่วย
ลบแล้วโหลดใหม่:  rm -f '$path'  แล้วรัน  $0 download"
        fi
        die "${SHARD_FILES[$i]}: ขนาดไม่ตรง (ได้ ${actual_size} ต้องการ ${SHARD_SIZES[$i]} — download ไม่ครบ)
โหลดต่อได้เลย (resume):  $0 download"
      fi
    fi
  done
  echo "shard ครบ {{ '${#SHARD_FILES[@]}' }} ไฟล์ (ขนาดตรงกับ Hub)"
{% endif %}
  local broken
  broken="$(find -L "$snap" -type l 2>/dev/null || true)"
  [[ -z "$broken" ]] || die "พบ symlink เสียใน cache: $broken"
{% if runtime_assets %}
  verify_assets
{% endif %}
  echo "verify-files: OK (${snap})"
}
{% if runtime_assets %}
# --retry-all-errors มีตั้งแต่ curl 7.71 (2020) · Ubuntu 20.04 มากับ 7.68 ซึ่งไม่มี
# แล้ว curl จะตายทันทีด้วย "option --retry-all-errors: is unknown" — ถามก่อนใช้
# ดีกว่าเดาจากเลขเวอร์ชัน เพราะ distro แก้ patch ย้อนหลังกันบ่อย
curl_retry_all() {
  if [[ -z "${_CURL_RETRY_ALL+x}" ]]; then
    # เทียบด้วย case ไม่ใช่ท่อไปหา grep เพราะ grep ที่ออกก่อนทำให้ curl โดน SIGPIPE
    # ใต้ `set -o pipefail` ทั้ง pipeline จึงคืนค่าไม่เป็นศูนย์แบบสุ่ม ๆ
    case "$(curl --help all 2>/dev/null)" in
      *--retry-all-errors*) _CURL_RETRY_ALL="--retry-all-errors" ;;
      *)                    _CURL_RETRY_ALL="" ;;
    esac
  fi
  printf '%s' "$_CURL_RETRY_ALL"
}

prepare_runtime() {
  # ดึงไฟล์ runtime ภายนอกที่ผู้ใช้อนุมัติตอน deploy — ไม่มีอันไหนถูกดึงโดยไม่ได้อนุมัติ
  need curl
  mkdir -p "$PLUGIN_DIR"
  local i
  for i in "${!ASSET_FILES[@]}"; do
    echo "ดึง ${ASSET_FILES[$i]} จาก ${ASSET_URLS[$i]}"
    curl -fL --retry 3 --retry-delay 2 $(curl_retry_all) \
      -o "${PLUGIN_DIR}/${ASSET_FILES[$i]}" "${ASSET_URLS[$i]}" ||
      die "ดึง ${ASSET_FILES[$i]} ไม่สำเร็จ"
  done
  verify_assets
  echo "prepare-runtime: OK (${PLUGIN_DIR})"
}

verify_assets() {
  local i path actual_sha
  for i in "${!ASSET_FILES[@]}"; do
    path="${PLUGIN_DIR}/${ASSET_FILES[$i]}"
    [[ -f "$path" ]] || die "ไม่พบไฟล์ runtime: ${ASSET_FILES[$i]} — รัน: $0 prepare-runtime"
    if [[ -n "${ASSET_SHAS[$i]}" ]]; then
      need sha256sum
      actual_sha="$(sha256sum "$path" | awk '{print $1}')"
      [[ "$actual_sha" == "${ASSET_SHAS[$i]}" ]] ||
        die "${ASSET_FILES[$i]}: SHA-256 ไม่ตรง (ได้ ${actual_sha}) — ไฟล์ถูกแก้หรือดึงมาไม่ครบ"
    fi
  done
}
{% endif %}

port_in_use() {
  local out
  out="$(docker ps --filter "publish=${API_PORT}" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
  [[ -n "$out" ]]
}

write_meta() {
  # ลงทะเบียนกับ lmds fleet (~/.lmds/run) — ให้ lmds ps/stop/logs เห็นเซิร์ฟเวอร์ตัวนี้
  mkdir -p "$RUN_DIR"
  local script_path
  script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  cat > "${RUN_DIR}/server.meta" <<EOF
slug={{ slug }}
model=${SERVED_MODEL_NAME}
model_id=${MODEL_ID}
engine=sglang
mode=docker
port=${API_PORT}
container=${CONTAINER_NAME}
pid_file=
controller=${script_path}
started_at=$(date +%Y-%m-%dT%H:%M:%S)
EOF
}

# รันไทม์รู้จักสถาปัตยกรรมของ checkpoint นี้ไหม — ถามก่อน ไม่ใช่รอให้ตายตอนโหลด
#
# โมเดลที่ออกใหม่กว่า image เป็นเรื่องปกติ แต่มันจบด้วย container ที่ตายเงียบ ๆ
# แล้วขึ้นแค่ "หยุดก่อน health ผ่าน" ซึ่งไม่ได้บอกอะไรเลย · ถามตรง ๆ ใช้เวลาไม่กี่
# วินาที เทียบกับ health timeout ที่ตั้งไว้เป็นหลักสิบนาทีเพราะโมเดลใหญ่โหลดช้า
#
# ไม่แน่ใจ = ปล่อยผ่าน · ถาม image ไม่ได้หรือไม่มี config.json ให้ vLLM ตัดสินเอง
# การบล็อกคนที่ยังพอทำงานได้ แย่กว่าปล่อยให้เจอ error จริงของมัน
check_architecture() {
  local snapshot config model_type verdict
  snapshot="$(snapshot_dir 2>/dev/null || true)"
  config="${snapshot}/config.json"
  [[ -n "$snapshot" && -f "$config" ]] || return 0

  model_type="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('model_type',''))" "$config" 2>/dev/null || true)"
  [[ -n "$model_type" ]] || return 0

  verdict="$(docker run --rm --entrypoint python3 "$SGLANG_IMAGE" -c "
import sys
try:
    from transformers.models.auto.configuration_auto import CONFIG_MAPPING_NAMES
    import transformers
except Exception:
    sys.exit(0)
print('KNOWN' if sys.argv[1] in CONFIG_MAPPING_NAMES else 'UNKNOWN', transformers.__version__)
" "$model_type" 2>/dev/null | tail -1 || true)"

  case "$verdict" in
    UNKNOWN*)
      echo "ERROR: image นี้ไม่รู้จักสถาปัตยกรรม '${model_type}' (${verdict#UNKNOWN })" >&2
      echo "  โมเดลใหม่กว่ารันไทม์ — start ไปก็ตายตอนอ่าน config" >&2
      echo "  ลอง image ที่ใหม่กว่า:  SGLANG_IMAGE=<image> $0 start" >&2
      echo "  เช็คก่อนได้ว่าตัวไหนรู้จัก:" >&2
      echo "    docker run --rm --entrypoint python3 <image> -c \\" >&2
      echo "      \"from transformers.models.auto.configuration_auto import CONFIG_MAPPING_NAMES as m; print('${model_type}' in m)\"" >&2
      exit 1
      ;;
    KNOWN*)
      echo "architecture: ${model_type} — รองรับ (transformers ${verdict#KNOWN })"
      ;;
  esac
}


check_port_free() {
  # ห้าม start ทับเซิร์ฟเวอร์ของคนอื่นที่ยึด port นี้อยู่ — wait_health ยิง /health แล้ว "ตัวที่ยึดอยู่"
  # ตอบ 200 ให้ → รายงานว่า start สำเร็จทั้งที่ตัวเราไม่ได้ขึ้นเลย แล้วทุกคนคุยกับโมเดลผิดตัว
  # เคสจริง 2026-09-09 dgx-spark03: start Nemotron ทับ embedding ที่ยึด :8000 อยู่ → rc=0 ใน 17 วินาที
  # (llama.cpp controller มีด่านนี้มาตั้งแต่ 2026-08-13 · ฝั่ง vLLM/SGLang เพิ่งมี)
  [[ -n "${DRY_RUN:-}" ]] && return 0
  local holder=""
  if ! (exec 3<>"/dev/tcp/127.0.0.1/${API_PORT}") 2>/dev/null; then
    return 0
  fi
  holder="$(ss -ltnp 2>/dev/null | grep ":${API_PORT} " | head -1 || true)"
  local seen=""
  seen="$(curl -fsS -m 5 "http://127.0.0.1:${API_PORT}/v1/models" 2>/dev/null \
    | python3 -c 'import json,sys
try: d=json.load(sys.stdin)["data"]
except Exception: sys.exit(0)
print((d[0].get("id") or "").strip() if d else "")' 2>/dev/null || true)"
  die "port ${API_PORT} ถูกใช้อยู่แล้ว${seen:+ โดยโมเดล '"'"'${seen}'"'"'}${holder:+
     ${holder}}
     หยุดตัวนั้นก่อน หรือรันตัวนี้คนละ port:  $0 start --port <PORT>
     (ถ้าตั้งค่าไว้ให้ถาวร: lmds set {{ slug }} --port <PORT>)"
}

start() {
  check_port_free
  need docker
  # container ที่ตายแล้วเป็นซากของรอบก่อน ไม่ใช่ของที่กำลังทำงานอยู่ — เก็บกวาดเองแล้วไปต่อ
  # เดิมปฏิเสธทุกกรณี ทำให้ start ที่ล้ม (เช่นโมเดลโหลดไม่ขึ้น) ปิดทางตัวเองไว้:
  # ปุ่ม start กดอีกกี่ครั้งก็เจอ "มีอยู่แล้ว" และหน้าเว็บไม่มีปุ่ม stop ให้เพราะมันไม่ได้รันอยู่
  local running_now
  running_now="$(docker ps --filter "name=^${CONTAINER_NAME}$" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
  [[ -z "$running_now" ]] || die "container ${CONTAINER_NAME} กำลังรันอยู่ — รัน: $0 stop ก่อน"
  local leftover
  leftover="$(docker ps -a --filter "name=^${CONTAINER_NAME}$" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
  if [[ -n "$leftover" ]]; then
    echo "เก็บซาก container จากรอบก่อน (${CONTAINER_NAME}) แล้วเริ่มใหม่"
    docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
  fi
  # DRY_RUN=1 = ประกอบคำสั่งแล้วพิมพ์ออกมา ไม่แตะ GPU/ไฟล์/docker — ใช้ตรวจว่า flag และ env
  # ที่ตั้งผ่าน lmds set / bundle.args ไปถึง argv จริง ก่อนจะรอโหลดโมเดลหลายนาทีเพื่อรู้ว่าไม่ถึง
  if [[ -z "${DRY_RUN:-}" ]]; then
    check_gpu >/dev/null
    verify_files
    check_architecture
  fi

  # ชื่อ knob ของ controller เหมือนกันทุก engine — แปลเป็นชื่อธงของ SGLang ตรงนี้ที่เดียว
  #   MAX_MODEL_LEN          → --context-length        (vLLM: --max-model-len)
  #   GPU_MEMORY_UTILIZATION → --mem-fraction-static   (vLLM: --gpu-memory-utilization)
  #   MAX_NUM_SEQS           → --max-running-requests  (vLLM: --max-num-seqs)
  #   KV_CACHE_DTYPE         → --kv-cache-dtype        (แปลชื่อค่า: fp8 → fp8_e4m3 · ชื่อเฉพาะ vLLM → auto)
  local serve_args=(
    serve
    --model-path "$MODEL_ID"
    --revision "$MODEL_REVISION"
    --served-model-name "$SERVED_MODEL_NAME"
    --context-length "$MAX_MODEL_LEN"
    --mem-fraction-static "$GPU_MEMORY_UTILIZATION"
    --max-running-requests "$MAX_NUM_SEQS"
    --chunked-prefill-size "$CHUNKED_PREFILL_SIZE"
    --host "$API_HOST"
    --port "$API_PORT"
  )
{% if tensor_parallel > 1 %}
  serve_args+=(--tensor-parallel-size "$TENSOR_PARALLEL_SIZE")
{% endif %}
{% for flag in extra_flag_pairs %}
  serve_args+=({{ flag }})
{% endfor %}
  local kv_dtype; kv_dtype="$(_sglang_kv_cache_dtype "$KV_CACHE_DTYPE")"
  if [[ "$kv_dtype" != "auto" ]]; then
    serve_args+=(--kv-cache-dtype "$kv_dtype")
  fi
  if [[ -n "$EXTRA_SERVE_ARGS" ]]; then
    local extra_arg
    for extra_arg in $EXTRA_SERVE_ARGS; do serve_args+=("$extra_arg"); done
  fi
  # ต่างจาก vLLM: ไม่มี --enable-auto-tool-choice · ตั้ง parser คือเปิดใช้แล้ว
  if [[ -n "$TOOL_CALL_PARSER" ]]; then
    serve_args+=(--tool-call-parser "$TOOL_CALL_PARSER")
  fi
  if [[ -n "$REASONING_PARSER" ]]; then
    serve_args+=(--reasoning-parser "$REASONING_PARSER")
  fi
  if [[ -n "$CHAT_TEMPLATE" ]]; then
    local tpl; tpl="$(_resolve_chat_template "$CHAT_TEMPLATE")"
    if [[ -n "$tpl" ]]; then
      serve_args+=(--chat-template "$tpl")
    fi
  fi
  if [[ -n "$API_KEY" ]]; then
    serve_args+=(--api-key "$API_KEY")
  fi

  if [[ -n "${DRY_RUN:-}" ]]; then
    printf 'IMAGE=%s\n' "$SGLANG_IMAGE"
    printf '%s\n' "${serve_args[@]}"
    return 0
  fi

  local docker_args=(
    run -d --name "$CONTAINER_NAME"
    --network host --ipc host --gpus all
    -v "${HF_HOME}:/cache"
    -e HF_HOME=/cache -e "HF_HUB_CACHE=$(_container_hub_cache)" -e HOME=/tmp -e USER=lmds
  )
  # รันในฐานะ user เดียวกับที่สั่ง ไม่ใช่ root
  #
  # เดิม container เป็น root และ mount แคชเข้าไปตรง ๆ — ทุกไฟล์ที่มันเขียน (tokenizer,
  # .locks, ไฟล์ที่ขาดแล้วดึงเพิ่ม) จึงกลายเป็นของ root ในแคชของ user · ผลที่ตามมาคือ
  # โมเดลตัวถัดไป download ไม่ลง, `remove` ลบไม่ออก, `sync-worker` ตาย rsync exit 23
  # เจอจริงบน msi-5: ~/.cache/huggingface/hub ทั้งก้อน 73 GB เป็นของ root
  # (ทางเดิน download ใช้ --user อยู่ก่อนแล้ว — ตรงนี้ตามให้เท่ากัน)
  if [[ -z "${LMDS_RUN_AS_ROOT:-}" ]]; then
    docker_args+=(--user "$(id -u):$(id -g)")
  fi
  if [[ -n "${HF_TOKEN:-}" ]]; then docker_args+=(-e HF_TOKEN); fi
  # SGLang รับ key เป็นธงของ server ไม่ใช่ env — ใส่ที่ serve_args ข้างล่าง
{% if runtime_assets -%}
  verify_assets
  docker_args+=(-v "${PLUGIN_DIR}:${PLUGIN_MOUNT}:ro")
{% endif %}  # env ของ engine เอง — ตั้งด้วย `lmds set <slug> --engine-env "KEY=VALUE ..."`
  #
  # vLLM/SGLang มี knob จำนวนมากที่อ่านจาก environment ล้วน ๆ ส่งผ่าน flag ไม่ได้เลย
  # ก่อนมีช่องนี้ ทางเดียวคือแก้สคริปต์ด้วยมือ ซึ่งหายทุกครั้งที่ rebuild
  #
  # เคสจริง 2026-08-20 บน msi-6: NVFP4 บน GB10 ต้องได้ VLLM_NVFP4_GEMM_BACKEND=marlin
  # ไม่งั้น vLLM ไป JIT cutlass FP4 kernel แล้ว ptxas ปฏิเสธ (`cvt .e2m1x2` ไม่มีบน
  # sm_121) engine core ตายก่อน health โดยหน้าเว็บบอกแค่ "container หยุดก่อน health"
  if [[ -n "${ENGINE_ENV:-}" ]]; then
    local kv
    for kv in ${ENGINE_ENV}; do docker_args+=(-e "$kv"); done
  fi
  docker_args+=(--entrypoint sglang "$SGLANG_IMAGE")

  docker "${docker_args[@]}" "${serve_args[@]}"

  write_meta
  wait_health
  echo "started: $(detect_advertise_ip):${API_PORT} (${SERVED_MODEL_NAME})"
  warn_open_endpoint
  network_info
}

warn_open_endpoint() {
  # bind 0.0.0.0 + ไม่มี key = ใครก็ตามในวง network ยิง API ได้โดยไม่ต้องยืนยันตัวตน
  [[ "$API_HOST" == "0.0.0.0" && -z "$API_KEY" ]] || return 0
  echo "คำเตือน: เปิดให้ทั้งวง network เข้าถึงได้โดยไม่มี API key" >&2
  echo "         ใช้เฉพาะในเครื่อง: $0 restart --bind 127.0.0.1" >&2
  echo "         หรือบังคับ token:  API_KEY=\$(openssl rand -hex 24) $0 restart" >&2
}

# container ตายก่อน health — ดึงสาเหตุจริงจาก log มาบอก ไม่ใช่แค่ "ดู logs"
#
# เคสจริง 2026-09-03 บน dgx-spark04: gpu-memory-utilization 0.4 กับ ctx 262144
# engine core โยน ValueError "No available memory for the cache blocks" แต่บรรทัดสุดท้าย
# ของ log คือ RuntimeError "Engine core initialization failed. See root cause above"
# hub เห็นแค่บรรทัดสุดท้าย คนจึงต้อง ssh ไป grep เอง · สาเหตุจริงอยู่สูงกว่านั้นเสมอ
explain_crash() {
  local errs='ValueError|RuntimeError|OutOfMemoryError|AssertionError|ImportError|ModuleNotFoundError|NotImplementedError|KeyError|TypeError|OSError'
  local cause
  # `|| true` ท้าย pipeline จำเป็น: grep ที่ไม่เจอบรรทัด Error คืน 1 → ใต้ set -e + pipefail การ assign
  # นี้ทำสคริปต์ตายทันที ก่อนจะถึง die "container หยุดก่อน health" ของผู้เรียก · crash ที่ log ไม่มี
  # exception (โดน OOM-kill, image พัง) จึงถูกรายงานเป็นความว่างเปล่า exit 1 ไม่มีข้อความสักบรรทัด
  cause="$(docker logs --tail 500 "$CONTAINER_NAME" 2>&1 \
    | grep -E "(${errs}): " \
    | grep -vE 'Engine core initialization failed|See root cause above' \
    | sed -E "s/^.*(${errs}): /\\1: /" \
    | head -1 | cut -c1-300 || true)"
  [[ -n "$cause" ]] || return 0
  echo "สาเหตุจาก log: ${cause}" >&2
  case "$cause" in
    *"No available memory for the cache blocks"*|*"Not enough memory"*|*OutOfMemoryError*)
      echo "  หน่วยความจำที่กันไว้ให้ engine (GPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-?}) ไม่พอสำหรับ KV cache ที่ context ${MAX_MODEL_LEN:-?}" >&2
      echo "  แก้ถาวร:  lmds set <bundle> --gpu-util 0.85   (หรือลด --context)" >&2
      echo "  ลองทันที: GPU_MEMORY_UTILIZATION=0.85 $0 restart" >&2 ;;
    *e2m1*|*ptxas*)
      echo "  FP4 kernel นี้ใช้บน sm_121 ไม่ได้ — ตั้ง ENGINE_ENV ให้ใช้ marlin (ดู lmds set --help)" >&2 ;;
  esac
}

wait_health() {
  local waited=0
  echo "รอ /health (สูงสุด ${HEALTH_TIMEOUT}s — โหลดโมเดลใหญ่ใช้เวลานาน)..."
  until curl -fsS "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; do
    local running
    running="$(docker ps --filter "name=^${CONTAINER_NAME}$" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
    [[ -n "$running" ]] || { explain_crash; die "container หยุดก่อน health ผ่าน — ดู: $0 logs"; }
    if (( waited >= HEALTH_TIMEOUT )); then
      echo "ยังไม่ health ภายใน ${HEALTH_TIMEOUT}s — container ยังโหลดต่ออยู่ ไม่ได้ถูกหยุด" >&2
      echo "รอต่อ:      $0 wait-health" >&2
      echo "ดูคืบหน้า:   $0 logs 100" >&2
      echo "รอบหน้ารอนานขึ้น: HEALTH_TIMEOUT=3600 $0 start" >&2
      exit 1
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done
}

stop() {
  # รายงานตามความจริง — เดิมพิมพ์ "stopped" เสมอแม้ไม่มี container อยู่เลย
  # ซึ่งอันตรายเงียบ ๆ: ถ้าชื่อ container เพี้ยน ผู้ใช้จะเชื่อว่าหยุดแล้วทั้งที่ยังรันอยู่
  if docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1; then
    echo "stopped ${CONTAINER_NAME}"
  else
    echo "ไม่มีอะไรให้หยุด (ไม่พบ container ${CONTAINER_NAME})"
  fi
}

status() {
  docker ps -a --filter "name=^${CONTAINER_NAME}$"
  if curl -fsS "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
    echo "API: healthy"
    curl -fsS ${API_KEY:+-H "Authorization: Bearer $API_KEY"} \
      "http://127.0.0.1:${API_PORT}/v1/models" 2>/dev/null || true
    echo ""
  else
    echo "API: not responding"
  fi
}

# logs [N] [-f|--follow|follow] — N บรรทัดล่าสุด (default 300) · -f ตามต่อแบบ realtime
#
# follow รัน docker logs ไว้เบื้องหลังแล้ว wait — trap ของ bash ทำงานหลัง foreground child จบเท่านั้น
# ถ้ารันตรง ๆ SIGTERM จาก hub (ผู้ใช้ปิดแผง) หรือ Ctrl-C จะไม่ถึง docker logs จนกว่าจะมีบรรทัดใหม่
# ไม่มี container = บอกหนึ่งบรรทัดแล้วจบ (exit 0) ไม่วนรอ — หน้าเว็บเป็นคนต่อใหม่เองระหว่าง start
# ใน trap: `wait` ของ child ที่โดน TERM คืน 143 — ใต้ set -e ต้อง || true ไม่งั้น errexit ตัดก่อนถึง exit 0
logs() {
  local n=300 follow="" arg
  for arg in "$@"; do
    case "$arg" in
      -f|--follow|follow) follow=1 ;;
      ''|*[!0-9]*) ;;
      *) n="$arg" ;;
    esac
  done
  if [[ -z "$follow" ]]; then
    docker logs --tail "$n" "$CONTAINER_NAME"
    return
  fi
  if ! docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    echo "ยังไม่มี container ${CONTAINER_NAME} — โมเดลยังไม่ได้ start (หรือหยุดไปแล้ว) · start แล้วค่อยตาม log"
    return 0
  fi
  docker logs --tail "$n" -f "$CONTAINER_NAME" 2>&1 &
  local pid=$!
  trap 'kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true; exit 0' TERM INT HUP PIPE
  wait "$pid" || true
  trap - TERM INT HUP PIPE
}

client_config() {
  local input_budget
  if [[ "$CLIENT_INPUT" == "auto" ]]; then
    input_budget=$(( MAX_MODEL_LEN - CLIENT_OUTPUT - TEMPLATE_OVERHEAD_TOKENS ))
  else
    input_budget="$CLIENT_INPUT"
  fi
  (( input_budget > 0 )) || die "context เล็กเกิน: input budget = ${input_budget}"
  cat <<EOF
{
  "base_url": "http://$(detect_advertise_ip):${API_PORT}/v1",
  "model": "${SERVED_MODEL_NAME}",
  "api_key": "${API_KEY:-not-required}",
  "max_input_tokens": ${input_budget},
  "max_output_tokens": ${CLIENT_OUTPUT},
  "server_context": ${MAX_MODEL_LEN}
}
EOF
}

test_text() {
  assert_our_server
  # 512 ไม่ใช่ 64: โมเดลสาย reasoning (Qwen3, DeepSeek-R1 ฯลฯ) ใช้ budget ไปกับ <think> ก่อน
  # ถ้าให้น้อยจะได้ finish_reason "length" โดยยังไม่ทันตอบ ซึ่งดูเหมือนโมเดลพัง
  local response
  response="$(curl -fsS "http://127.0.0.1:${API_PORT}/v1/chat/completions" \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} \
    -H "Content-Type: application/json" \
    -d "{
      \"model\": \"${SERVED_MODEL_NAME}\",
      \"messages\": [{\"role\": \"user\", \"content\": \"ตอบสั้น ๆ: 2+2 เท่ากับเท่าไร\"}],
      \"max_tokens\": 512
    }")" || die "เรียก /v1/chat/completions ไม่สำเร็จ — ดู log: $0 logs 200"

  echo "$response"
  echo ""

  # สรุปให้อ่านออกโดยไม่ต้องเพ่ง JSON — และแยก "ตอบว่าง" ออกจาก "ตอบได้"
  if command -v python3 >/dev/null 2>&1; then
    printf "%s" "$response" | python3 -c '
import json, re, sys
try:
    msg = json.load(sys.stdin)["choices"][0]["message"]
except (ValueError, KeyError, IndexError):
    sys.exit(0)
raw = msg.get("content") or ""
# vLLM ใส่ chain-of-thought ไว้ใน content ตรง ๆ (<think>…</think>) ต่างจาก llama.cpp ที่แยก field
answer = re.sub(r"(?s)^.*?</think>", "", raw).strip()
if answer:
    print("test-text: OK — " + answer[:200])
elif raw.strip() or (msg.get("reasoning_content") or "").strip():
    print("test-text: โมเดลตอบแต่ยังคิดไม่จบใน 512 tokens (reasoning model)")
    print("           ไม่ใช่ความผิดพลาด — เซิร์ฟเวอร์รับงานและตอบกลับได้ปกติ")
else:
    print("test-text: เซิร์ฟเวอร์ตอบกลับแต่ไม่มีข้อความ — ดู log: logs 200")
' || true
  fi
}

# ติดมาทุก bundle ไม่ใช่เฉพาะที่เปิด reasoning ไว้ตอนสร้าง — ให้สวิตช์เปิดได้แต่ไม่มี
# ทางพิสูจน์ว่าได้ผล คือย้ายจุดบอดไปที่ใหม่เฉย ๆ · parser ผิดตัวไม่ error มันแค่เงียบ
# แล้วปล่อยให้ chain-of-thought ปนอยู่ในคำตอบจนกว่าจะมีคนสังเกตเอง
test_reasoning() {
  assert_our_server
  need curl
  python3 - "$API_PORT" "$SERVED_MODEL_NAME" "${API_KEY:-}" "${REASONING_PARSER:-}" <<'PYEOF'
import json, os, re, sys, urllib.error, urllib.request

port, model = int(sys.argv[1]), sys.argv[2]
api_key = sys.argv[3] if len(sys.argv) > 3 else ""
reasoning_parser = sys.argv[4] if len(sys.argv) > 4 else ""
host = os.environ.get("LOCAL_API_HOST", "127.0.0.1")
headers = {"Content-Type": "application/json"}
if api_key:
    headers["Authorization"] = "Bearer " + api_key

# งบ token: 512 พอสำหรับคำตอบ แต่โมเดลสาย thinking ใช้ไปกับ chain-of-thought ก่อน — ได้ reasoning ที่มี 1591 อยู่ข้างใน
# กับ content ว่าง แล้วเดิมขึ้น PASS "answer 0 ตัวอักษร" (audit 2026-09-08) ทั้งที่ client จริงจะได้ข้อความเปล่า ·
# เปิด parser ไว้ = เริ่มที่งบใหญ่ · ไม่เปิด = เริ่ม 1024 แล้วขยายเมื่อเห็นว่าคิด · temperature 0 ให้ผลซ้ำได้
BUDGET_PLAIN, BUDGET_THINK = 1024, 4096


def ask(budget):
    payload = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": "What is 37 multiplied by 43? Show your work."}],
        "max_tokens": budget, "temperature": 0,
    }).encode()
    req = urllib.request.Request(f"http://{host}:{port}/v1/chat/completions", data=payload, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=300) as response:
            choice = json.load(response)["choices"][0]
    except urllib.error.HTTPError as exc:
        print(f"FAIL: HTTP {exc.code} — {exc.read().decode()[:300]}")
        sys.exit(1)
    msg = choice.get("message") or {}
    # vLLM ใช้มาแล้วสองชื่อ: `reasoning_content` ในรุ่นเก่า และ `reasoning` ในรุ่นใหม่
    # ดูแค่ชื่อเดียวจะรายงานว่า parser ไม่ทำงานทั้งที่ทำงานอยู่ แล้วส่งคนไปแก้ของที่ถูกแล้ว
    return {"think": msg.get("reasoning_content") or msg.get("reasoning") or "",
            "raw": msg.get("content") or "", "finish": choice.get("finish_reason") or "", "budget": budget}


def final_answer(raw):
    """ข้อความที่ client จะเห็นเป็นคำตอบ — ไม่นับ <think>…</think> ที่ engine ไม่มี parser ปล่อยปนมาใน content"""
    if "<think>" in raw and "</think>" not in raw:
        return ""                                        # ยังคิดไม่จบ ถูกตัดกลางคัน
    return re.sub(r"(?s)^.*?</think>", "", raw).strip()


def head(text, n=200):
    return (text or "").strip()[:n].replace("\n", " ")


budget = BUDGET_THINK if reasoning_parser else BUDGET_PLAIN
r = ask(budget)
answer = final_answer(r["raw"])
if not answer and (r["think"] or "<think>" in r["raw"]) and budget < BUDGET_THINK:
    r = ask(BUDGET_THINK)                                # โมเดลคิดแม้ไม่ได้ตั้ง parser — ให้ที่คิดแล้วดูใหม่
    answer = final_answer(r["raw"])
think = r["think"]

if not answer:
    # คำตอบว่างไม่ใช่ PASS แม้ 1591 จะอยู่ใน reasoning — client ได้ข้อความเปล่า
    print(f"WARN: คำตอบว่าง — reasoning กินงบ (finish_reason={r['finish'] or '?'} · max_tokens {r['budget']} · "
          f"reasoning {len(think) + (len(r['raw']) if '<think>' in r['raw'] else 0)} ตัวอักษร)")
    if "1591" in think + r["raw"]:
        print("  1591 อยู่ใน chain-of-thought แล้ว แต่ไม่ถึงคำตอบสุดท้าย")
    print(f"  reasoning: {head(think or r['raw'])}")
    print("  agent ต้องตั้ง max_tokens ให้พอ (≥ 4096 กับโมเดลที่คิดยาว) หรือปิด thinking ผ่าน chat_template_kwargs")
    sys.exit(2)
if "1591" not in answer:
    print("FAIL: คำตอบสุดท้ายไม่มี 1591" + (" (มีแต่ใน reasoning)" if "1591" in think else ""))
    print(f"  finish_reason: {r['finish'] or '?'} · max_tokens {r['budget']}")
    print(f"  reasoning: {head(think)}")
    print(f"  content  : {head(answer)}")
    sys.exit(1)
if not think:
    # แยกสองกรณีให้ชัด ไม่งั้นคนจะไปไล่เปลี่ยน parser ทั้งที่โมเดลไม่ได้คิดออกมาเลย
    leaked = "</think>" in r["raw"] or "<think>" in r["raw"]
    if leaked:
        print("WARN: โมเดลพ่น <think> ออกมาใน content — --reasoning-parser ไม่ตรงหรือยังไม่ได้ตั้ง")
    else:
        print("WARN: ตอบถูก แต่ไม่มีทั้ง reasoning_content และร่องรอย <think> ใน content")
        print("  แปลว่าโมเดลไม่ได้แยก chain-of-thought ออกมาในรอบนี้ ซึ่งอาจถูกต้องแล้ว")
        print("  (คำถามง่ายเกินจนไม่ต้องคิด หรือ template ปิด thinking ไว้)")
        print("  ไม่ใช่หลักฐานว่า parser ผิด — ถ้าจะยืนยัน ให้ลองคำถามที่ต้องคิดหลายขั้น")
    sys.exit(0)
print(f"PASS: 1591 ถูกต้อง · reasoning {len(think)} ตัวอักษร · answer {len(answer)} ตัวอักษร (max_tokens {r['budget']})")
PYEOF
}

# controller ส่ง --tool-call-parser {{ plan.tool_calling.parser }} + --enable-auto-tool-choice
list_parsers() {
  need docker
  ensure_image "${SGLANG_IMAGE}"
  # ถามชื่อจาก engine เอง — ชื่อไฟล์ในซอร์สไม่ตรงกับชื่อที่ลงทะเบียน
  # (เช่นไฟล์ qwen3xml.py แต่ชื่อจริงคือ qwen3_xml) และรายชื่อเปลี่ยนไปตามเวอร์ชัน
  docker run --rm --entrypoint python3 "${SGLANG_IMAGE}" -c '
import sys

def registry(module, cls_name):
    m = __import__(module, fromlist=["*"])
    c = getattr(m, cls_name)
    found = set()
    for attr in dir(c):                       # เก็บทั้ง registry ปกติและแบบ lazy
        if attr.endswith("parsers"):
            value = getattr(c, attr, None)
            if isinstance(value, dict):
                found |= set(value)
    return sorted(found)

def report(label, candidates):
    for module, cls_name in candidates:
        try:
            names = registry(module, cls_name)
        except Exception:
            continue
        if names:
            print(f"{label}:")
            print("  " + " ".join(names))
            return
    print(f"{label}: อ่านจาก engine ไม่ได้ — ดูจาก --help ของ engine แทน")

report("tool parsers  (--tool-parser)", [
    ("vllm.tool_parsers", "ToolParserManager"),
    ("vllm.entrypoints.openai.tool_parsers", "ToolParserManager"),
    ("sglang.srt.function_call.function_call_parser", "FunctionCallParser"),
])
report("reasoning parsers  (--reasoning-parser)", [
    ("vllm.reasoning", "ReasoningParserManager"),
    ("sglang.srt.reasoning_parser", "ReasoningParser"),
])
' 2>/dev/null || die "รันไม่สำเร็จ — image อาจยังไม่ถูกดึงลงมา"
}

test_tools() {
  assert_our_server
  need curl
  python3 - "$API_PORT" "$SERVED_MODEL_NAME" "${1:-both}" "$0" "${API_KEY:-}" "${REASONING_PARSER:-}" <<'PYEOF'
import json, os, re, sys, urllib.error, urllib.request

port, model, mode, prog = int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
api_key = sys.argv[5] if len(sys.argv) > 5 else ""
reasoning_parser = sys.argv[6] if len(sys.argv) > 6 else ""
host = os.environ.get("LOCAL_API_HOST", "127.0.0.1")
headers = {"Content-Type": "application/json"}
if api_key:
    headers["Authorization"] = "Bearer " + api_key

# auto คือโหมดที่ Claude Code / Hermes / OpenClaw / agent ทุกตัวส่งมาจริง — โมเดล
# เขียนตามรูปแบบของมันเอง แล้ว parser ต้องแปลให้ได้
# required สั่งให้ engine บังคับรูปแบบด้วย guided decoding จึงผ่านได้แม้ parser ผิด
# ทดสอบแค่ required แล้วรายงานว่าใช้ได้ = วัดเส้นทางที่ไม่มีใครเดิน
TOOLS = [{"type": "function", "function": {
    "name": "get_weather", "description": "Get current weather for a location",
    "parameters": {"type": "object",
                   "properties": {"location": {"type": "string"}},
                   "required": ["location"]}}}]

# รูปแบบดิบที่โมเดลเขียน → parser ที่แปลมันออก · เดาให้ ไม่ต้องไล่ลองทีละตัว
SHAPES = [
    (r"<function=|<parameter=",       "qwen3_coder"),
    (r"<tool_call>\s*\{",             "qwen3_xml (Qwen3.5+) หรือ hermes (Qwen รุ่นเก่า)"),
    (r"<\|tool.call",                 "deepseek_v3 / deepseek_v31"),
    (r"<\|python_tag\|>",             "llama3_json"),
    (r'"name"\s*:\s*"get_weather"',   "llama3_json (หรือ mistral)"),
    (r"^\s*\[?\s*get_weather\s*\(",   "pythonic (หรือ llama4_pythonic)"),
]

# งบ token: โมเดลสาย thinking (Qwen3.6, GLM, DeepSeek-R1) คิด 150–500+ tokens *ก่อน* จะเรียก tool — ให้ 512
# จึงหมดกลางทาง ได้ finish_reason=length โดยไม่มี tool_calls แล้วเดิมรายงานว่า "parser แปลไม่ออก" ทั้งที่ parser ถูก
# (audit 2026-09-08 · Qwen3.6-35B ผ่าน 3/3 ที่ temperature 0 + 2048) · temperature 0 ให้ผลซ้ำได้ ไม่แกว่งรอบต่อรอบ
# · เปิด --reasoning-parser ไว้ = เริ่มที่งบใหญ่เลย · ไม่เปิด = เริ่มเล็ก แล้วขยายเมื่อเห็นว่าโมเดลคิด
BUDGET_PLAIN, BUDGET_THINK = 512, 2048


def ask(choice_mode, budget, no_think=False):
    body = {"model": model,
            "messages": [{"role": "user", "content": "What is the weather in Bangkok?"}],
            "tools": TOOLS, "tool_choice": choice_mode, "max_tokens": budget, "temperature": 0}
    if no_think:
        # ปิด chain-of-thought ผ่าน chat template (Qwen3/GLM/DeepSeek รู้จัก enable_thinking) — engine ที่ไม่รู้จักคีย์นี้เมินเฉย ๆ
        body["chat_template_kwargs"] = {"enable_thinking": False}
    req = urllib.request.Request(f"http://{host}:{port}/v1/chat/completions",
                                 data=json.dumps(body).encode(), headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=300) as response:
            choice = json.load(response)["choices"][0]
    except urllib.error.HTTPError as exc:
        return {"error": f"HTTP {exc.code}: {exc.read().decode()[:200]}", "budget": budget, "no_think": no_think}
    except (OSError, ValueError, KeyError, IndexError) as exc:
        return {"error": str(exc)[:200], "budget": budget, "no_think": no_think}
    msg = choice.get("message") or {}
    return {"calls": msg.get("tool_calls") or [], "content": msg.get("content") or "",
            "finish": choice.get("finish_reason") or "",
            # vLLM ใช้มาแล้วสองชื่อ: reasoning_content (เก่า) และ reasoning (ใหม่)
            "reasoning": msg.get("reasoning_content") or msg.get("reasoning") or "",
            "budget": budget, "no_think": no_think}


def thought(r):
    return bool(r.get("reasoning")) or "<think>" in (r.get("content") or "")


def probe(choice_mode):
    """ยิงจนได้ข้อสรุป: งบเล็ก → งบใหญ่เมื่อเห็นว่าโมเดลคิด → ปิด thinking หนึ่งครั้งเมื่อยังหมดงบ"""
    budget = BUDGET_THINK if reasoning_parser else BUDGET_PLAIN
    r = ask(choice_mode, budget)
    if not r.get("error") and not r["calls"] and thought(r) and budget < BUDGET_THINK:
        r = ask(choice_mode, BUDGET_THINK)
    if not r.get("error") and not r["calls"] and r["finish"] == "length":
        again = ask(choice_mode, BUDGET_THINK, no_think=True)
        if not again.get("error"):
            again["retried_without_thinking"] = True
            r = again
    return r


def guess(text):
    for pattern, name in SHAPES:
        if re.search(pattern, text, re.M):
            return name
    return ""


def one_line(calls):
    fn = calls[0]["function"]
    return f"{fn['name']}({fn['arguments'][:80]})"


def head(text, n=200):
    return (text or "").strip()[:n].replace("\n", " ")


modes = ["auto", "required"] if mode == "both" else [mode]
seen = {}
for m in modes:
    r = probe(m)
    seen[m] = r
    if r.get("error"):
        print(f"  {m:9s} → engine ปฏิเสธ ({r['error']})")
        continue
    note = f"max_tokens {r['budget']}" + (" · thinking ปิด" if r.get("no_think") else "")
    print(f"  {m:9s} → {one_line(r['calls']) if r['calls'] else 'ไม่มี tool_calls'}   [{note} · finish_reason={r['finish'] or '?'}]")

print()
auto = seen.get("auto")
req = seen.get("required")
auto_calls = None if auto is None or auto.get("error") else auto["calls"]
req_calls = None if req is None or req.get("error") else req["calls"]

if auto_calls:
    print("PASS: โมเดลเรียก tool ได้เองในโหมด auto — ใช้กับ agent ได้จริง")
    if auto.get("retried_without_thinking"):
        print("  ⚠ ผ่านเฉพาะตอนปิด thinking (chat_template_kwargs enable_thinking:false) — เปิด thinking แล้วคิดจนหมดงบ")
        print("    agent ที่ปล่อยให้คิด ต้องตั้ง max_tokens ให้พอ (≥ 2048) ไม่งั้นได้ข้อความเปล่าแทน tool call")
    sys.exit(0)

if auto is None:                             # ผู้ใช้ขอ required อย่างเดียว
    if req_calls:
        print("PASS(required): ผ่านเฉพาะโหมดบังคับ")
        print(f"  ยังไม่ได้พิสูจน์ว่า agent ใช้ได้ · รัน: {prog} test-tools auto")
        sys.exit(0)
    print("FAIL(required): ไม่มี tool_calls แม้จะบังคับ — parser ไม่ตรงกับโมเดล")
    sys.exit(1)

# auto ไม่ผ่าน = agent ใช้ไม่ได้ ไม่ว่า required จะผ่านหรือไม่ — แต่ *ทำไม* ไม่ผ่านต้องบอกให้ถูก:
# หมดงบก่อนเรียก tool กับ parser แปลไม่ออก แก้คนละทาง
print("FAIL(auto): ไม่มี tool_calls — Claude Code และ agent อื่นจะเห็นเป็นข้อความเปล่า")
if auto.get("error"):
    print(f"  engine ปฏิเสธคำขอ: {auto['error']}")
    sys.exit(1)
auto_text, auto_think = auto["content"], auto["reasoning"]
out_of_budget = auto["finish"] == "length"
if out_of_budget:
    print(f"  หมดงบก่อนเรียก tool: finish_reason=length · max_tokens {auto['budget']} · reasoning {len(auto_think)} ตัวอักษร"
          + (" · ลองปิด thinking แล้วก็ยังไม่ทัน" if auto.get("retried_without_thinking") else ""))
    print("  ไม่ใช่ parser ผิด — โมเดลคิดยาวจนไม่ถึง tool call · agent ต้องส่ง max_tokens ≥ 2048 หรือปิด thinking")
    print("  (ตั้งถาวรได้ด้วย --extra-args ตาม engine เช่น --default-chat-template-kwargs ของ vLLM)")
elif req_calls:
    print("  โหมด required ผ่าน เพราะ engine บังคับรูปแบบให้เอง")
    print("  แปลว่าโมเดลเรียก tool เป็น แต่ --tool-parser แปลรูปแบบของมันไม่ออก")
elif req_calls is not None:
    print("  โหมด required ก็ไม่ผ่าน — parser ผิด หรือโมเดลนี้เรียก tool ไม่เป็น")
print(f"  finish_reason : {auto['finish'] or '?'}")
if auto_think.strip():
    print(f"  reasoning     : {head(auto_think)}")
if auto_text.strip():
    print(f"  content       : {head(auto_text)}")
hint = "" if out_of_budget else guess(auto_text)
if hint:
    print(f"  รูปแบบนี้ตรงกับ parser: {hint}")
    print(f"  ลองใหม่:  {prog} restart --tool-parser <ชื่อข้างบน>")
elif not out_of_budget:
    print(f"  ดูชื่อ parser ที่ใช้ได้ทั้งหมด:  {prog} parsers")
sys.exit(1)
PYEOF
}
usage() {
  cat <<EOF
{{ slug }} — SGLang controller  (model: ${MODEL_ID})

USAGE
  $0 <command> [options]

COMMANDS
  download          Download model weights into the HF cache (resumable, revision pinned)
  verify-files      Check required files, every shard present, sizes match the Hub
{% if runtime_assets -%}
  prepare-runtime   Fetch approved external runtime files (REQUIRED once before first start)
{% endif %}  start             Verify GPU + files, then start the server and wait for /health
  stop              Stop and remove the container
  restart           stop + start (use this to apply new options)
  status            Container state + API health + loaded model list
  logs [N] [-f]     Show last N log lines (default 300) · -f follows live (Ctrl-C stops; also: lmds logs {{ slug }} -f)
  wait-health       Keep waiting for /health (use if start timed out but the model is still loading)
  client-config     Print client settings as JSON (base_url, model name, token budget)
  network-info      Show current bind address and the endpoint advertised to clients
  test-text         Send one chat completion request to verify the model answers
  test-reasoning    ตรวจว่า --reasoning-parser แยก chain-of-thought ได้จริง (37×43=1591)
  test-tools [both|auto|required]  ตรวจว่า --tool-parser แปลงเป็น tool_calls ได้จริง
                    ค่าตั้งต้น both = ทดสอบ auto ก่อน ซึ่งเป็นโหมดที่ agent ใช้จริง
  parsers           สิ่งที่ engine รู้จัก: ชื่อ --tool-parser และ --reasoning-parser ที่ใส่ได้จริง

OPTIONS  (can be placed after any command; equals form also works: --port=8001)
  --port N              Port to serve on                          [default: ${API_PORT}]
  --context N           Max context length in tokens              [default: ${MAX_MODEL_LEN}]
                        Lower this first if the server runs out of memory.
  --extra-args "..."    Extra engine flags appended verbatim (space-separated; write JSON without spaces) [default: ${EXTRA_SERVE_ARGS}]
  --bind ADDR           Address the server listens on             [default: ${API_HOST}]
                        0.0.0.0 = reachable from the whole network
                        127.0.0.1 = this machine only (safest)
  --advertise-ip ADDR   IP printed for clients. Does NOT change what the server binds to.
                        Use when the machine has several NICs or sits behind NAT.
  --interface NAME      Pick the advertised IP from this interface (e.g. eth0) instead of auto-detect
  --client-input N|auto Input token budget written into client-config   [default: ${CLIENT_INPUT}]
  --client-output N     Output token budget written into client-config  [default: ${CLIENT_OUTPUT}]
  --tool-parser NAME    Enable tool calling with this SGLang parser   [default: ${TOOL_CALL_PARSER:-off}]
                        Set it on an existing deployment, then restart:
                          $0 restart --tool-parser hermes
                        Prove it works with:  $0 test-tools
                        Empty disables tool calling.
  --reasoning-parser NAME  Separate chain-of-thought into reasoning_content
                                                                [default: ${REASONING_PARSER:-off}]
                        Without it the model narrates inside the answer and every
                        client has to strip it by guesswork. Set, then restart:
                          $0 restart --reasoning-parser deepseek_r1
                        Prove it works with:  $0 test-reasoning
                        Empty disables it.

API TOKEN (authentication)
  There is NO token by default: anyone who can reach ${API_HOST}:${API_PORT} can use the model.
  Set one with the API_KEY environment variable — it is passed to SGLang as --api-key:

    API_KEY=my-secret-token $0 restart          # start the server with authentication on
    API_KEY=\$(openssl rand -hex 24) $0 restart  # or generate a random one

  Clients then send it as a bearer token:

    curl http://<ip>:${API_PORT}/v1/chat/completions \\
      -H "Authorization: Bearer my-secret-token" \\
      -H 'Content-Type: application/json' \\
      -d '{"model":"${SERVED_MODEL_NAME}","messages":[{"role":"user","content":"hi"}]}'

  The token is NOT stored in this script — you must pass API_KEY on every start/restart
  (put it in your shell profile or a systemd drop-in to make it permanent).
  Without a token, prefer:  $0 restart --bind 127.0.0.1

ENVIRONMENT VARIABLES
  API_KEY                 Bearer token required from clients        [default: none]
  API_PORT / API_HOST     Same as --port / --bind
  MAX_MODEL_LEN           Same as --context
  HF_TOKEN                Hugging Face token, needed for gated repos during 'download'
  HF_HOME                 Where model weights live  [default: \${HOME}/.cache/huggingface]
  GPU_MEMORY_UTILIZATION  Passed as --mem-fraction-static            [default: ${GPU_MEMORY_UTILIZATION}]
                          Lower it when sharing the GPU with other workloads.
  MAX_NUM_SEQS            Passed as --max-running-requests           [default: ${MAX_NUM_SEQS}]
  CHUNKED_PREFILL_SIZE    Prefill chunk size                        [default: ${CHUNKED_PREFILL_SIZE}]
  KV_CACHE_DTYPE          auto | fp8_e4m3 | fp8_e5m2 (vLLM's "fp8" is translated) [default: ${KV_CACHE_DTYPE}]
  HEALTH_TIMEOUT          Seconds to wait for /health on start      [default: ${HEALTH_TIMEOUT}]
  CONTAINER_NAME          Docker container name                     [default: ${CONTAINER_NAME}]
  RUN_DIR                 Runtime state read by 'lmds ps'           [default: ${RUN_DIR}]

EXAMPLES
  $0 start --port 8001 --context 32768        # different port, smaller context
  $0 restart --bind 127.0.0.1                 # lock the endpoint to this machine
  API_KEY=secret123 $0 restart                # require a bearer token
  HF_TOKEN=hf_xxx $0 download                 # gated repository
  GPU_MEMORY_UTILIZATION=0.70 $0 restart      # leave room for another process on the GPU
EOF
}

