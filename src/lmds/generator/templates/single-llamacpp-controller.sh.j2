#!/usr/bin/env bash
# {{ slug }} — llama.cpp single-node controller (GGUF)
# Model:    {{ plan.model_id }} @ {{ plan.revision }}
# File:     {{ plan.selected_gguf }}{% if gguf_parts|length > 1 %} (+{{ gguf_parts|length - 1 }} parts){% endif %}
# Target:   {{ fit.target_name }} | Generated by LMDS {{ lmds_version }} ({{ plan.generator }})
# Standard: dgx-spark-controllers v3.0.0 controller contract
set -Eeuo pipefail

# ============================ CONFIG (แก้ได้) ============================
MODEL_ID="{{ plan.model_id }}"
MODEL_REVISION="{{ plan.revision }}"
SERVED_MODEL_NAME="{{ plan.served_model_name }}"

# runtime mode: docker (RTX x86_64, image ทางการ) | native (DGX Spark ARM64 — build จาก source)
RUNTIME_MODE="${RUNTIME_MODE:-{{ runtime_mode }}}"
LLAMACPP_IMAGE="{{ plan.runtime.image_ref }}"
LLAMA_CPP_REPO="${LLAMA_CPP_REPO:-https://github.com/ggml-org/llama.cpp.git}"
LLAMA_CPP_REF="${LLAMA_CPP_REF:-master}"
LLAMA_CPP_DIR="${LLAMA_CPP_DIR:-${HOME}/src/llama.cpp}"
LLAMA_SERVER="${LLAMA_SERVER:-${LLAMA_CPP_DIR}/build/bin/llama-server}"
CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES:-{{ cuda_architectures }}}"
CONTAINER_NAME="${CONTAINER_NAME:-lmds-{{ slug }}}"

MODEL_DIR="${MODEL_DIR:-${HOME}/models/{{ slug }}}"
RUN_DIR="${RUN_DIR:-${HOME}/.lmds/run/{{ slug }}}"
PID_FILE="${RUN_DIR}/server.pid"
LOG_FILE="${RUN_DIR}/server.log"
RUNTIME_LOCK="${RUN_DIR}/runtime.lock"

# ไฟล์โมเดล (split GGUF จะมีหลาย part — ต้องครบทุกไฟล์)
MODEL_FILES=(
{% for part in gguf_parts %}  "{{ part.basename }}"
{% endfor %})
MODEL_URLS=(
{% for part in gguf_parts %}  "https://huggingface.co/{{ plan.model_id }}/resolve/{{ plan.revision }}/{{ part.filename }}"
{% endfor %})
EXPECTED_SIZES=(
{% for part in gguf_parts %}  "{{ part.size_bytes if part.size_bytes is not none else '' }}"
{% endfor %})
EXPECTED_SHAS=(
{% for part in gguf_parts %}  "{{ part.sha256 or '' }}"
{% endfor %})
MODEL_FILE="${MODEL_FILES[0]}"

CTX_SIZE="${CTX_SIZE:-{{ plan.serving.context }}}"
API_HOST="${API_HOST:-0.0.0.0}"
API_PORT="${API_PORT:-8000}"
API_KEY="${API_KEY:-}"
ADVERTISE_IP="${ADVERTISE_IP:-}"
ADVERTISE_INTERFACE="${ADVERTISE_INTERFACE:-}"
ROUTE_PROBE_IP="${ROUTE_PROBE_IP:-1.1.1.1}"

N_GPU_LAYERS="${N_GPU_LAYERS:-{{ n_gpu_layers }}}"
PARALLEL_SEQS="${PARALLEL_SEQS:-{{ plan.serving.max_num_seqs }}}"
CLIENT_OUTPUT="${CLIENT_OUTPUT:-{{ plan.serving.max_output_tokens }}}"
CLIENT_INPUT="${CLIENT_INPUT:-auto}"
TEMPLATE_OVERHEAD_TOKENS="2048"
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-{{ health_timeout }}}"
# ========================================================================

die() { echo "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

validate_numbers() {
  [[ "$API_PORT" =~ ^[0-9]+$ ]] && (( API_PORT >= 1 && API_PORT <= 65535 )) ||
    die "invalid API_PORT: $API_PORT"
  [[ "$CTX_SIZE" =~ ^[0-9]+$ ]] && (( CTX_SIZE > 0 )) ||
    die "invalid context: $CTX_SIZE"
  [[ "$CLIENT_OUTPUT" =~ ^[0-9]+$ ]] && (( CLIENT_OUTPUT > 0 )) ||
    die "invalid CLIENT_OUTPUT: $CLIENT_OUTPUT"
}

detect_advertise_ip() {
  if [[ -n "$ADVERTISE_IP" ]]; then printf '%s' "$ADVERTISE_IP"; return; fi
  if [[ -n "$ADVERTISE_INTERFACE" ]]; then
    ip -4 -o addr show dev "$ADVERTISE_INTERFACE" scope global |
      awk 'NR == 1 { split($4, a, "/"); print a[1] }'
    return
  fi
  local route_src
  route_src="$(ip -4 route get "$ROUTE_PROBE_IP" 2>/dev/null |
    awk '{ for (i=1; i<=NF; i++) if ($i=="src") { print $(i+1); exit } }')"
  if [[ -n "$route_src" ]]; then printf '%s' "$route_src"; return; fi
  hostname -I 2>/dev/null | awk '{print $1}'
}

parse_options() {
  REMAINING_ARGS=()
  while (( $# )); do
    case "$1" in
      --context)        CTX_SIZE="$2"; shift 2 ;;
      --context=*)      CTX_SIZE="${1#*=}"; shift ;;
      --port)           API_PORT="$2"; shift 2 ;;
      --port=*)         API_PORT="${1#*=}"; shift ;;
      --bind)           API_HOST="$2"; shift 2 ;;
      --bind=*)         API_HOST="${1#*=}"; shift ;;
      --advertise-ip)   ADVERTISE_IP="$2"; shift 2 ;;
      --advertise-ip=*) ADVERTISE_IP="${1#*=}"; shift ;;
      --interface)      ADVERTISE_INTERFACE="$2"; shift 2 ;;
      --interface=*)    ADVERTISE_INTERFACE="${1#*=}"; shift ;;
      --client-input)   CLIENT_INPUT="$2"; shift 2 ;;
      --client-input=*) CLIENT_INPUT="${1#*=}"; shift ;;
      --client-output)  CLIENT_OUTPUT="$2"; shift 2 ;;
      --client-output=*) CLIENT_OUTPUT="${1#*=}"; shift ;;
      *) REMAINING_ARGS+=("$1"); shift ;;
    esac
  done
  validate_numbers
}

network_info() {
  echo "Bind:      ${API_HOST}:${API_PORT}"
  echo "Endpoint:  http://$(detect_advertise_ip):${API_PORT}/v1"
  echo "Model:     ${SERVED_MODEL_NAME} (${MODEL_FILE})"
  echo "Context:   ${CTX_SIZE}"
  echo "Runtime:   ${RUNTIME_MODE}"
}

download() {
  need curl
  mkdir -p "$MODEL_DIR"
  local i
  for i in "${!MODEL_FILES[@]}"; do
    echo "download [$(( i + 1 ))/{{ '${#MODEL_FILES[@]}' }}]: ${MODEL_URLS[$i]}"
    curl -fL --retry 5 -C - \
      ${HF_TOKEN:+-H "Authorization: Bearer $HF_TOKEN"} \
      -o "${MODEL_DIR}/${MODEL_FILES[$i]}" \
      "${MODEL_URLS[$i]}"
  done
  echo "download complete: ${MODEL_DIR} ({{ '${#MODEL_FILES[@]}' }} ไฟล์)"
}

verify_files() {
  local i path actual_size actual_sha
  for i in "${!MODEL_FILES[@]}"; do
    path="${MODEL_DIR}/${MODEL_FILES[$i]}"
    [[ -f "$path" ]] || die "ยังไม่ได้ download (ไม่พบ $path) — รัน: $0 download"

    if [[ -n "${EXPECTED_SIZES[$i]}" ]]; then
      actual_size="$(stat -c %s "$path" 2>/dev/null || stat -f %z "$path")"
      [[ "$actual_size" == "${EXPECTED_SIZES[$i]}" ]] ||
        die "${MODEL_FILES[$i]}: ขนาดไม่ตรง (ได้ ${actual_size} ต้องการ ${EXPECTED_SIZES[$i]} — download ไม่ครบ?)"
    fi

    if [[ -n "${EXPECTED_SHAS[$i]}" ]]; then
      need sha256sum
      actual_sha="$(sha256sum "$path" | awk '{print $1}')"
      [[ "$actual_sha" == "${EXPECTED_SHAS[$i]}" ]] ||
        die "${MODEL_FILES[$i]}: SHA-256 ไม่ตรง (ได้ ${actual_sha})"
    fi
  done

  local magic
  magic="$(head -c 4 "${MODEL_DIR}/${MODEL_FILE}")"
  [[ "$magic" == "GGUF" ]] || die "ไฟล์แรกไม่ใช่ GGUF (magic: ${magic})"
  echo "verify-files: OK ({{ '${#MODEL_FILES[@]}' }} ไฟล์ใน ${MODEL_DIR})"
}

install_build_dependencies() {
  # ติดตั้ง build deps ให้อัตโนมัติ — ผู้ใช้ไม่ต้องรู้ล่วงหน้าว่าต้องลงอะไร
  local missing=()
  command -v git   >/dev/null 2>&1 || missing+=(git)
  command -v cmake >/dev/null 2>&1 || missing+=(cmake)
  command -v ninja >/dev/null 2>&1 || missing+=(ninja-build)
  command -v gcc   >/dev/null 2>&1 || missing+=(build-essential)
  command -v curl  >/dev/null 2>&1 || missing+=(curl)

  if [[ {{ '${#missing[@]}' }} -gt 0 ]]; then
    if command -v apt-get >/dev/null 2>&1; then
      echo "ติดตั้ง build dependencies ที่ขาด: ${missing[*]} (ต้องใส่รหัส sudo)"
      sudo apt-get update -y
      sudo apt-get install -y "${missing[@]}"
    else
      die "ขาด dependencies: ${missing[*]} — ระบบไม่มี apt-get ต้องติดตั้งเอง"
    fi
  fi

  command -v nvcc >/dev/null 2>&1 ||
    echo "คำเตือน: ไม่พบ nvcc (CUDA Toolkit) — ถ้า build ล้มเหลว ติดตั้ง CUDA Toolkit ก่อน (DGX OS มีมาให้แล้ว)"
}

prepare_runtime() {
  # build llama.cpp จาก source — จำเป็นบน DGX Spark (ARM64/SM121 ไม่มี image ทางการ)
  install_build_dependencies
  need git; need cmake; need nvidia-smi
  mkdir -p "$(dirname "$LLAMA_CPP_DIR")" "$RUN_DIR"

  if [[ ! -d "${LLAMA_CPP_DIR}/.git" ]]; then
    echo "clone llama.cpp → ${LLAMA_CPP_DIR}"
    git clone "$LLAMA_CPP_REPO" "$LLAMA_CPP_DIR"
  fi

  local commit
  if [[ -f "$RUNTIME_LOCK" ]]; then
    commit="$(cat "$RUNTIME_LOCK")"
    echo "ใช้ commit ที่ lock ไว้: ${commit}"
  else
    git -C "$LLAMA_CPP_DIR" fetch --all --quiet
    git -C "$LLAMA_CPP_DIR" checkout --quiet "$LLAMA_CPP_REF"
    if [[ "$LLAMA_CPP_REF" == "master" ]]; then
      git -C "$LLAMA_CPP_DIR" pull --quiet
    fi
    commit="$(git -C "$LLAMA_CPP_DIR" rev-parse HEAD)"
  fi
  git -C "$LLAMA_CPP_DIR" checkout --quiet "$commit"

  echo "build (CUDA arch: ${CUDA_ARCHITECTURES}) — ใช้เวลาหลายนาที..."
  cmake -S "$LLAMA_CPP_DIR" -B "${LLAMA_CPP_DIR}/build" \
    -DGGML_CUDA=ON \
    -DGGML_NATIVE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CUDA_ARCHITECTURES="$CUDA_ARCHITECTURES"
  cmake --build "${LLAMA_CPP_DIR}/build" --config Release --target llama-server -j "$(nproc)"

  [[ -x "$LLAMA_SERVER" ]] || die "build ไม่สำเร็จ — ไม่พบ ${LLAMA_SERVER}"
  printf '%s\n' "$commit" > "$RUNTIME_LOCK"
  echo "runtime พร้อม (pinned: ${commit})"
  "$LLAMA_SERVER" --version 2>&1 || true
}

check_gpu() {
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    need nvidia-smi
    nvidia-smi -L
  else
    need docker
    local out
    out="$(docker run --rm --gpus all --entrypoint nvidia-smi "$LLAMACPP_IMAGE" -L 2>&1)" ||
      die "GPU ใน container ใช้ไม่ได้: $out"
    echo "$out"
  fi
}

server_args() {
  SERVER_ARGS=(
    -m "${MODEL_MOUNT_DIR}/${MODEL_FILE}"
    --alias "$SERVED_MODEL_NAME"
    --ctx-size "$CTX_SIZE"
    --n-gpu-layers "$N_GPU_LAYERS"
    --parallel "$PARALLEL_SEQS"
    --host "$API_HOST"
    --port "$API_PORT"
  )
  if [[ -n "$API_KEY" ]]; then SERVER_ARGS+=(--api-key "$API_KEY"); fi
{% for flag in extra_flag_pairs %}
  SERVER_ARGS+=({{ flag }})
{% endfor %}
{% if has_chat_template %}
  SERVER_ARGS+=(--jinja)
{% endif %}
}

start() {
  verify_files
  mkdir -p "$RUN_DIR"

  if [[ "$RUNTIME_MODE" == "native" ]]; then
    [[ -x "$LLAMA_SERVER" ]] || die "ยังไม่มี llama-server — รัน: $0 prepare-runtime"
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      die "เซิร์ฟเวอร์รันอยู่แล้ว (PID $(cat "$PID_FILE")) — รัน: $0 stop ก่อน"
    fi
    check_gpu >/dev/null
    MODEL_MOUNT_DIR="$MODEL_DIR"
    server_args
    nohup "$LLAMA_SERVER" "${SERVER_ARGS[@]}" >> "$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
  else
    need docker
    local existing
    existing="$(docker ps -a --filter "name=^${CONTAINER_NAME}$" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
    [[ -z "$existing" ]] || die "container ${CONTAINER_NAME} มีอยู่แล้ว — รัน: $0 stop ก่อน"
    check_gpu >/dev/null
    MODEL_MOUNT_DIR="/models"
    server_args
    docker run -d --name "$CONTAINER_NAME" \
      --network host --gpus all \
      -v "${MODEL_DIR}:/models:ro" \
      "$LLAMACPP_IMAGE" \
      "${SERVER_ARGS[@]}"
  fi

  wait_health
  echo "started: $(detect_advertise_ip):${API_PORT} (${SERVED_MODEL_NAME})"
  network_info
}

server_alive() {
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
  else
    local running
    running="$(docker ps --filter "name=^${CONTAINER_NAME}$" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
    [[ -n "$running" ]]
  fi
}

wait_health() {
  local waited=0
  echo "รอ /health (สูงสุด ${HEALTH_TIMEOUT}s — โมเดลใหญ่โหลดหลายนาที)..."
  until curl -fsS "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; do
    server_alive || die "เซิร์ฟเวอร์หยุดก่อน health ผ่าน — ดู: $0 logs"
    if (( waited >= HEALTH_TIMEOUT )); then
      echo "ยังไม่ health ภายใน ${HEALTH_TIMEOUT}s — เซิร์ฟเวอร์ยังโหลดต่ออยู่ ไม่ได้ถูกหยุด" >&2
      echo "รอต่อ:      $0 wait-health" >&2
      echo "ดูคืบหน้า:   $0 logs 100" >&2
      echo "รอบหน้ารอนานขึ้น: HEALTH_TIMEOUT=3600 $0 start" >&2
      exit 1
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done
}

stop() {
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    if [[ -f "$PID_FILE" ]]; then
      kill "$(cat "$PID_FILE")" 2>/dev/null || true
      rm -f "$PID_FILE"
    fi
  else
    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
  fi
  echo "stopped ${SERVED_MODEL_NAME}"
}

status() {
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    if server_alive; then echo "process: running (PID $(cat "$PID_FILE"))"; else echo "process: stopped"; fi
  else
    docker ps -a --filter "name=^${CONTAINER_NAME}$"
  fi
  if curl -fsS "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
    echo "API: healthy"
  else
    echo "API: not responding"
  fi
}

logs() {
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    tail -n "${1:-300}" "$LOG_FILE"
  else
    docker logs --tail "${1:-300}" "$CONTAINER_NAME"
  fi
}

client_config() {
  # llama.cpp แบ่ง --ctx-size เท่า ๆ กันให้ทุก slot (--parallel) — budget ต้องคิดจาก context ต่อ slot จริง
  local slot_context input_budget
  slot_context=$(( CTX_SIZE / PARALLEL_SEQS ))
  if [[ "$CLIENT_INPUT" == "auto" ]]; then
    input_budget=$(( slot_context - CLIENT_OUTPUT - TEMPLATE_OVERHEAD_TOKENS ))
  else
    input_budget="$CLIENT_INPUT"
  fi
  (( input_budget > 0 )) ||
    die "context ต่อ slot เล็กเกิน (${slot_context} = ${CTX_SIZE}/${PARALLEL_SEQS}) — เพิ่ม --context หรือลด PARALLEL_SEQS"
  cat <<EOF
{
  "base_url": "http://$(detect_advertise_ip):${API_PORT}/v1",
  "model": "${SERVED_MODEL_NAME}",
  "api_key": "${API_KEY:-not-required}",
  "max_input_tokens": ${input_budget},
  "max_output_tokens": ${CLIENT_OUTPUT},
  "server_context_total": ${CTX_SIZE},
  "context_per_slot": ${slot_context},
  "parallel_slots": ${PARALLEL_SEQS}
}
EOF
}

test_text() {
  curl -fsS "http://127.0.0.1:${API_PORT}/v1/chat/completions" \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} \
    -H "Content-Type: application/json" \
    -d "{
      \"model\": \"${SERVED_MODEL_NAME}\",
      \"messages\": [{\"role\": \"user\", \"content\": \"ตอบสั้น ๆ: 2+2 เท่ากับเท่าไร\"}],
      \"max_tokens\": 64
    }"
  echo ""
}

usage() {
  cat <<EOF
Usage: $0 <command> [--context N] [--port N] [--bind ADDR] [--advertise-ip ADDR]
          [--interface NAME] [--client-input N|auto] [--client-output N]

Runtime mode: ${RUNTIME_MODE} (override: RUNTIME_MODE=docker|native)

Commands:
  prepare-runtime  build llama.cpp จาก source (จำเป็นครั้งแรกในโหมด native เช่นบน DGX Spark)
  download         ดาวน์โหลดโมเดลครบทุก part (resume ได้, pin revision)
  verify-files     ตรวจทุกไฟล์: ขนาด exact + SHA-256 + GGUF magic
  start            ตรวจ GPU/ไฟล์ แล้วเปิด llama-server (รอ /health)
  stop | restart   หยุด / restart
  status           สถานะ process/container + API
  logs [N]         log ล่าสุด N บรรทัด
  client-config    ค่าตั้ง client (JSON) พร้อม token budget
  network-info     bind/endpoint ปัจจุบัน
  test-text        ทดสอบ chat completion หนึ่งครั้ง
  wait-health      รอ /health ต่อ (ใช้เมื่อ start เคย timeout แต่โมเดลยังโหลดอยู่)
EOF
}

parse_options "$@"
set -- ${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}

case "${1:-help}" in
  prepare-runtime) prepare_runtime ;;
  download)     download ;;
  verify-files) verify_files ;;
  start)        start ;;
  stop)         stop ;;
  restart)      stop; start ;;
  status)       status ;;
  logs)         logs "${2:-300}" ;;
  client-config) client_config ;;
  network-info) network_info ;;
  test-text)    test_text ;;
  wait-health)  wait_health ;;
  *)            usage ;;
esac
