#!/usr/bin/env bash
# {{ slug }} — llama.cpp single-node controller (GGUF)
# Model:    {{ plan.model_id }} @ {{ plan.revision }}
# File:     {{ plan.selected_gguf }}{% if gguf_parts|length > 1 %} (+{{ gguf_parts|length - 1 }} parts){% endif %}
# Target:   {{ fit.target_name }} | Generated by LMDS {{ lmds_version }} ({{ plan.generator }})
# Standard: dgx-spark-controllers v3.0.0 controller contract
set -Eeuo pipefail

# ============================ CONFIG (แก้ได้) ============================
SCRIPT_VERSION="${SCRIPT_VERSION:-{{ controller_version }}}"
MODEL_LABEL="${MODEL_LABEL:-{{ model_label }}}"
RUNTIME_LABEL="${RUNTIME_LABEL:-{{ runtime_label }}}"
MODEL_FEATURES="${MODEL_FEATURES:-{{ model_features }}}"
MODEL_ID="{{ plan.model_id }}"
MODEL_REVISION="{{ plan.revision }}"
# ชื่อโมเดลที่ API เสิร์ฟออกไป — ตั้งเองได้ผ่าน env เหมือน knob อื่น ๆ
# ลูกค้าที่ย้ายมาจากระบบเดิมมักต้องใช้ชื่อเดิมเป๊ะ ไม่งั้น client ทุกตัวต้องแก้ตาม
# ชื่อที่ตอน generate ตั้งให้ — ตรึงไว้ ไม่รับ override เพราะเป็นหลักฐานว่าเดิมคืออะไร
DEFAULT_SERVED_MODEL_NAME="{{ plan.served_model_name }}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-$DEFAULT_SERVED_MODEL_NAME}"

# runtime mode: docker (RTX x86_64, image ทางการ) | native (DGX Spark ARM64 — build จาก source)
RUNTIME_MODE="${RUNTIME_MODE:-{{ runtime_mode }}}"
# image เปลี่ยนผ่าน env ได้เหมือน knob อื่น ๆ — bundle ที่ image ใช้ไม่ได้ (tag ผิด/ถูกถอน)
# จะได้แก้ได้โดยไม่ต้อง deploy ใหม่ทั้งชุด · stacked ทำแบบนี้อยู่แล้ว single ตกไป
# runtime ของ bundle นี้ — ตรึงที่ digest ไม่ใช่ tag
#
# tag เคลื่อนที่ได้: `:latest` วันนี้กับเดือนหน้าเป็นคนละ image · bundle ที่ทดสอบ
# ผ่านแล้วจึงกลายเป็นคนละ runtime ได้โดยไม่มีอะไรในไฟล์นี้เปลี่ยนเลย ซึ่งเป็นอาการ
# ที่ไล่หาสาเหตุยากที่สุด เพราะ "ไม่ได้แก้อะไรสักหน่อย"
#
# tag ที่ digest นี้มาจาก ณ วันที่ generate: {{ plan.runtime.image_ref }}
# อยากใช้ตัวอื่นก็ override ได้ตามเดิม: LLAMACPP_IMAGE=<image> ./controller start
LLAMACPP_IMAGE="${{ '{' }}LLAMACPP_IMAGE:-{% if plan.runtime.image_pin %}{{ plan.runtime.image_ref.split(':')[0] }}@{{ plan.runtime.image_pin }}{% else %}{{ plan.runtime.image_ref }}{% endif %}{{ '}' }}"
LLAMA_CPP_REPO="${LLAMA_CPP_REPO:-https://github.com/ggml-org/llama.cpp.git}"
LLAMA_CPP_REF="${LLAMA_CPP_REF:-master}"
# build ที่โมเดลนี้ผูกไว้ — ไม่ใช่ build กลางของเครื่อง เว้นแต่ไม่ได้ pin ไว้
LLAMA_CPP_DIR="${{ '{' }}LLAMA_CPP_DIR:-{% if plan.runtime.native_dir %}{{ plan.runtime.native_dir }}{% else %}${{ '{' }}HOME{{ '}' }}/src/llama.cpp{% endif %}{{ '}' }}"
LLAMA_SERVER="${LLAMA_SERVER:-${LLAMA_CPP_DIR}/build/bin/llama-server}"
CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES:-{{ cuda_architectures }}}"
CONTAINER_NAME="${CONTAINER_NAME:-lmds-{{ slug }}}"

# ── ค่าที่บันทึกไว้กับ bundle นี้ (เขียนโดยหน้าเว็บ / `lmds set`) ──
# อ่านก่อน default ทั้งหมดข้างล่าง และทุกบรรทัดในไฟล์เป็นรูป ${VAR:-value} ลำดับ
# ความสำคัญจึงเป็น: flag บรรทัดคำสั่ง > env จากภายนอก > ไฟล์นี้ > ค่าของ bundle
#
# มีไฟล์นี้เพราะค่าที่ตั้งบนหน้าเว็บเคยอยู่แค่ในเบราว์เซอร์: systemd ตอน autostart
# และปุ่ม test-* เรียก controller เปล่า ๆ ทุกตัวจึงตกไปใช้ default — พอ reboot
# โมเดลทุกตัวบนเครื่องเดียวกันก็ไปชนกันที่ port เดียว
BUNDLE_ENV="${BUNDLE_ENV:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bundle.env}"
if [[ -f "$BUNDLE_ENV" ]]; then
  set -a; . "$BUNDLE_ENV"; set +a
fi

MODEL_DIR="${MODEL_DIR:-${HOME}/models/{{ slug }}}"
RUN_DIR="${RUN_DIR:-${HOME}/.lmds/run/{{ slug }}}"
PID_FILE="${RUN_DIR}/server.pid"
LOG_FILE="${RUN_DIR}/server.log"
RUNTIME_LOCK="${RUN_DIR}/runtime.lock"

# ไฟล์โมเดล (split GGUF จะมีหลาย part — ต้องครบทุกไฟล์)
MODEL_FILES=(
{% for part in gguf_parts %}  "{{ part.basename }}"
{% endfor %})
MODEL_URLS=(
{% for part in gguf_parts %}  "https://huggingface.co/{{ plan.model_id }}/resolve/{{ plan.revision }}/{{ part.filename }}"
{% endfor %})
EXPECTED_SIZES=(
{% for part in gguf_parts %}  "{{ part.size_bytes if part.size_bytes is not none else '' }}"
{% endfor %})
EXPECTED_SHAS=(
{% for part in gguf_parts %}  "{{ part.sha256 or '' }}"
{% endfor %})
MODEL_FILE="${MODEL_FILES[0]}"
{% if mmproj_basename %}# multimodal projector — อยู่ท้าย MODEL_FILES แล้ว (download/verify จึงครอบคลุมให้)
# MMPROJ_FILE="" เพื่อเสิร์ฟแบบข้อความล้วน — ใช้ ${VAR-default} ไม่ใช่ ${VAR:-default}
# ไม่งั้น bash แทนค่าว่างด้วย default แล้วปิดไม่ได้จริง (เจอตอนวัด MTP เปิด/ปิด)
MMPROJ_FILE="${MMPROJ_FILE-{{ mmproj_basename }}}"
# llama.cpp เตือนเองตอนโหลดว่า "Qwen-VL models require at minimum 1024 image tokens
# to function correctly on grounding tasks" (ggml-org/llama.cpp#16842) แล้วปล่อยผ่าน
# ไปด้วยค่าจากไฟล์ซึ่งต่ำกว่านั้น · ผลคือถามว่า "มีอะไรในภาพ" ตอบได้ แต่ถามว่า "อยู่ตรงไหน"
# เริ่มเพี้ยน — เป็นความแม่นยำที่หายไปเงียบ ๆ ไม่ใช่ error
# ตั้งว่างเพื่อใช้ค่าที่ฝังมากับโมเดลแทน
IMAGE_MIN_TOKENS="${IMAGE_MIN_TOKENS-1024}"
{% endif %}
{% if mtp_embedded and not mtp_basename %}# MTP head ฝังอยู่ในไฟล์โมเดลเอง (nextn) — ไม่มีไฟล์ให้โหลดแยก
# MTP_EMBEDDED="" เพื่อปิด speculative decoding
MTP_EMBEDDED="${MTP_EMBEDDED-1}"
{% endif %}{% if mtp_basename %}# MTP draft head — target verify ทุก token ที่ draft เสนอ output เหมือนเดิมเป๊ะ
# MTP_FILE="" เพื่อปิด speculative decoding (เหตุผลเดียวกับ MMPROJ_FILE ข้างบน)
MTP_FILE="${MTP_FILE-{{ mtp_basename }}}"
{% endif %}

CTX_SIZE="${CTX_SIZE:-{{ plan.serving.context }}}"
API_HOST="${API_HOST:-0.0.0.0}"
API_PORT="${API_PORT:-8000}"
API_KEY="${API_KEY:-}"
# env ของ engine เอง — ตั้งด้วย `lmds set <slug> --engine-env "KEY=VALUE ..."`
# llama.cpp รัน native จึง export ให้ process ตรง ๆ ไม่ต้องผ่าน docker
ENGINE_ENV="${ENGINE_ENV:-}"
if [[ -n "$ENGINE_ENV" ]]; then export ${ENGINE_ENV}; fi
ADVERTISE_IP="${ADVERTISE_IP:-}"
ADVERTISE_INTERFACE="${ADVERTISE_INTERFACE:-}"
ROUTE_PROBE_IP="${ROUTE_PROBE_IP:-1.1.1.1}"

N_GPU_LAYERS="${N_GPU_LAYERS:-{{ n_gpu_layers }}}"
PARALLEL_SEQS="${PARALLEL_SEQS:-{{ plan.serving.max_num_seqs }}}"
CLIENT_OUTPUT="${CLIENT_OUTPUT:-{{ plan.serving.max_output_tokens }}}"
CLIENT_INPUT="${CLIENT_INPUT:-auto}"
TEMPLATE_OVERHEAD_TOKENS="2048"
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-{{ health_timeout }}}"
# ========================================================================

die() { echo "ERROR: $*" >&2; exit 1; }

# พอร์ตเดียวกันรับได้ทีละเซิร์ฟเวอร์ และทุก bundle ตั้งต้นที่พอร์ตเดียวกัน — ถ้าโมเดลอื่น
# ยึดพอร์ตนี้อยู่ ชุดทดสอบจะยิงไปโดนตัวนั้นแล้ว "ผ่าน" ทั้งที่ทดสอบคนละโมเดล
# (เจอจริง: test-text ของ gemma-4-31b ได้คำตอบจาก Qwen3-Coder-30B ที่รันอยู่ก่อน)
assert_our_server() {
  local seen
  seen="$(curl -fsS -m 10 "http://127.0.0.1:${API_PORT}/v1/models" \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} 2>/dev/null \
    | { command -v python3 >/dev/null 2>&1 && python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)["data"]
except Exception:
    sys.exit(0)
print((data[0].get("id") or "").strip() if data else "")
' || cat; })" || return 0
  [ -n "$seen" ] || return 0                       # อ่านไม่ได้ = ไม่ฟันธง ปล่อยผ่าน
  [ "$seen" = "$SERVED_MODEL_NAME" ] && return 0
  die "พอร์ต ${API_PORT} ตอบมาเป็นโมเดล '${seen}' ไม่ใช่ '${SERVED_MODEL_NAME}'
     มีเซิร์ฟเวอร์อื่นยึดพอร์ตนี้อยู่ — ผลทดสอบที่ได้จะเป็นของโมเดลนั้น ไม่ใช่ตัวนี้
     แก้: หยุดตัวที่ชน หรือรันตัวนี้คนละพอร์ต  $0 restart --port 8001"
}
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

validate_numbers() {
  [[ "$API_PORT" =~ ^[0-9]+$ ]] && (( API_PORT >= 1 && API_PORT <= 65535 )) ||
    die "invalid API_PORT: $API_PORT"
  [[ "$CTX_SIZE" =~ ^[0-9]+$ ]] && (( CTX_SIZE > 0 )) ||
    die "invalid context: $CTX_SIZE"
  [[ "$CLIENT_OUTPUT" =~ ^[0-9]+$ ]] && (( CLIENT_OUTPUT > 0 )) ||
    die "invalid CLIENT_OUTPUT: $CLIENT_OUTPUT"
}

detect_advertise_ip() {
  if [[ -n "$ADVERTISE_IP" ]]; then printf '%s' "$ADVERTISE_IP"; return; fi
  if [[ -n "$ADVERTISE_INTERFACE" ]]; then
    ip -4 -o addr show dev "$ADVERTISE_INTERFACE" scope global |
      awk 'NR == 1 { split($4, a, "/"); print a[1] }'
    return
  fi
  local route_src
  route_src="$(ip -4 route get "$ROUTE_PROBE_IP" 2>/dev/null |
    awk '{ for (i=1; i<=NF; i++) if ($i=="src") { print $(i+1); exit } }')"
  if [[ -n "$route_src" ]]; then printf '%s' "$route_src"; return; fi
  hostname -I 2>/dev/null | awk '{print $1}'
}

# ค่าที่เซิร์ฟเวอร์ "ถูกสั่งไว้จริง" อยู่ใน server.meta — คำสั่งที่รันทีหลัง (status/logs/stop)
# เป็นคนละ process จึงไม่รู้เรื่องนั้นเลย แล้วไปใช้ default ในไฟล์แทน
# เจอจริง: start --port 8020 --name foo แล้ว status บอก "API: not responding" เพราะไปถาม
# port 8000 และโชว์ชื่อ default ทั้งที่เซิร์ฟเวอร์ทำงานปกติอยู่คนละ port คนละชื่อ
# ใช้เฉพาะคำสั่งที่ "มองของที่รันอยู่" — start/restart ยังยึด default + flag ตามเดิม
adopt_running_state() {
  local meta="${RUN_DIR}/server.meta" value
  [[ -f "$meta" ]] || return 0
  server_alive || return 0
  if [[ -z "${PORT_EXPLICIT:-}" ]]; then
    value="$(sed -n 's/^port=//p' "$meta" | tail -1)"
    [[ -n "$value" ]] && API_PORT="$value"
  fi
  if [[ -z "${NAME_EXPLICIT:-}" ]]; then
    value="$(sed -n 's/^model=//p' "$meta" | tail -1)"
    [[ -n "$value" ]] && SERVED_MODEL_NAME="$value"
  fi
  return 0
}

parse_options() {
  REMAINING_ARGS=()
  while (( $# )); do
    case "$1" in
      --context)        CTX_SIZE="$2"; shift 2 ;;
      --context=*)      CTX_SIZE="${1#*=}"; shift ;;
      --name)           SERVED_MODEL_NAME="$2"; NAME_EXPLICIT=1; shift 2 ;;
      --name=*)         SERVED_MODEL_NAME="${1#*=}"; NAME_EXPLICIT=1; shift ;;
      --port)           API_PORT="$2"; PORT_EXPLICIT=1; shift 2 ;;
      --port=*)         API_PORT="${1#*=}"; PORT_EXPLICIT=1; shift ;;
      --bind)           API_HOST="$2"; shift 2 ;;
      --bind=*)         API_HOST="${1#*=}"; shift ;;
      --advertise-ip)   ADVERTISE_IP="$2"; shift 2 ;;
      --advertise-ip=*) ADVERTISE_IP="${1#*=}"; shift ;;
      --interface)      ADVERTISE_INTERFACE="$2"; shift 2 ;;
      --interface=*)    ADVERTISE_INTERFACE="${1#*=}"; shift ;;
      --client-input)   CLIENT_INPUT="$2"; shift 2 ;;
      --client-input=*) CLIENT_INPUT="${1#*=}"; shift ;;
      --client-output)  CLIENT_OUTPUT="$2"; shift 2 ;;
      --client-output=*) CLIENT_OUTPUT="${1#*=}"; shift ;;
{% if mmproj_basename %}      --mmproj)         MMPROJ_FILE="$2"; shift 2 ;;
      --image-min-tokens)   IMAGE_MIN_TOKENS="$2"; shift 2 ;;
      --image-min-tokens=*) IMAGE_MIN_TOKENS="${1#*=}"; shift ;;
      --mmproj=*)       MMPROJ_FILE="${1#*=}"; shift ;;
      --no-mmproj)      MMPROJ_FILE=""; shift ;;
{% endif %}{% if mtp_basename %}      --mtp)            MTP_FILE="$2"; shift 2 ;;
      --mtp=*)          MTP_FILE="${1#*=}"; shift ;;
      --no-mtp)         MTP_FILE=""; shift ;;
{% endif %}{% if mtp_embedded and not mtp_basename %}      --no-mtp)         MTP_EMBEDDED=""; shift ;;
      --mtp)            MTP_EMBEDDED=1; shift ;;
{% endif %}      *) REMAINING_ARGS+=("$1"); shift ;;
    esac
  done
  validate_numbers
}

network_info() {
  echo "Bind:      ${API_HOST}:${API_PORT}"
  echo "Endpoint:  http://$(detect_advertise_ip):${API_PORT}/v1"
  if [[ "$SERVED_MODEL_NAME" != "$DEFAULT_SERVED_MODEL_NAME" ]]; then
    echo "Model:     ${SERVED_MODEL_NAME} (${MODEL_FILE})"
    echo "           ↳ เปลี่ยนจากชื่อเดิม: ${DEFAULT_SERVED_MODEL_NAME}"
  else
    echo "Model:     ${SERVED_MODEL_NAME} (${MODEL_FILE})"
  fi
  echo "Context:   ${CTX_SIZE}"
  echo "Runtime:   ${RUNTIME_MODE}"
}

# ขนาดไฟล์เป็นไบต์ · GNU กับ BSD ใช้คนละ flag และ DGX OS/Ubuntu เป็น GNU แต่เครื่อง
# ที่รันเทสอาจเป็น macOS — ถามทั้งสองแบบแล้วค่อยยอมแพ้เป็น 0 (ไฟล์ยังไม่มี)
file_size() {
  stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null || echo 0
}

download() {
  need curl
{% if report.gated %}  # gated repo: ไม่มี token = ดาวน์โหลดล้มด้วย 401 ที่อ่านยาก — ตรวจตั้งแต่ต้นดีกว่า
  if [[ -z "${HF_TOKEN:-}" ]]; then
    die "${MODEL_ID} เป็น gated repo — ต้องมี HF_TOKEN ก่อน download
  1) ขอสิทธิ์ที่ https://huggingface.co/${MODEL_ID} (ต้องขึ้น ACCEPTED)
  2) สร้าง token ที่ https://huggingface.co/settings/tokens
  3) export HF_TOKEN=hf_xxx   แล้วรันใหม่: $0 download
หมายเหตุ: token ไม่ได้ถูกเก็บไว้ในสคริปต์นี้โดยเจตนา (กัน secret หลุดไปกับ bundle)"
  fi
{% endif %}  mkdir -p "$MODEL_DIR"
  local i have
  for i in "${!MODEL_FILES[@]}"; do
    echo "download [$(( i + 1 ))/{{ '${#MODEL_FILES[@]}' }}]: ${MODEL_URLS[$i]}"
    # ของที่ค้างไว้ใหญ่กว่าที่ควรเป็น = เสียแน่นอน · resume ต่อมีแต่ทำให้ใหญ่ขึ้นอีก
    # ลบทิ้งก่อนโหลดใหม่ ดีกว่าปล่อยให้ verify ตกทุกครั้งจนกว่าจะมีคนสังเกตเอง
    if [[ -n "${EXPECTED_SIZES[$i]:-}" && -f "${MODEL_DIR}/${MODEL_FILES[$i]}" ]]; then
      have="$(file_size "${MODEL_DIR}/${MODEL_FILES[$i]}")"
      if (( have > ${EXPECTED_SIZES[$i]} )); then
        echo "  ของเดิมใหญ่เกิน (${have} > ${EXPECTED_SIZES[$i]}) — ลบแล้วโหลดใหม่"
        rm -f "${MODEL_DIR}/${MODEL_FILES[$i]}"
      fi
    fi
    fetch_one "${MODEL_URLS[$i]}" "${MODEL_DIR}/${MODEL_FILES[$i]}" "${EXPECTED_SIZES[$i]:-}"
  done
  echo "download complete: ${MODEL_DIR} ({{ '${#MODEL_FILES[@]}' }} ไฟล์)"
}

# ดึงหนึ่งไฟล์ *ให้ครบตามขนาดจริง* · ใช้ aria2c ถ้ามี (เปิดหลาย connection พร้อมกัน)
# ไม่งั้นถอยไป curl
#
# ทำไมต้องมีลูป ไม่ใช่ยิงครั้งเดียวแล้วเชื่อ exit code:
#
#   เคสจริง 2026-08-28 บน msi-5 · ไฟล์ 20.3GB หลุดที่ 3,967MB ด้วย
#   `curl: (92) HTTP/2 stream 1 was not closed cleanly: CANCEL (err 8)`
#   — CDN ของ HF ตัดสตรีมกลางคันเมื่อโหลดยาว ๆ · `--retry` ของ curl **ไม่ยิงซ้ำ**
#   ให้ เพราะ curl นับ transient error แค่ timeout / 408 / 429 / 5xx เท่านั้น
#   error 92 ไม่อยู่ในชุดนั้น curl จึงจบทันทีโดยเหลือไฟล์ที่ถูกตัดครึ่งไว้เฉย ๆ
#   ต้องมี --retry-all-errors ถึงจะครอบเคสนี้
#
# และต่อให้ curl คืน 0 ก็ยังเชื่อไม่ได้ — proxy/CDN ที่ส่ง body สั้นกว่าจริงแต่ปิด
# สตรีมเรียบร้อยจะได้ exit 0 พร้อมไฟล์ไม่ครบ · เทียบขนาดหลังดึงทุกครั้งจึงเป็น
# เงื่อนไขจบที่แท้จริง ไม่ใช่ exit code
#
# CDN บางเจ้า (เจอจริงกับ bartowski) ยัง throttle ต่อ connection เหลือ ~150KB/s
# ทั้งที่เครื่องมีแบนด์วิดท์เหลือ — aria2c -x16 เปิด 16 ช่องขนานจึงเลี่ยงได้
# ทั้งคู่ resume ได้ (-C - / --continue) รอบถัดไปจึงต่อจากของเดิม ไม่เริ่มใหม่
FETCH_MAX_ATTEMPTS="${FETCH_MAX_ATTEMPTS:-20}"

# --retry-all-errors มีตั้งแต่ curl 7.71 (2020) · Ubuntu 20.04 มากับ 7.68 ซึ่งไม่มี
# แล้ว curl จะตายทันทีด้วย "option --retry-all-errors: is unknown" — ถามก่อนใช้
# ดีกว่าเดาจากเลขเวอร์ชัน เพราะ distro แก้ patch ย้อนหลังกันบ่อย
curl_retry_all() {
  if [[ -z "${_CURL_RETRY_ALL+x}" ]]; then
    # เทียบด้วย case ไม่ใช่ท่อไปหา grep เพราะ grep ที่ออกก่อนทำให้ curl โดน SIGPIPE
    # ใต้ `set -o pipefail` ทั้ง pipeline จึงคืนค่าไม่เป็นศูนย์แบบสุ่ม ๆ
    case "$(curl --help all 2>/dev/null)" in
      *--retry-all-errors*) _CURL_RETRY_ALL="--retry-all-errors" ;;
      *)                    _CURL_RETRY_ALL="" ;;
    esac
  fi
  printf '%s' "$_CURL_RETRY_ALL"
}

fetch_one() {
  local url="$1" out="$2" want="${3:-}"
  local attempt=0 rc have prev=-1

  while :; do
    attempt=$(( attempt + 1 ))
    rc=1
    if command -v aria2c >/dev/null 2>&1; then
      rc=0
      aria2c -x16 -s16 -k1M --continue=true --file-allocation=none \
        --connect-timeout=20 --timeout=60 --max-tries=5 --retry-wait=5 \
        --lowest-speed-limit=10K \
        ${HF_TOKEN:+--header="Authorization: Bearer $HF_TOKEN"} \
        -d "$(dirname "$out")" -o "$(basename "$out")" "$url" || rc=$?
      (( rc == 0 )) || echo "  aria2c ล้ม (exit ${rc}) — ถอยไป curl"
    fi
    if (( rc != 0 )); then
      # --speed-limit/--speed-time = กันค้างตาย: สลับเน็ต/สาย NAT หลุด ทำให้ TCP
      # ค้างใน recv() ไม่มี error ไม่มี timeout --retry จึงไม่เคยทำงาน — process
      # ค้างถาวรจน stop ไม่ได้ · ต่ำกว่า 10KB/s ติดกัน 60s = ถือว่าตาย ยิง error
      # ให้ --retry ทำงาน แล้ว -C - resume ต่อ
      rc=0
      curl -fL --retry 5 --retry-delay 5 $(curl_retry_all) -C - \
        --connect-timeout 20 --speed-limit 10240 --speed-time 60 \
        ${HF_TOKEN:+-H "Authorization: Bearer $HF_TOKEN"} \
        -o "$out" "$url" || rc=$?
      (( rc == 0 )) || echo "  curl ล้ม (exit ${rc})"
    fi

    have="$(file_size "$out")"

    # ไม่รู้ขนาดที่ควรได้ (HF ไม่บอก) → เชื่อ exit code อย่างเดียวเท่าที่ทำได้
    if [[ -z "$want" ]]; then
      (( rc == 0 )) && return 0
      die "ดึงไฟล์ไม่สำเร็จ (exit ${rc}): ${url}"
    fi

    # ใหญ่เกินก็จบลูป — verify_files เป็นคนบอกวิธีแก้ (ลบแล้วโหลดใหม่) ไม่ใช่ที่นี่
    (( have >= want )) && return 0

    if (( attempt >= FETCH_MAX_ATTEMPTS )); then
      die "$(basename "$out"): ลองต่อ ${attempt} รอบแล้วยังไม่ครบ (${have}/${want})
โหลดต่อได้เลย (resume ต่อจากของเดิม):  $0 download"
    fi
    if (( have <= prev )); then
      die "$(basename "$out"): resume แล้วไม่คืบหน้าเลย (ค้างที่ ${have}/${want})
เน็ตหลุด หรือฝั่งต้นทางไม่รองรับ resume — ตรวจเน็ตแล้วรันใหม่:  $0 download"
    fi
    prev="$have"
    echo "  หลุดกลางคัน ${have}/${want} ไบต์ — resume ต่อ (รอบที่ $(( attempt + 1 )))"
    sleep 5
  done
}

verify_files() {
  local i path actual_size actual_sha
  for i in "${!MODEL_FILES[@]}"; do
    path="${MODEL_DIR}/${MODEL_FILES[$i]}"
    [[ -f "$path" ]] || die "ยังไม่ได้ download (ไม่พบ $path) — รัน: $0 download"

    if [[ -n "${EXPECTED_SIZES[$i]}" ]]; then
      actual_size="$(file_size "$path")"
      if [[ "$actual_size" != "${EXPECTED_SIZES[$i]}" ]]; then
        # ใหญ่เกิน กับ เล็กเกิน ต้องแก้คนละทาง — บอกผิดแล้วผู้ใช้ไปวนอยู่กับคำสั่งที่ไม่ช่วย
        #
        # เคสจริง 2026-08-20 บน msi-5: ไฟล์ Q8_0 ได้มา 30,800,274,816 ไบต์ แต่ต้องการ
        # 29,047,084,416 (เกินมา 1.75 GB) เพราะ resume ทับของเดิมที่ค้างจากรอบก่อน
        # ข้อความเดิมบอกว่า "download ไม่ครบ?" ซึ่งพาไปสั่ง repair ซ้ำ — แต่ resume
        # มีแต่ทำให้ไฟล์ใหญ่ขึ้น มันจึงไม่มีวันลงตัว
        if (( actual_size > ${EXPECTED_SIZES[$i]} )); then
          die "${MODEL_FILES[$i]}: ไฟล์ใหญ่เกินจริง (ได้ ${actual_size} ต้องการ ${EXPECTED_SIZES[$i]})
ไฟล์เสีย — มักเกิดจาก resume ทับของที่ค้างจากรอบก่อน · resume ซ้ำไม่ช่วยเพราะมีแต่ทำให้ใหญ่ขึ้น
ลบแล้วโหลดใหม่:  rm -f '$path'  แล้วรัน  $0 download"
        fi
        die "${MODEL_FILES[$i]}: ขนาดไม่ตรง (ได้ ${actual_size} ต้องการ ${EXPECTED_SIZES[$i]} — download ไม่ครบ)
โหลดต่อได้เลย (resume):  $0 download"
      fi
    fi

    if [[ -n "${EXPECTED_SHAS[$i]}" ]]; then
      need sha256sum
      actual_sha="$(sha256sum "$path" | awk '{print $1}')"
      [[ "$actual_sha" == "${EXPECTED_SHAS[$i]}" ]] ||
        die "${MODEL_FILES[$i]}: SHA-256 ไม่ตรง (ได้ ${actual_sha})"
    fi
  done

  local magic
  magic="$(head -c 4 "${MODEL_DIR}/${MODEL_FILE}")"
  [[ "$magic" == "GGUF" ]] || die "ไฟล์แรกไม่ใช่ GGUF (magic: ${magic})"
  echo "verify-files: OK ({{ '${#MODEL_FILES[@]}' }} ไฟล์ใน ${MODEL_DIR})"
}

find_cuda_toolkit() {
  # DGX OS ลง CUDA ไว้ที่ /usr/local/cuda แต่ไม่ได้ใส่ใน PATH ของ shell ที่ไม่ใช่ login
  # (เช่นที่ hub เรียกผ่าน SSH) `command -v nvcc` จึงไม่เจอทั้งที่ toolkit อยู่ครบ
  # แล้วเราไปเตือนว่า "ไม่พบ CUDA" ก่อนจะไป build ล้มอีกทีตอน cmake — ทั้งที่แค่ต้องหาให้เจอ
  command -v nvcc >/dev/null 2>&1 && return 0
  local dir
  for dir in /usr/local/cuda/bin /usr/local/cuda-*/bin; do
    if [[ -x "${dir}/nvcc" ]]; then
      export PATH="${dir}:${PATH}"
      echo "พบ CUDA toolkit ที่ ${dir} — เพิ่มเข้า PATH ให้แล้ว"
      return 0
    fi
  done
  return 1
}

install_build_dependencies() {
  # ติดตั้ง build deps ให้อัตโนมัติ — ผู้ใช้ไม่ต้องรู้ล่วงหน้าว่าต้องลงอะไร
  #
  # ninja ไม่อยู่ในลิสต์นี้: cmake ถอยไปใช้ Unix Makefiles ได้เองเมื่อไม่มี ninja
  # การใส่มันไว้ทำให้เครื่องที่มีของครบทุกอย่างแล้วยังต้องไปขอ sudo เพื่อลง generator
  # ที่ไม่ได้จำเป็น แล้วตายทันทีบนเครื่องที่ sudo ขอรหัส (ซึ่งคือค่าปกติของ Ubuntu)
  # — เจอจริงบน msi-4 2026-08-15: ขาดแค่ ninja ทั้งที่ build ได้อยู่แล้ว
  local missing=()
  command -v git   >/dev/null 2>&1 || missing+=(git)
  command -v cmake >/dev/null 2>&1 || missing+=(cmake)
  command -v gcc   >/dev/null 2>&1 || missing+=(build-essential)
  command -v curl  >/dev/null 2>&1 || missing+=(curl)

  if [[ {{ '${#missing[@]}' }} -gt 0 ]]; then
    if ! command -v apt-get >/dev/null 2>&1; then
      die "ขาด dependencies: ${missing[*]} — ระบบไม่มี apt-get ต้องติดตั้งเอง"
    fi
    echo "ติดตั้ง build dependencies ที่ขาด: ${missing[*]}"
    # -n = ไม่ขอรหัสผ่าน · ถ้าเครื่องนี้ต้องใส่รหัส บอกคำสั่งที่ต้องรันไปตรง ๆ
    # ดีกว่าปล่อยให้ sudo ตายพร้อมข้อความ "a terminal is required" ที่ไม่ได้บอกว่าทำอะไรต่อ
    if ! sudo -n true 2>/dev/null; then
      die "ต้องติดตั้ง ${missing[*]} แต่ sudo บนเครื่องนี้ขอรหัสผ่าน — รันคำสั่งนี้เองก่อน:
  sudo apt-get update -y && sudo apt-get install -y ${missing[*]}"
    fi
    sudo apt-get update -y
    sudo apt-get install -y "${missing[@]}"
  fi

  find_cuda_toolkit ||
    echo "คำเตือน: ไม่พบ nvcc (CUDA Toolkit) — ถ้า build ล้มเหลว ติดตั้ง CUDA Toolkit ก่อน (DGX OS มีมาให้แล้ว)"
}

prepare_runtime() {
  # build llama.cpp จาก source — จำเป็นบน DGX Spark (ARM64/SM121 ไม่มี image ทางการ)
  install_build_dependencies
  need git; need cmake; need nvidia-smi
  mkdir -p "$(dirname "$LLAMA_CPP_DIR")" "$RUN_DIR"

  if [[ ! -d "${LLAMA_CPP_DIR}/.git" ]]; then
    echo "clone llama.cpp → ${LLAMA_CPP_DIR}"
    git clone "$LLAMA_CPP_REPO" "$LLAMA_CPP_DIR"
  fi

  local commit
  if [[ -f "$RUNTIME_LOCK" ]]; then
    commit="$(cat "$RUNTIME_LOCK")"
    echo "ใช้ commit ที่ lock ไว้: ${commit}"
  else
    git -C "$LLAMA_CPP_DIR" fetch --all --quiet
    git -C "$LLAMA_CPP_DIR" checkout --quiet "$LLAMA_CPP_REF"
    if [[ "$LLAMA_CPP_REF" == "master" ]]; then
      git -C "$LLAMA_CPP_DIR" pull --quiet
    fi
    commit="$(git -C "$LLAMA_CPP_DIR" rev-parse HEAD)"
  fi
  git -C "$LLAMA_CPP_DIR" checkout --quiet "$commit"

  echo "build (CUDA arch: ${CUDA_ARCHITECTURES}) — ใช้เวลาหลายนาที..."
  cmake -S "$LLAMA_CPP_DIR" -B "${LLAMA_CPP_DIR}/build" \
    -DGGML_CUDA=ON \
    -DGGML_NATIVE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CUDA_ARCHITECTURES="$CUDA_ARCHITECTURES"
  cmake --build "${LLAMA_CPP_DIR}/build" --config Release --target llama-server -j "$(nproc)"

  [[ -x "$LLAMA_SERVER" ]] || die "build ไม่สำเร็จ — ไม่พบ ${LLAMA_SERVER}"
  printf '%s\n' "$commit" > "$RUNTIME_LOCK"
  echo "runtime พร้อม (pinned: ${commit})"
  "$LLAMA_SERVER" --version 2>&1 || true
}

check_gpu() {
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    need nvidia-smi
    nvidia-smi -L
  else
    need docker
    local out
    out="$(docker run --rm --gpus all --entrypoint nvidia-smi "$LLAMACPP_IMAGE" -L 2>&1)" ||
      die "GPU ใน container ใช้ไม่ได้: $out"
    echo "$out"
  fi
}

server_args() {
  SERVER_ARGS=(
    -m "${MODEL_MOUNT_DIR}/${MODEL_FILE}"
    --alias "$SERVED_MODEL_NAME"
    --ctx-size "$CTX_SIZE"
    --n-gpu-layers "$N_GPU_LAYERS"
    --parallel "$PARALLEL_SEQS"
    --host "$API_HOST"
    --port "$API_PORT"
  )
  if [[ -n "$API_KEY" ]]; then SERVER_ARGS+=(--api-key "$API_KEY"); fi
{% if mmproj_basename %}  # ไม่มีบรรทัดนี้ = llama-server รับแต่ข้อความ ทั้งที่โมเดลมองภาพได้ (พังเงียบ ไม่มี error)
  if [[ -n "$MMPROJ_FILE" ]]; then
    SERVER_ARGS+=(--mmproj "${MODEL_MOUNT_DIR}/${MMPROJ_FILE}")
    if [[ -n "$IMAGE_MIN_TOKENS" ]]; then
      SERVER_ARGS+=(--image-min-tokens "$IMAGE_MIN_TOKENS")
    fi
  fi
{% endif %}
{% if mtp_basename %}  # ไม่มีบล็อกนี้ = ไม่มี speculative decoding เสียความเร็วที่ repo ทำมาให้ฟรี ๆ
  if [[ -n "$MTP_FILE" && -f "${MODEL_DIR}/${MTP_FILE}" ]]; then
    SERVER_ARGS+=(--spec-draft-model "${MODEL_MOUNT_DIR}/${MTP_FILE}" --spec-type draft-mtp)
  fi
{% endif %}{% if mtp_embedded and not mtp_basename %}  # head อยู่ในไฟล์แล้ว — ส่งแค่ flag ไม่มี --spec-draft-model
  if [[ -n "$MTP_EMBEDDED" ]]; then
    SERVER_ARGS+=(--spec-type draft-mtp)
  fi
{% endif %}
{% for flag in extra_flag_pairs %}
  SERVER_ARGS+=({{ flag }})
{% endfor %}
{% if has_chat_template %}
  SERVER_ARGS+=(--jinja)
{% endif %}
}

write_meta() {
  # ลงทะเบียนกับ lmds fleet (~/.lmds/run) — ให้ lmds ps/stop/logs เห็นเซิร์ฟเวอร์ตัวนี้
  mkdir -p "$RUN_DIR"
  local script_path
  script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  cat > "${RUN_DIR}/server.meta" <<EOF
slug={{ slug }}
model=${SERVED_MODEL_NAME}
default_model=${DEFAULT_SERVED_MODEL_NAME}
model_id=${MODEL_ID}
engine=llamacpp
mode=${RUNTIME_MODE}
port=${API_PORT}
container=${CONTAINER_NAME}
pid_file=${PID_FILE}
controller=${script_path}
started_at=$(date +%Y-%m-%dT%H:%M:%S)
EOF
}

ensure_image() {
  # ดึง image ให้เห็นความคืบหน้า *ก่อน* จะเอาไปใช้ที่อื่น
  #
  # เดิม image ที่ยังไม่มีถูกดึงเงียบ ๆ ระหว่าง `docker run` ที่ผลถูกเก็บเข้าตัวแปร
  # (`out="$(docker run ... 2>&1)"`) — progress bar ของ docker จึงหายเข้าไปในตัวแปร
  # ผู้ใช้เห็นแค่บรรทัดสุดท้ายค้างอยู่หลายสิบนาที แยกไม่ออกว่ากำลังโหลดหรือค้างไปแล้ว
  # (image พวกนี้ 20-30 GB · เจอจริงกับ avarok/dgx-vllm-nvfp4-kernel)
  local image="$1"
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  echo "ดึง image ${image} (ยังไม่มีในเครื่อง — ขนาดหลาย GB ใช้เวลาสักครู่)…"
  docker pull "$image" || die "ดึง image ${image} ไม่สำเร็จ"
}

check_port_free() {
  # ไม่เลือก port ให้ — ผู้ใช้เป็นคนกำหนด (เครื่องเดียวรัน llama.cpp ได้หลายตัว)
  # แต่ห้าม start ทับของคนอื่นเด็ดขาด เพราะ wait_health ยิง /health ที่ port นี้
  # แล้ว "โมเดลตัวที่ยึด port อยู่" จะตอบ 200 ให้ → รายงานว่า start สำเร็จ
  # ทั้งที่ตัวเราไม่ได้ขึ้นเลย แล้วทุกคนก็คุยกับโมเดลผิดตัวโดยไม่รู้
  #
  # เคสจริง 2026-08-13 บน dgx-veerasiam: gemma กับ qwen ใช้ default port เดียวกัน
  #
  # ตรวจด้วย /dev/tcp ของ bash เอง ไม่เรียก awk/lsof — เวอร์ชันแรกของฟังก์ชันนี้ใช้
  # awk แล้ว $4 กับ $NF ของ awk ไปชนกับ positional parameter ของ bash เข้า
  # set -u จึงตายที่ "unbound variable" ตอนผู้ใช้กด start (bash -n ไม่จับให้ เพราะ
  # เป็นเรื่องตอนรัน ไม่ใช่ syntax)
  local holder=""
  if ! (exec 3<>"/dev/tcp/127.0.0.1/${API_PORT}") 2>/dev/null; then
    return 0
  fi
  # มีคนฟังอยู่จริง — พยายามบอกว่าใคร ถ้าบอกไม่ได้ก็ยังต้องหยุดอยู่ดี
  holder="$(ss -ltnp 2>/dev/null | grep ":${API_PORT} " || true)"
  holder="$(printf "%s" "$holder" | head -1)"
  die "port ${API_PORT} ถูกใช้อยู่แล้ว${holder:+ — ${holder}}
     เครื่องนี้รัน llama.cpp ได้หลายตัว แต่ต้องคนละ port
     เลือก port อื่น:  $0 start --port <PORT>
     หรือดูว่าใครถืออยู่: ss -ltnp | grep :${API_PORT}"
}

start() {
  verify_files
  mkdir -p "$RUN_DIR"
  check_port_free

  if [[ "$RUNTIME_MODE" == "native" ]]; then
    [[ -x "$LLAMA_SERVER" ]] || die "ยังไม่มี llama-server — รัน: $0 prepare-runtime"
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      die "เซิร์ฟเวอร์รันอยู่แล้ว (PID $(cat "$PID_FILE")) — รัน: $0 stop ก่อน"
    fi
    check_gpu >/dev/null
    MODEL_MOUNT_DIR="$MODEL_DIR"
    server_args
    nohup "$LLAMA_SERVER" "${SERVER_ARGS[@]}" >> "$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
  else
    need docker
    ensure_image "${LLAMACPP_IMAGE}"
    # ซากจากรอบก่อนไม่ใช่ของที่กำลังทำงาน — เก็บกวาดเองแล้วไปต่อ (ดูเหตุผลใน vllm controller)
    local running_now
    running_now="$(docker ps --filter "name=^${CONTAINER_NAME}$" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
    [[ -z "$running_now" ]] || die "container ${CONTAINER_NAME} กำลังรันอยู่ — รัน: $0 stop ก่อน"
    local leftover
    leftover="$(docker ps -a --filter "name=^${CONTAINER_NAME}$" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
    if [[ -n "$leftover" ]]; then
      echo "เก็บซาก container จากรอบก่อน (${CONTAINER_NAME}) แล้วเริ่มใหม่"
      docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    fi
    check_gpu >/dev/null
    MODEL_MOUNT_DIR="/models"
    server_args
    docker run -d --name "$CONTAINER_NAME" \
      --network host --gpus all \
      -v "${MODEL_DIR}:/models:ro" \
      "$LLAMACPP_IMAGE" \
      "${SERVER_ARGS[@]}"
  fi

  write_meta
  wait_health
  echo "started: $(detect_advertise_ip):${API_PORT} (${SERVED_MODEL_NAME})"
  warn_open_endpoint
  network_info
}

warn_open_endpoint() {
  # bind 0.0.0.0 + ไม่มี key = ใครก็ตามในวง network ยิง API ได้โดยไม่ต้องยืนยันตัวตน
  [[ "$API_HOST" == "0.0.0.0" && -z "$API_KEY" ]] || return 0
  echo "คำเตือน: เปิดให้ทั้งวง network เข้าถึงได้โดยไม่มี API key" >&2
  echo "         ใช้เฉพาะในเครื่อง: $0 restart --bind 127.0.0.1" >&2
  echo "         หรือบังคับ token:  API_KEY=\$(openssl rand -hex 24) $0 restart" >&2
}

server_alive() {
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
  else
    local running
    running="$(docker ps --filter "name=^${CONTAINER_NAME}$" --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null || true)"
    [[ -n "$running" ]]
  fi
}

wait_health() {
  local waited=0
  echo "รอ /health (สูงสุด ${HEALTH_TIMEOUT}s — โมเดลใหญ่โหลดหลายนาที)..."
  until curl -fsS "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; do
    server_alive || die "เซิร์ฟเวอร์หยุดก่อน health ผ่าน — ดู: $0 logs"
    if (( waited >= HEALTH_TIMEOUT )); then
      echo "ยังไม่ health ภายใน ${HEALTH_TIMEOUT}s — เซิร์ฟเวอร์ยังโหลดต่ออยู่ ไม่ได้ถูกหยุด" >&2
      echo "รอต่อ:      $0 wait-health" >&2
      echo "ดูคืบหน้า:   $0 logs 100" >&2
      echo "รอบหน้ารอนานขึ้น: HEALTH_TIMEOUT=3600 $0 start" >&2
      exit 1
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done
}

stop() {
  # รายงานตามความจริง — เดิมพิมพ์ "stopped" เสมอแม้ไม่มีอะไรรันอยู่เลย
  # ซึ่งอันตรายเงียบ ๆ: ถ้า PID/ชื่อ container เพี้ยน ผู้ใช้จะเชื่อว่าหยุดแล้วทั้งที่ยังรันอยู่
  local stopped=0
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    if [[ -f "$PID_FILE" ]] && kill "$(cat "$PID_FILE")" 2>/dev/null; then
      stopped=1
    fi
    rm -f "$PID_FILE"
  elif docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1; then
    stopped=1
  fi

  if (( stopped )); then
    echo "stopped ${SERVED_MODEL_NAME}"
  else
    echo "ไม่มีอะไรให้หยุด (${SERVED_MODEL_NAME} ไม่ได้รันอยู่)"
  fi
}

status() {
  echo "model:     ${SERVED_MODEL_NAME}$([[ "$SERVED_MODEL_NAME" != "$DEFAULT_SERVED_MODEL_NAME" ]] \
        && echo "   (ชื่อเดิม: ${DEFAULT_SERVED_MODEL_NAME})")"
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    if server_alive; then echo "process: running (PID $(cat "$PID_FILE"))"; else echo "process: stopped"; fi
  else
    docker ps -a --filter "name=^${CONTAINER_NAME}$"
  fi
  if curl -fsS "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
    echo "API: healthy"
  else
    echo "API: not responding"
  fi
}

logs() {
  if [[ "$RUNTIME_MODE" == "native" ]]; then
    tail -n "${1:-300}" "$LOG_FILE"
  else
    docker logs --tail "${1:-300}" "$CONTAINER_NAME"
  fi
}

client_config() {
  # llama.cpp แบ่ง --ctx-size เท่า ๆ กันให้ทุก slot (--parallel) — budget ต้องคิดจาก context ต่อ slot จริง
  local slot_context input_budget
  slot_context=$(( CTX_SIZE / PARALLEL_SEQS ))
  if [[ "$CLIENT_INPUT" == "auto" ]]; then
    input_budget=$(( slot_context - CLIENT_OUTPUT - TEMPLATE_OVERHEAD_TOKENS ))
  else
    input_budget="$CLIENT_INPUT"
  fi
  (( input_budget > 0 )) ||
    die "context ต่อ slot เล็กเกิน (${slot_context} = ${CTX_SIZE}/${PARALLEL_SEQS}) — เพิ่ม --context หรือลด PARALLEL_SEQS"
  cat <<EOF
{
  "base_url": "http://$(detect_advertise_ip):${API_PORT}/v1",
  "model": "${SERVED_MODEL_NAME}",
  "api_key": "${API_KEY:-not-required}",
  "max_input_tokens": ${input_budget},
  "max_output_tokens": ${CLIENT_OUTPUT},
  "server_context_total": ${CTX_SIZE},
  "context_per_slot": ${slot_context},
  "parallel_slots": ${PARALLEL_SEQS}
}
EOF
}

{% if mmproj_basename %}
# ทดสอบว่า vision ใช้ได้จริง ไม่ใช่แค่ไฟล์ mmproj มาครบ — สร้าง PNG สีแดงล้วนแล้วถามโมเดลว่าเห็นสีอะไร
# ใช้ python3 stdlib ล้วน ไม่ต้องมีรูปในเครื่องและไม่ต้องต่อเน็ต
test_vision() {
  assert_our_server
  need curl
  command -v python3 >/dev/null 2>&1 || die "ต้องมี python3 เพื่อสร้างภาพทดสอบ"
  python3 - "$API_PORT" "$SERVED_MODEL_NAME" "${API_KEY:-}" <<'PYEOF'
import base64, json, struct, sys, urllib.error, urllib.request, zlib

port, model, api_key = int(sys.argv[1]), sys.argv[2], sys.argv[3]

def png(width, height, rgb):
    raw = b"".join(b"\x00" + bytes(rgb) * width for _ in range(height))
    def chunk(tag, data):
        body = tag + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body))
    return (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))

data_uri = "data:image/png;base64," + base64.b64encode(png(64, 64, (220, 20, 20))).decode()
payload = json.dumps({
    "model": model, "max_tokens": 512,
    "messages": [{"role": "user", "content": [
        {"type": "text", "text": "What single colour fills this image? Answer in one word."},
        {"type": "image_url", "image_url": {"url": data_uri}}]}],
}).encode()
headers = {"Content-Type": "application/json"}
if api_key:
    headers["Authorization"] = "Bearer " + api_key

try:
    with urllib.request.urlopen(urllib.request.Request(
            f"http://127.0.0.1:{port}/v1/chat/completions", data=payload, headers=headers),
            timeout=300) as response:
        body = json.load(response)
except urllib.error.HTTPError as exc:
    detail = exc.read().decode()[:300]
    print(f"FAIL: HTTP {exc.code} — {detail}")
    print("ถ้าขึ้นว่าไม่รองรับ image แปลว่า --mmproj ไม่ได้ถูกโหลด (ตรวจด้วย: logs 200)")
    sys.exit(1)

message = body["choices"][0]["message"]
answer = (message.get("content") or "").strip()
if not answer and (message.get("reasoning_content") or "").strip():
    print("WARN: โมเดลตอบแต่ยังคิดไม่จบใน 512 tokens")
    sys.exit(0)
if "red" in answer.lower() or "แดง" in answer:
    print(f"PASS: โมเดลเห็นภาพและตอบถูก — {answer[:120]}")
else:
    print(f"FAIL: ตอบว่า '{answer[:120]}' (ภาพเป็นสีแดงล้วน)")
    sys.exit(1)
PYEOF
}
{% endif %}

test_text() {
  assert_our_server
  # 512 ไม่ใช่ 64: โมเดลสาย reasoning (gemma-4, Qwen3 thinking ฯลฯ) ใช้ budget ไปกับ
  # reasoning_content ก่อน ถ้าให้น้อยจะได้ content ว่างเปล่า + finish_reason "length"
  # ซึ่งดูเหมือนโมเดลพัง ทั้งที่จริงแค่พื้นที่ตอบไม่พอ
  local response
  response="$(curl -fsS "http://127.0.0.1:${API_PORT}/v1/chat/completions" \
    ${API_KEY:+-H "Authorization: Bearer $API_KEY"} \
    -H "Content-Type: application/json" \
    -d "{
      \"model\": \"${SERVED_MODEL_NAME}\",
      \"messages\": [{\"role\": \"user\", \"content\": \"ตอบสั้น ๆ: 2+2 เท่ากับเท่าไร\"}],
      \"max_tokens\": 512
    }")" || die "เรียก /v1/chat/completions ไม่สำเร็จ — ดู log: $0 logs 200"

  echo "$response"
  echo ""

  # สรุปให้อ่านออกโดยไม่ต้องเพ่ง JSON — และแยก "ตอบว่าง" ออกจาก "ตอบได้"
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$response" | python3 -c '
import json, sys
try:
    msg = json.load(sys.stdin)["choices"][0]["message"]
except (ValueError, KeyError, IndexError):
    sys.exit(0)
content = (msg.get("content") or "").strip()
if content:
    print(f"test-text: OK — {content[:200]}")
elif (msg.get("reasoning_content") or "").strip():
    print("test-text: โมเดลตอบแต่ยังคิดไม่จบใน 512 tokens (reasoning model)")
    print("           ไม่ใช่ความผิดพลาด — ลองถามคำถามที่ยาวขึ้นผ่าน /v1/chat/completions ได้เลย")
else:
    print("test-text: เซิร์ฟเวอร์ตอบกลับแต่ไม่มีข้อความ — ดู log: logs 200")
' || true
  fi
}

usage() {
  cat <<EOF
{{ slug }} — llama.cpp controller  (model: ${MODEL_ID})
Runtime mode: ${RUNTIME_MODE}   (override with RUNTIME_MODE=docker|native)

USAGE
  $0 <command> [options]

COMMANDS
  prepare-runtime   Build llama.cpp from source. REQUIRED once in 'native' mode
                    (DGX Spark / ARM64 has no official image). Installs build deps via apt (sudo).
  download          Download every model part (resumable, revision pinned)
  verify-files      Verify all files: exact size + SHA-256 + GGUF magic
  start             Verify GPU + files, then start llama-server and wait for /health
  stop              Stop the server
  restart           stop + start (use this to apply new options)
  status            Process/container state + API health
  logs [N]          Show last N log lines (default 300).  Live tail: lmds logs {{ slug }} -f
  wait-health       Keep waiting for /health (use if start timed out but the model is still loading)
  client-config     Print client settings as JSON (base_url, model name, token budget)
  network-info      Show current bind address and the endpoint advertised to clients
  test-text         Send one chat completion request to verify the model answers
{% if mmproj_basename %}  test-vision       Send a generated red image and check the model actually sees it
{% endif %}

OPTIONS  (can be placed after any command; equals form also works: --port=8001)

 Identity
  --name NAME           Name clients pass as "model" in the API   [default: ${SERVED_MODEL_NAME}]
                        Original name from generate time: ${DEFAULT_SERVED_MODEL_NAME}
                        (that one is fixed in this file, so a rename is always traceable)

 Network
  --port N              Port to serve on                          [default: ${API_PORT}]
  --bind ADDR           Address the server listens on             [default: ${API_HOST}]
                        0.0.0.0 = reachable from the whole network
                        127.0.0.1 = this machine only (safest)
  --advertise-ip ADDR   IP printed for clients. Does NOT change what the server binds to.
                        Use when the machine has several NICs or sits behind NAT.
  --interface NAME      Pick the advertised IP from this interface (e.g. eth0) instead of auto-detect

 Memory & limits
  --context N           Max context length in tokens              [default: ${CTX_SIZE}]
                        Lower this first if the server runs out of memory.
  --client-input N|auto Input token budget written into client-config   [default: ${CLIENT_INPUT}]
  --client-output N     Output token budget written into client-config  [default: ${CLIENT_OUTPUT}]
{% if mmproj_basename or mtp_basename or mtp_embedded %}
 Model features (this model ships the files for these)
{% if mmproj_basename %}  --mmproj FILE         Vision projector to load                  [default: ${MMPROJ_FILE}]
  --image-min-tokens N  Min tokens per image (grounding accuracy)  [default: ${IMAGE_MIN_TOKENS}]
  --no-mmproj           Serve as text-only (skip the vision projector)
{% endif %}{% if mtp_basename %}  --mtp FILE            MTP draft head for speculative decoding   [default: ${MTP_FILE}]
  --no-mtp              Turn speculative decoding off (slower, identical output)
{% endif %}{% if mtp_embedded and not mtp_basename %}  --mtp / --no-mtp      Speculative decoding using the MTP head built into this GGUF
                        (no separate draft file)                 [default: on]
{% endif %}{% endif %}
API TOKEN (authentication)
  There is NO token by default: anyone who can reach ${API_HOST}:${API_PORT} can use the model.
  Set one with the API_KEY environment variable — it is passed to llama-server as --api-key:

    API_KEY=my-secret-token $0 restart          # start the server with authentication on
    API_KEY=\$(openssl rand -hex 24) $0 restart  # or generate a random one

  Clients then send it as a bearer token:

    curl http://<ip>:${API_PORT}/v1/chat/completions \\
      -H "Authorization: Bearer my-secret-token" \\
      -H 'Content-Type: application/json' \\
      -d '{"model":"${SERVED_MODEL_NAME}","messages":[{"role":"user","content":"hi"}]}'

  The token is NOT stored in this script — you must pass API_KEY on every start/restart
  (put it in your shell profile or a systemd drop-in to make it permanent).
  Without a token, prefer:  $0 restart --bind 127.0.0.1

ENVIRONMENT VARIABLES
  API_KEY             Bearer token required from clients        [default: none]
  API_PORT / API_HOST Same as --port / --bind
  CTX_SIZE            Same as --context
  RUNTIME_MODE        docker | native                            [default: ${RUNTIME_MODE}]
  MODEL_DIR           Where GGUF files are stored                [default: ${MODEL_DIR}]
{% if mmproj_basename %}  MMPROJ_FILE         Same as --mmproj / --no-mmproj              [default: ${MMPROJ_FILE}]
  IMAGE_MIN_TOKENS    Same as --image-min-tokens                  [default: ${IMAGE_MIN_TOKENS}]
{% endif %}{% if mtp_basename %}  MTP_FILE            Same as --mtp / --no-mtp                    [default: ${MTP_FILE}]
{% endif %}{% if mtp_embedded and not mtp_basename %}  MTP_EMBEDDED        Same as --mtp / --no-mtp (empty = off)      [default: ${MTP_EMBEDDED}]
{% endif %}  HF_TOKEN            Hugging Face token, needed for gated repos during 'download'
  N_GPU_LAYERS        Layers offloaded to GPU (fewer = less VRAM, slower)
  HEALTH_TIMEOUT      Seconds to wait for /health on start        [default: ${HEALTH_TIMEOUT}]
  LLAMA_CPP_DIR       llama.cpp source/build dir (native mode)    [default: ${LLAMA_CPP_DIR}]
  CUDA_ARCHITECTURES  CUDA arch used by prepare-runtime           [default: ${CUDA_ARCHITECTURES}]
  RUN_DIR             Runtime state read by 'lmds ps'             [default: ${RUN_DIR}]

EXAMPLES
  $0 start --port 8001 --context 16384        # different port, smaller context
  $0 restart --bind 127.0.0.1                 # lock the endpoint to this machine
  API_KEY=secret123 $0 restart                # require a bearer token
  HF_TOKEN=hf_xxx $0 download                 # gated repository
  MODEL_DIR=/data/models $0 download          # keep weights on another disk (also set it on start)
EOF
}

parse_options "$@"

case "${1:-help}" in
  status|logs|client-config|info|banner|network-info|test-text|test-vision|wait-health|stop)
    adopt_running_state ;;
esac
set -- ${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}


banner() {
  cat <<'ART'

  _     __  __ ____  ____
 | |   |  \/  |  _ \/ ___|
 | |   | |\/| | | | \___ \
 | |___| |  | | |_| |___) |
 |_____|_|  |_|____/|____/
ART
  printf '       =[ LMDS controller · v%s ]\n' "${SCRIPT_VERSION}"
  printf '+ -- --=[ %s ]\n' "${MODEL_LABEL}"
  printf '+ -- --=[ %s · %s ]\n' "${RUNTIME_LABEL}" "${MODEL_FEATURES}"
  printf '+ -- --=[ Designed by neronain · fb.com/neronain.minidev ]\n\n'
}

# สรุปว่า controller นี้เสิร์ฟโมเดลอะไร ที่พอร์ตไหน และตอนนี้ขึ้นหรือยัง
info() {
  banner
  local ip url state
  ip="$(detect_advertise_ip 2>/dev/null || true)"; [[ -n "$ip" ]] || ip="${API_HOST}"
  url="http://${ip}:${API_PORT}/v1"
  state="stopped"
  if curl -fsS -m 2 "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
    state="RUNNING"
  fi
  printf '  Model     : %s\n'            "${MODEL_LABEL}"
  printf '  Model ID  : %s\n'            "${MODEL_ID}"
  printf '  Runtime   : %s\n'            "${RUNTIME_LABEL}"
  printf '  Features  : %s\n'            "${MODEL_FEATURES}"
  printf '  Context   : %s tokens\n'     "${MAX_MODEL_LEN:-${CTX_SIZE:-n/a}}"
  printf '  API (v1)  : %s\n'            "${url}"
  printf '  State     : %s  (port %s)\n\n' "${state}" "${API_PORT}"
}

case "${1:-help}" in
  prepare-runtime) prepare_runtime ;;
  download)     download ;;
  verify-files) verify_files ;;
  start)        start ;;
  stop)         stop ;;
  restart)      stop; start ;;
  status)       status ;;
  logs)         logs "${2:-300}" ;;
  client-config) client_config ;;
  info|banner) info ;;
  network-info) network_info ;;
  test-text)    test_text ;;
{% if mmproj_basename %}  test-vision)  test_vision ;;
{% endif %}
  wait-health)  wait_health ;;
  *)            usage ;;
esac
